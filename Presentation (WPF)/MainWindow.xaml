<Window x:Class="DVLD_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DVLD System"
        MinWidth="1180"
        MinHeight="720"
        Width="1440"
        Height="900"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize">

    <Window.Resources>
        <SolidColorBrush x:Key="WarmGoldColor" Color="#B56A00"/>
        <!-- Main navigation -->
        <Style x:Key="NavItemStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceHoverColor}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavItemActiveStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PrimaryLightColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Effect" Value="{StaticResource ElevationShadow1}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                    <Setter Property="Background" Value="{StaticResource SurfaceHoverColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="QuickActionStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource ElevationShadow1}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                    <Setter Property="Background" Value="{StaticResource PrimarySoftColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActivityItemStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="2"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceHoverColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Storyboard x:Key="StaggerEnterStoryboard">
            <DoubleAnimation Storyboard.TargetName="StatsRow1" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.4" BeginTime="0:0:0.05"/>
            <DoubleAnimation Storyboard.TargetName="StatsRow1RT" Storyboard.TargetProperty="Y"
                             From="24" To="0" Duration="0:0:0.4" BeginTime="0:0:0.05"/>
            <DoubleAnimation Storyboard.TargetName="StatsRow2" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.4" BeginTime="0:0:0.15"/>
            <DoubleAnimation Storyboard.TargetName="StatsRow2RT" Storyboard.TargetProperty="Y"
                             From="24" To="0" Duration="0:0:0.4" BeginTime="0:0:0.15"/>
            <DoubleAnimation Storyboard.TargetName="QuickActionsSection" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.4" BeginTime="0:0:0.25"/>
            <DoubleAnimation Storyboard.TargetName="QuickActionsRT" Storyboard.TargetProperty="Y"
                             From="24" To="0" Duration="0:0:0.4" BeginTime="0:0:0.25"/>
            <DoubleAnimation Storyboard.TargetName="RecentActivitiesSection" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.4" BeginTime="0:0:0.35"/>
            <DoubleAnimation Storyboard.TargetName="RecentActivitiesRT" Storyboard.TargetProperty="Y"
                             From="24" To="0" Duration="0:0:0.4" BeginTime="0:0:0.35"/>
        </Storyboard>

        <Storyboard x:Key="CursorBlinkStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="TypewriterCursor"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.5" AutoReverse="True"/>
        </Storyboard>

        <Storyboard x:Key="PulseGlowStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="GlowEffect"
                             Storyboard.TargetProperty="Opacity"
                             From="0.03" To="0.08" Duration="0:0:5" AutoReverse="True"/>
        </Storyboard>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundColor}"
            BorderBrush="{StaticResource BorderColor}"
            BorderThickness="1"
            CornerRadius="16"
            ClipToBounds="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="68"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <!-- Premium title bar -->
            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceColor}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="18,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="40" Height="40" CornerRadius="12"
                            Background="{StaticResource PrimaryColor}"
                            VerticalAlignment="Center">
                        <TextBlock Text="D" Foreground="White" FontSize="18"
                                   FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="DVLD" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryColor}"/>
                        <TextBlock Text="Driving &amp; Vehicle License Department"
                                   FontSize="10" Foreground="{StaticResource TextMutedColor}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="2" Margin="0,0,18,0"
                            Padding="14,7"
                            CornerRadius="{StaticResource RadiusPill}"
                            Background="{StaticResource SurfaceSecondaryColor}"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessColor}"
                                     VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="{Binding CurrentUserRole,RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryColor}"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="44" Height="40" Background="Transparent"
                                Cursor="Hand" MouseLeftButtonDown="MinBtn_Click">
                            <TextBlock Text="─" FontSize="14"
                                       Foreground="{StaticResource TextSecondaryColor}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Width="44" Height="40" Background="Transparent"
                                Cursor="Hand" MouseLeftButtonDown="MaxBtn_Click">
                            <TextBlock Text="□" FontSize="14"
                                       Foreground="{StaticResource TextSecondaryColor}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Width="44" Height="40" Background="Transparent"
                                Cursor="Hand" MouseLeftButtonDown="CloseBtn_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource DangerColor}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="×" FontSize="20"
                                       Foreground="{StaticResource TextSecondaryColor}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main shell -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="248"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0"
                        Background="{StaticResource SurfaceColor}"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="124"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="74"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Margin="14,14,14,8" Padding="14"
                                Background="{StaticResource PrimaryColor}"
                                CornerRadius="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="42" Height="42" CornerRadius="13"
                                        Background="#FFFFFF22">
                                    <TextBlock Text="AM" Foreground="White"
                                               FontSize="11" FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentUserFullName,RelativeSource={RelativeSource AncestorType=Window}}"
                                               Foreground="White" FontSize="12"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="Signed in"
                                               Foreground="#FFFFFFB8" FontSize="10"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" VerticalAlignment="Bottom"
                                        Height="3" Width="44"
                                        HorizontalAlignment="Left"
                                        Background="{StaticResource WarmGoldColor}"
                                        CornerRadius="2" Margin="10,0,0,0"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="8,2,8,10">
                                <TextBlock Text="WORKSPACE" FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource TextMutedColor}"
                                           Margin="12,8,0,6"/>

                                <Border x:Name="NavDashboard" Style="{StaticResource NavItemActiveStyle}"
                                        MouseLeftButtonUp="NavDashboard_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⌂" Width="28" FontSize="17"
                                                   Foreground="{StaticResource PrimaryColor}"
                                                   TextAlignment="Center"/>
                                        <TextBlock Text="Dashboard" FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryColor}"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock x:Name="NavPeopleHeader" Text="PEOPLE"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource TextMutedColor}"
                                           Margin="12,15,0,6"/>
                                <Border x:Name="NavPeople" Style="{StaticResource NavItemStyle}"
                                        MouseLeftButtonUp="NavPeople_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="●" Width="28" Foreground="{StaticResource PrimaryColor}"
                                                   TextAlignment="Center"/>
                                        <TextBlock Text="Manage People" Foreground="{StaticResource TextPrimaryColor}"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="NavDrivers" Style="{StaticResource NavItemStyle}"
                                        MouseLeftButtonUp="NavDrivers_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="◆" Width="28" Foreground="{StaticResource PrimaryColor}"
                                                   TextAlignment="Center"/>
                                        <TextBlock Text="Manage Drivers" Foreground="{StaticResource TextPrimaryColor}"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock x:Name="NavLicenseServicesHeader" Text="LICENSE SERVICES"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource TextMutedColor}"
                                           Margin="12,15,0,6"/>
                                <Border x:Name="NavNewLocal" Style="{StaticResource NavItemStyle}"
                                        MouseLeftButtonUp="NavNewLocal_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="+" Width="28" Foreground="{StaticResource PrimaryColor}"
                                                   TextAlignment="Center" FontSize="16"/>
                                        <TextBlock Text="New Local License" Foreground="{StaticResource TextPrimaryColor}"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="NavNewInternational" Style="{StaticResource NavItemStyle}"
                                        MouseLeftButtonUp="NavNewInternational_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="◎" Width="28" Foreground="{StaticResource PrimaryColor}"
                                                   TextAlignment="Center"/>
                                        <TextBlock Text="New International" Foreground="{StaticResource TextPrimaryColor}"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="NavRenew" Style="{StaticResource NavItemStyle}"
                                        MouseLeftButtonUp="NavRenew_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="↻" Width="28" Foreground="{StaticResource PrimaryColor}"
                                                   TextAlignment="Center"/>
                                        <TextBlock Text="Renew License" Foreground="{StaticResource TextPrimaryColor}"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="NavReplace" Style="{StaticResource NavItemStyle}"
                                        MouseLeftButtonUp="NavReplace_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="◇" Width="28" Foreground="{StaticResource PrimaryColor}"
                                                   TextAlignment="Center"/>
                                        <TextBlock Text="Replace License" Foreground="{StaticResource TextPrimaryColor}"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock x:Name="NavApplicationsHeader" Text="APPLICATIONS"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource TextMutedColor}"
                                           Margin="12,15,0,6"/>
                                <Border x:Name="NavLocalApps" Style="{StaticResource NavItemStyle}"
                                        MouseLeftButtonUp="NavLocalApps_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▦" Width="28" Foreground="{StaticResource PrimaryColor}"
                                                   TextAlignment="Center"/>
                                        <TextBlock Text="Local Applications" Foreground="{StaticResource TextPrimaryColor}"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="NavIntlApps" Style="{StaticResource NavItemStyle}"
                                        MouseLeftButtonUp="NavIntlApps_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▤" Width="28" Foreground="{StaticResource PrimaryColor}"
                                                   TextAlignment="Center"/>
                                        <TextBlock Text="International Apps" Foreground="{StaticResource TextPrimaryColor}"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="NavRetakeTest" Style="{StaticResource NavItemStyle}"
                                        MouseLeftButtonUp="NavRetakeTest_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="↺" Width="28" Foreground="{StaticResource PrimaryColor}"
                                                   TextAlignment="Center"/>
                                        <TextBlock Text="Retake Test" Foreground="{StaticResource TextPrimaryColor}"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock x:Name="NavLicenseManagementHeader" Text="LICENSE MANAGEMENT"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource TextMutedColor}"
                                           Margin="12,15,0,6"/>
                                <Border x:Name="NavDetained" Style="{StaticResource NavItemStyle}"
                                        MouseLeftButtonUp="NavDetained_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="!" Width="28" Foreground="{StaticResource DangerColor}"
                                                   TextAlignment="Center"/>
                                        <TextBlock Text="Detained Licenses" Foreground="{StaticResource TextPrimaryColor}"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="NavDetainLicense" Style="{StaticResource NavItemStyle}"
                                        MouseLeftButtonUp="NavDetainLicense_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⊗" Width="28" Foreground="{StaticResource DangerColor}"
                                                   TextAlignment="Center"/>
                                        <TextBlock Text="Detain License" Foreground="{StaticResource TextPrimaryColor}"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="NavReleaseDetained" Style="{StaticResource NavItemStyle}"
                                        MouseLeftButtonUp="NavReleaseDetained_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✓" Width="28" Foreground="{StaticResource SuccessColor}"
                                                   TextAlignment="Center"/>
                                        <TextBlock Text="Release Detained" Foreground="{StaticResource TextPrimaryColor}"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock x:Name="NavManagementHeader" Text="ADMINISTRATION"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource TextMutedColor}"
                                           Margin="12,15,0,6"/>
                                <Border x:Name="NavUsers" Style="{StaticResource NavItemStyle}"
                                        MouseLeftButtonUp="NavUsers_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="♟" Width="28" Foreground="{StaticResource PrimaryColor}"
                                                   TextAlignment="Center"/>
                                        <TextBlock Text="Users" Foreground="{StaticResource TextPrimaryColor}"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="NavAppTypes" Style="{StaticResource NavItemStyle}"
                                        MouseLeftButtonUp="NavAppTypes_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▣" Width="28" Foreground="{StaticResource PrimaryColor}"
                                                   TextAlignment="Center"/>
                                        <TextBlock Text="Application Types" Foreground="{StaticResource TextPrimaryColor}"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="NavTestTypes" Style="{StaticResource NavItemStyle}"
                                        MouseLeftButtonUp="NavTestTypes_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="☑" Width="28" Foreground="{StaticResource PrimaryColor}"
                                                   TextAlignment="Center"/>
                                        <TextBlock Text="Test Types" Foreground="{StaticResource TextPrimaryColor}"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="ACCOUNT" FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource TextMutedColor}"
                                           Margin="12,15,0,6"/>
                                <Border x:Name="NavMyProfile" Style="{StaticResource NavItemStyle}"
                                        MouseLeftButtonUp="NavMyProfile_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="○" Width="28" Foreground="{StaticResource PrimaryColor}"
                                                   TextAlignment="Center"/>
                                        <TextBlock Text="My Profile" Foreground="{StaticResource TextPrimaryColor}"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="NavChangePassword" Style="{StaticResource NavItemStyle}"
                                        MouseLeftButtonUp="NavChangePassword_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⌘" Width="28" Foreground="{StaticResource PrimaryColor}"
                                                   TextAlignment="Center"/>
                                        <TextBlock Text="Change Password" Foreground="{StaticResource TextPrimaryColor}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Row="2" Margin="12,6,12,12"
                                Background="{StaticResource SurfaceSecondaryColor}"
                                BorderBrush="{StaticResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="4">
                            <Border x:Name="NavSignOut" Cursor="Hand"
                                    MouseLeftButtonUp="NavSignOut_Click"
                                    Padding="10,9">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="↪" Width="28" Foreground="{StaticResource DangerColor}"
                                               TextAlignment="Center" FontSize="15"/>
                                    <TextBlock Text="Sign Out" Foreground="{StaticResource TextSecondaryColor}"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </Border>
                    </Grid>
                </Border>

                <!-- Content -->
                <Grid Grid.Column="1" Background="{StaticResource BackgroundColor}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="76"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource SurfaceColor}"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="0,0,0,1"
                            Padding="28,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="HeaderTitle" Text="Dashboard"
                                           FontSize="23" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryColor}"/>
                                <TextBlock x:Name="HeaderSubtitle"
                                           Text="Overview of your driving license system"
                                           FontSize="11"
                                           Foreground="{StaticResource TextMutedColor}"
                                           Margin="0,5,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Border Padding="12,8" CornerRadius="{StaticResource RadiusMedium}"
                                        Background="{StaticResource SurfaceSecondaryColor}"
                                        BorderBrush="{StaticResource BorderColor}"
                                        BorderThickness="1" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="◷" Foreground="{StaticResource PrimaryColor}"
                                                   FontSize="14" Margin="0,0,7,0"/>
                                        <StackPanel>
                                            <TextBlock x:Name="ClockText" Text="--:-- --"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryColor}"/>
                                            <TextBlock x:Name="DateText" Text="---, --- --"
                                                       FontSize="9" Foreground="{StaticResource TextMutedColor}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Width="38" Height="38" CornerRadius="11"
                                        Background="{StaticResource PrimaryLightColor}"
                                        BorderBrush="{StaticResource PrimaryColor}"
                                        BorderThickness="1">
                                    <TextBlock Text="AM" Foreground="{StaticResource PrimaryColor}"
                                               FontSize="10" FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Frame x:Name="MainFrame"
                               Visibility="Collapsed"
                               NavigationUIVisibility="Hidden"
                               Margin="22"/>

                        <ScrollViewer x:Name="DashboardPanel"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="28,24,28,28">

                                <!-- Welcome hero -->
                                <Border Height="156" CornerRadius="18"
                                        Background="{StaticResource PrimaryColor}"
                                        Padding="26"
                                        ClipToBounds="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="WELCOME BACK"
                                                       FontSize="10" FontWeight="Bold"
                                                       Foreground="#FFFFFFB8"/>
                                            <TextBlock Text="{Binding CurrentUserFullName,RelativeSource={RelativeSource AncestorType=Window}}"
                                                       FontSize="27" FontWeight="Bold"
                                                       Foreground="White"
                                                       Margin="0,6,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <TextBlock x:Name="TypewriterText"
                                                           FontSize="11"
                                                           Foreground="#FFFFFFD6"
                                                           TextWrapping="Wrap"
                                                           MaxWidth="650"/>
                                                <TextBlock x:Name="TypewriterCursor"
                                                           Text="▌"
                                                           FontSize="11"
                                                           Foreground="{StaticResource WarmGoldColor}"
                                                           Margin="2,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Grid Grid.Column="1" HorizontalAlignment="Right"
                                              VerticalAlignment="Center">
                                            <Ellipse x:Name="GlowEffect"
                                                     Width="150" Height="150"
                                                     Fill="{StaticResource WarmGoldColor}"
                                                     Opacity="0.05"/>
                                            <Border Width="88" Height="88"
                                                    CornerRadius="28"
                                                    Background="#FFFFFF18"
                                                    BorderBrush="#FFFFFF35"
                                                    BorderThickness="1">
                                                <TextBlock Text="D"
                                                           Foreground="#FFFFFFEE"
                                                           FontSize="38"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- Primary KPIs -->
                                <StackPanel Margin="0,22,0,0">
                                    <TextBlock Text="SYSTEM OVERVIEW"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource TextMutedColor}" Margin="5,0,0,8"/>
                                    <StackPanel x:Name="StatsRow1"
                                                Opacity="0"
                                                RenderTransformOrigin="0.5,0.5">
                                        <StackPanel.RenderTransform>
                                            <TranslateTransform x:Name="StatsRow1RT" Y="24"/>
                                        </StackPanel.RenderTransform>
                                        <UniformGrid Columns="4">
                                            <Border Style="{StaticResource StatCardStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="42" Height="42" CornerRadius="12"
                                                            Background="{StaticResource PrimaryLightColor}">
                                                        <TextBlock Text="P" Foreground="{StaticResource PrimaryColor}"
                                                                   FontWeight="Bold" FontSize="15"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                        <TextBlock Text="Total People" FontSize="10"
                                                                   Foreground="{StaticResource TextMutedColor}"/>
                                                        <TextBlock Text="{Binding TotalPeople}" FontSize="24"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource TextPrimaryColor}"
                                                                   Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <Border Style="{StaticResource StatCardStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="42" Height="42" CornerRadius="12"
                                                            Background="{StaticResource SuccessLightColor}">
                                                        <TextBlock Text="D" Foreground="{StaticResource SuccessColor}"
                                                                   FontWeight="Bold" FontSize="15"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                        <TextBlock Text="Drivers" FontSize="10"
                                                                   Foreground="{StaticResource TextMutedColor}"/>
                                                        <TextBlock Text="{Binding TotalDrivers}" FontSize="24"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource TextPrimaryColor}"
                                                                   Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <Border Style="{StaticResource StatCardStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="42" Height="42" CornerRadius="12"
                                                            Background="{StaticResource SuccessLightColor}">
                                                        <TextBlock Text="✓" Foreground="{StaticResource SuccessColor}"
                                                                   FontWeight="Bold" FontSize="15"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                        <TextBlock Text="Active Licenses" FontSize="10"
                                                                   Foreground="{StaticResource TextMutedColor}"/>
                                                        <TextBlock Text="{Binding ActiveLicenses}" FontSize="24"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource TextPrimaryColor}"
                                                                   Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <Border Style="{StaticResource StatCardStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="42" Height="42" CornerRadius="12"
                                                            Background="{StaticResource WarningLightColor}">
                                                        <TextBlock Text="!" Foreground="{StaticResource WarningColor}"
                                                                   FontWeight="Bold" FontSize="15"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                        <TextBlock Text="Pending Apps" FontSize="10"
                                                                   Foreground="{StaticResource TextMutedColor}"/>
                                                        <TextBlock Text="{Binding PendingApplications}" FontSize="24"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource TextPrimaryColor}"
                                                                   Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </UniformGrid>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Secondary KPIs -->
                                <StackPanel x:Name="StatsRow2"
                                            Margin="0,8,0,0"
                                            Opacity="0"
                                            RenderTransformOrigin="0.5,0.5">
                                    <StackPanel.RenderTransform>
                                        <TranslateTransform x:Name="StatsRow2RT" Y="24"/>
                                    </StackPanel.RenderTransform>
                                    <UniformGrid Columns="4">
                                        <Border Style="{StaticResource StatCardStyle}" Padding="15">
                                            <StackPanel>
                                                <TextBlock Text="LOCAL APPLICATIONS" FontSize="9"
                                                           FontWeight="Bold" Foreground="{StaticResource TextMutedColor}"/>
                                                <TextBlock Text="{Binding LocalDrivingLicenseApplications}"
                                                           FontSize="21" FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimaryColor}"
                                                           Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource StatCardStyle}" Padding="15">
                                            <StackPanel>
                                                <TextBlock Text="INTERNATIONAL LICENSES" FontSize="9"
                                                           FontWeight="Bold" Foreground="{StaticResource TextMutedColor}"/>
                                                <TextBlock Text="{Binding InternationalLicenses}"
                                                           FontSize="21" FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimaryColor}"
                                                           Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource StatCardStyle}" Padding="15">
                                            <StackPanel>
                                                <TextBlock Text="DETAINED LICENSES" FontSize="9"
                                                           FontWeight="Bold" Foreground="{StaticResource TextMutedColor}"/>
                                                <TextBlock Text="{Binding DetainedLicenses}"
                                                           FontSize="21" FontWeight="Bold"
                                                           Foreground="{StaticResource DangerColor}"
                                                           Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource StatCardStyle}" Padding="15">
                                            <StackPanel>
                                                <TextBlock Text="UPCOMING TESTS" FontSize="9"
                                                           FontWeight="Bold" Foreground="{StaticResource TextMutedColor}"/>
                                                <TextBlock Text="{Binding UpcomingTests}"
                                                           FontSize="21" FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimaryColor}"
                                                           Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                </StackPanel>

                                <!-- Quick actions + activity -->
                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.45*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="QuickActionsSection"
                                            Grid.Column="0"
                                            Background="{StaticResource SurfaceColor}"
                                            BorderBrush="{StaticResource BorderColor}"
                                            BorderThickness="1"
                                            CornerRadius="16"
                                            Padding="16"
                                            Opacity="0"
                                            RenderTransformOrigin="0.5,0.5"
                                            Margin="0,0,8,0">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="QuickActionsRT" Y="24"/>
                                        </Border.RenderTransform>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <TextBlock Text="QUICK ACTIONS" FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource TextMutedColor}"/>
                                                <TextBlock Text="Start the most common workflows"
                                                           FontSize="11" Foreground="{StaticResource TextSecondaryColor}"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" Text="SHORTCUTS"
                                                       FontSize="9" Foreground="{StaticResource TextMutedColor}"
                                                       VerticalAlignment="Center"/>

                                            <UniformGrid Grid.Row="1" Grid.ColumnSpan="2" Columns="3"
                                                         Margin="0,12,0,0">
                                                <Border Style="{StaticResource QuickActionStyle}"
                                                        MouseLeftButtonUp="NavNewLocal_Click">
                                                    <StackPanel>
                                                        <Border Width="34" Height="34" CornerRadius="10"
                                                                Background="{StaticResource PrimaryLightColor}">
                                                            <TextBlock Text="+" Foreground="{StaticResource PrimaryColor}"
                                                                       FontSize="18" HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Text="New Local License" FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryColor}"
                                                                   Margin="0,9,0,0"/>
                                                    </StackPanel>
                                                </Border>

                                                <Border Style="{StaticResource QuickActionStyle}"
                                                        MouseLeftButtonUp="NavRenew_Click">
                                                    <StackPanel>
                                                        <Border Width="34" Height="34" CornerRadius="10"
                                                                Background="{StaticResource SuccessLightColor}">
                                                            <TextBlock Text="↻" Foreground="{StaticResource SuccessColor}"
                                                                       FontSize="17" HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Text="Renew License" FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryColor}"
                                                                   Margin="0,9,0,0"/>
                                                    </StackPanel>
                                                </Border>

                                                <Border Style="{StaticResource QuickActionStyle}"
                                                        MouseLeftButtonUp="NavNewInternational_Click">
                                                    <StackPanel>
                                                        <Border Width="34" Height="34" CornerRadius="10"
                                                                Background="{StaticResource PrimaryLightColor}">
                                                            <TextBlock Text="◎" Foreground="{StaticResource PrimaryColor}"
                                                                       FontSize="16" HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Text="International" FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryColor}"
                                                                   Margin="0,9,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </UniformGrid>
                                        </Grid>
                                    </Border>

                                    <Border x:Name="RecentActivitiesSection"
                                            Grid.Column="1"
                                            Background="{StaticResource SurfaceColor}"
                                            BorderBrush="{StaticResource BorderColor}"
                                            BorderThickness="1"
                                            CornerRadius="16"
                                            Padding="16"
                                            Opacity="0"
                                            RenderTransformOrigin="0.5,0.5"
                                            Margin="8,0,0,0">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="RecentActivitiesRT" Y="24"/>
                                        </Border.RenderTransform>
                                        <StackPanel>
                                            <TextBlock Text="SYSTEM STATUS" FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource TextMutedColor}"/>
                                            <TextBlock Text="Current session overview"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryColor}"
                                                       Margin="0,4,0,10"/>

                                            <Border Style="{StaticResource ActivityItemStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessColor}"
                                                             Margin="2,0,10,0" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="API session active" FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryColor}"/>
                                                        <TextBlock Text="Backend connection is available"
                                                                   FontSize="9" Foreground="{StaticResource TextMutedColor}"
                                                                   Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <Border Style="{StaticResource ActivityItemStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Width="8" Height="8" Fill="{StaticResource WarmGoldColor}"
                                                             Margin="2,0,10,0" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="Dashboard synchronized" FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryColor}"/>
                                                        <TextBlock Text="Statistics loaded from the API"
                                                                   FontSize="9" Foreground="{StaticResource TextMutedColor}"
                                                                   Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <Border Style="{StaticResource ActivityItemStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Width="8" Height="8" Fill="{StaticResource PrimaryColor}"
                                                             Margin="2,0,10,0" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="Role-based access enabled" FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryColor}"/>
                                                        <TextBlock Text="Navigation reflects your account role"
                                                                   FontSize="9" Foreground="{StaticResource TextMutedColor}"
                                                                   Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="2"
                    Background="{StaticResource SurfaceColor}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessColor}"
                                 VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="System ready" FontSize="9"
                                   Foreground="{StaticResource TextMutedColor}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="DVLD • Secure Session"
                               FontSize="9" Foreground="{StaticResource TextMutedColor}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
