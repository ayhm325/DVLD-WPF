<Window x:Class="DVLD_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DVLD System"
        MinWidth="1100"
        MinHeight="700"
        Width="1280"
        Height="800"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize">
    <Window.Resources>
        <Style x:Key="NavItemStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceHoverColor}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavItemActiveStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PrimaryLightColor}"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
        </Style>
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Effect" Value="{StaticResource ElevationShadow1}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                    <Setter Property="Background" Value="{StaticResource SurfaceHoverColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="QuickActionStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource ElevationShadow1}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                    <Setter Property="Background" Value="{StaticResource SurfaceHoverColor}"/>
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <TranslateTransform Y="-2"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ActivityItemStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="2"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceHoverColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Storyboard x:Key="StaggerEnterStoryboard">
            <DoubleAnimation Storyboard.TargetName="StatsRow1"
                             Storyboard.TargetProperty="Opacity"
                             From="0"
                             To="1"
                             Duration="0:0:0.4"
                             BeginTime="0:0:0.05">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="StatsRow1RT"
                             Storyboard.TargetProperty="Y"
                             From="24"
                             To="0"
                             Duration="0:0:0.4"
                             BeginTime="0:0:0.05">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="StatsRow2"
                             Storyboard.TargetProperty="Opacity"
                             From="0"
                             To="1"
                             Duration="0:0:0.4"
                             BeginTime="0:0:0.15">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="StatsRow2RT"
                             Storyboard.TargetProperty="Y"
                             From="24"
                             To="0"
                             Duration="0:0:0.4"
                             BeginTime="0:0:0.15">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="QuickActionsSection"
                             Storyboard.TargetProperty="Opacity"
                             From="0"
                             To="1"
                             Duration="0:0:0.4"
                             BeginTime="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="QuickActionsRT"
                             Storyboard.TargetProperty="Y"
                             From="24"
                             To="0"
                             Duration="0:0:0.4"
                             BeginTime="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RecentActivitiesSection"
                             Storyboard.TargetProperty="Opacity"
                             From="0"
                             To="1"
                             Duration="0:0:0.4"
                             BeginTime="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RecentActivitiesRT"
                             Storyboard.TargetProperty="Y"
                             From="24"
                             To="0"
                             Duration="0:0:0.4"
                             BeginTime="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="CursorBlinkStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="TypewriterCursor"
                             Storyboard.TargetProperty="Opacity"
                             From="1"
                             To="0"
                             Duration="0:0:0.5"
                             AutoReverse="True"/>
        </Storyboard>
        <Storyboard x:Key="PulseGlowStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="GlowEffect"
                             Storyboard.TargetProperty="Opacity"
                             From="0.03"
                             To="0.08"
                             Duration="0:0:5"
                             AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>
    <Border Background="{StaticResource BackgroundColor}"
            BorderBrush="{StaticResource BorderColor}"
            BorderThickness="1"
            CornerRadius="14"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceColor}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="22,0,0,0">
                        <Border Width="34"
                                Height="34"
                                CornerRadius="10"
                                Background="{StaticResource PrimaryColor}"
                                Margin="0,0,12,0">
                            <TextBlock Text="D"
                                       Foreground="White"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="DVLD"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryColor}"/>
                            <TextBlock Text="Driving License Management"
                                       FontSize="10"
                                       Foreground="{StaticResource TextMutedColor}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0">
                        <Border Width="42"
                                Height="38"
                                Cursor="Hand"
                                Background="Transparent"
                                MouseLeftButtonDown="MinBtn_Click">
                            <TextBlock Text="─"
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondaryColor}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <Border Width="42"
                                Height="38"
                                Cursor="Hand"
                                Background="Transparent"
                                MouseLeftButtonDown="MaxBtn_Click">
                            <TextBlock Text="□"
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondaryColor}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <Border Width="42"
                                Height="38"
                                Cursor="Hand"
                                Background="Transparent"
                                MouseLeftButtonDown="CloseBtn_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource DangerColor}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="×"
                                       FontSize="20"
                                       Foreground="{StaticResource TextSecondaryColor}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Background="{StaticResource SurfaceColor}"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="150"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="70"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Margin="16,16,16,10"
                                Padding="16"
                                CornerRadius="14"
                                Background="{StaticResource SurfaceSecondaryColor}"
                                BorderBrush="{StaticResource BorderColor}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="42"
                                            Height="42"
                                            CornerRadius="12"
                                            Background="{StaticResource PrimaryColor}">
                                        <TextBlock Text="AM"
                                                   Foreground="White"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="10,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="Ayhm Mohammed"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryColor}"/>
                                        <TextBlock Text="Administrator"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextMutedColor}"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Row="2"
                                        Height="5"
                                        CornerRadius="3"
                                        Background="{StaticResource PrimaryLightColor}">
                                    <Border Width="80"
                                            HorizontalAlignment="Left"
                                            CornerRadius="3"
                                            Background="{StaticResource PrimaryColor}"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="8,4,8,10">
                                <TextBlock Text="MAIN"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextMutedColor}"
                                           Margin="12,8,0,6"/>
                                <Border x:Name="NavDashboard"
                                        Style="{StaticResource NavItemActiveStyle}"
                                        MouseLeftButtonUp="NavDashboard_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⌂"
                                                   Width="28"
                                                   FontSize="17"
                                                   Foreground="{StaticResource PrimaryColor}"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"/>
                                        <TextBlock Text="Dashboard"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryColor}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="PEOPLE"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextMutedColor}"
                                           Margin="12,16,0,6"/>
                                <Border x:Name="NavPeople" Style="{StaticResource NavItemStyle}" MouseLeftButtonUp="NavPeople_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="●" Width="28" Foreground="{StaticResource PrimaryColor}" TextAlignment="Center"/>
                                        <TextBlock Text="Manage People" Foreground="{StaticResource TextPrimaryColor}"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="NavDrivers" Style="{StaticResource NavItemStyle}" MouseLeftButtonUp="NavDrivers_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="◆" Width="28" Foreground="{StaticResource PrimaryColor}" TextAlignment="Center"/>
                                        <TextBlock Text="Manage Drivers" Foreground="{StaticResource TextPrimaryColor}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="LICENSE SERVICES"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextMutedColor}"
                                           Margin="12,16,0,6"/>
                                <Border x:Name="NavNewLocal" Style="{StaticResource NavItemStyle}" MouseLeftButtonUp="NavNewLocal_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="+" Width="28" Foreground="{StaticResource PrimaryColor}" TextAlignment="Center"/>
                                        <TextBlock Text="New Local License" Foreground="{StaticResource TextPrimaryColor}"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="NavNewInternational" Style="{StaticResource NavItemStyle}" MouseLeftButtonUp="NavNewInternational_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="◎" Width="28" Foreground="{StaticResource InfoColor}" TextAlignment="Center"/>
                                        <TextBlock Text="New Intl. License" Foreground="{StaticResource TextPrimaryColor}"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="NavRenew" Style="{StaticResource NavItemStyle}" MouseLeftButtonUp="NavRenew_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="↻" Width="28" Foreground="{StaticResource SuccessColor}" TextAlignment="Center"/>
                                        <TextBlock Text="Renew License" Foreground="{StaticResource TextPrimaryColor}"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="NavReplace" Style="{StaticResource NavItemStyle}" MouseLeftButtonUp="NavReplace_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⇄" Width="28" Foreground="{StaticResource WarningColor}" TextAlignment="Center"/>
                                        <TextBlock Text="Replace License" Foreground="{StaticResource TextPrimaryColor}"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="NavDetainLicense" Style="{StaticResource NavItemStyle}" MouseLeftButtonUp="NavDetainLicense_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="!" Width="28" Foreground="{StaticResource DangerColor}" TextAlignment="Center"/>
                                        <TextBlock Text="Detain License" Foreground="{StaticResource TextPrimaryColor}"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="NavReleaseDetained" Style="{StaticResource NavItemStyle}" MouseLeftButtonUp="NavReleaseDetained_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✓" Width="28" Foreground="{StaticResource SuccessColor}" TextAlignment="Center"/>
                                        <TextBlock Text="Release Detained" Foreground="{StaticResource TextPrimaryColor}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="MANAGEMENT"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextMutedColor}"
                                           Margin="12,16,0,6"/>
                                <Border x:Name="NavLocalApps" Style="{StaticResource NavItemStyle}" MouseLeftButtonUp="NavLocalApps_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▤" Width="28" Foreground="{StaticResource PrimaryColor}" TextAlignment="Center"/>
                                        <TextBlock Text="Local Applications" Foreground="{StaticResource TextPrimaryColor}"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="NavIntlApps" Style="{StaticResource NavItemStyle}" MouseLeftButtonUp="NavIntlApps_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▧" Width="28" Foreground="{StaticResource InfoColor}" TextAlignment="Center"/>
                                        <TextBlock Text="Intl. Applications" Foreground="{StaticResource TextPrimaryColor}"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="NavDetained" Style="{StaticResource NavItemStyle}" MouseLeftButtonUp="NavDetained_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="!" Width="28" Foreground="{StaticResource WarningColor}" TextAlignment="Center"/>
                                        <TextBlock Text="Detained Licenses" Foreground="{StaticResource TextPrimaryColor}"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="NavRetakeTest" Style="{StaticResource NavItemStyle}" MouseLeftButtonUp="NavRetakeTest_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="◇" Width="28" Foreground="{StaticResource WarningColor}" TextAlignment="Center"/>
                                        <TextBlock Text="Retake Test" Foreground="{StaticResource TextPrimaryColor}"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="NavUsers" Style="{StaticResource NavItemStyle}" MouseLeftButtonUp="NavUsers_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="○" Width="28" Foreground="{StaticResource PrimaryColor}" TextAlignment="Center"/>
                                        <TextBlock Text="Users" Foreground="{StaticResource TextPrimaryColor}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="CONFIGURATION"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextMutedColor}"
                                           Margin="12,16,0,6"/>
                                <Border x:Name="NavAppTypes" Style="{StaticResource NavItemStyle}" MouseLeftButtonUp="NavAppTypes_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚙" Width="28" Foreground="{StaticResource TextSecondaryColor}" TextAlignment="Center"/>
                                        <TextBlock Text="Application Types" Foreground="{StaticResource TextPrimaryColor}"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="NavTestTypes" Style="{StaticResource NavItemStyle}" MouseLeftButtonUp="NavTestTypes_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚙" Width="28" Foreground="{StaticResource TextSecondaryColor}" TextAlignment="Center"/>
                                        <TextBlock Text="Test Types" Foreground="{StaticResource TextPrimaryColor}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="ACCOUNT"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextMutedColor}"
                                           Margin="12,16,0,6"/>
                                <Border x:Name="NavMyProfile" Style="{StaticResource NavItemStyle}" MouseLeftButtonUp="NavMyProfile_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="◉" Width="28" Foreground="{StaticResource PrimaryColor}" TextAlignment="Center"/>
                                        <TextBlock Text="My Profile" Foreground="{StaticResource TextPrimaryColor}"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="NavChangePassword" Style="{StaticResource NavItemStyle}" MouseLeftButtonUp="NavChangePassword_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="◆" Width="28" Foreground="{StaticResource WarningColor}" TextAlignment="Center"/>
                                        <TextBlock Text="Change Password" Foreground="{StaticResource TextPrimaryColor}"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="NavSignOut"
                                        Margin="8,8,8,10"
                                        MouseLeftButtonUp="NavSignOut_Click">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
                                            <Setter Property="Padding" Value="12,10"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource DangerLightColor}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="←"
                                                   Width="28"
                                                   Foreground="{StaticResource DangerColor}"
                                                   TextAlignment="Center"/>
                                        <TextBlock Text="Sign Out"
                                                   Foreground="{StaticResource DangerColor}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Row="2"
                                Margin="16,8"
                                Padding="12,8"
                                CornerRadius="10"
                                Background="{StaticResource SurfaceSecondaryColor}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7"
                                         Height="7"
                                         Fill="{StaticResource SuccessColor}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,8,0"/>
                                <TextBlock Text="System Online"
                                           FontSize="10"
                                           Foreground="{StaticResource TextSecondaryColor}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="86"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Background="{StaticResource SurfaceColor}"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="0,0,0,1"
                            Padding="28,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="HeaderTitle"
                                           Text="Dashboard"
                                           FontSize="{StaticResource FontSizeHeader}"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryColor}"/>
                                <TextBlock x:Name="HeaderSubtitle"
                                           Text="Overview of your driving license system"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{StaticResource TextMutedColor}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Border Width="190"
                                        Height="38"
                                        Background="{StaticResource InputBackgroundColor}"
                                        BorderBrush="{StaticResource BorderColor}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12,0"
                                        Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⌕"
                                                   FontSize="18"
                                                   Foreground="{StaticResource TextMutedColor}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="Search"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMutedColor}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Width="38"
                                        Height="38"
                                        Background="{StaticResource InputBackgroundColor}"
                                        BorderBrush="{StaticResource BorderColor}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Margin="0,0,12,0">
                                    <TextBlock Text="◌"
                                               FontSize="18"
                                               Foreground="{StaticResource TextSecondaryColor}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center"
                                            Margin="0,0,16,0">
                                    <TextBlock x:Name="DateText"
                                               Text=""
                                               FontSize="10"
                                               Foreground="{StaticResource TextMutedColor}"
                                               HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="ClockText"
                                               Text=""
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryColor}"
                                               FontFamily="Consolas"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border Width="36"
                                        Height="36"
                                        CornerRadius="10"
                                        Background="{StaticResource PrimaryColor}">
                                    <TextBlock Text="A"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1">
                        <Frame x:Name="MainFrame"
                               NavigationUIVisibility="Hidden"
                               Visibility="Collapsed"/>
                        <Grid x:Name="DashboardPanel">
                            <Grid.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard Storyboard="{StaticResource PulseGlowStoryboard}"/>
                                </EventTrigger>
                            </Grid.Triggers>
                            <Ellipse x:Name="GlowEffect"
