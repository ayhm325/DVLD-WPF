<Window x:Class="DVLD_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Presentation.Views.Controls"
        Title="DVLD System"
        MinWidth="960"
        MinHeight="620"
        SizeChanged="MainWindow_SizeChanged"
        Width="1440"
        Height="900"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize">

    <Window.Resources>
        <!-- The shell keeps the warm application palette; navy is deliberately scoped to navigation. -->
        <SolidColorBrush x:Key="SidebarNavyBackground" Color="#0F172A"/>
        <SolidColorBrush x:Key="SidebarNavySurface" Color="#172554"/>
        <SolidColorBrush x:Key="SidebarNavyText" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="SidebarNavyMuted" Color="#94A3B8"/>
        <SolidColorBrush x:Key="SidebarNavyAccent" Color="#C4A484"/>
        <SolidColorBrush x:Key="SidebarNavyActive" Color="#1E3A8A"/>
        <SolidColorBrush x:Key="SidebarNavyBorder" Color="#334155"/>
        <!-- Main navigation -->
        <Style x:Key="NavItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource SidebarNavyText}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="8,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusMedium}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavButtonBorder" Property="Background" Value="{StaticResource SidebarNavySurface}"/><Setter TargetName="NavButtonBorder" Property="BorderBrush" Value="{StaticResource SidebarNavyBorder}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavButtonBorder" Property="BorderBrush" Value="{StaticResource SidebarNavyAccent}"/><Setter TargetName="NavButtonBorder" Property="BorderThickness" Value="2"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavItemActiveStyle" TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
            <Setter Property="Background" Value="{StaticResource SidebarNavyActive}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SidebarNavyAccent}"/>
        </Style>
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryLightColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusXLarge}"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="6"/>
        <Setter Property="Effect" Value="{StaticResource ElevationShadow1}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongColor}"/>
                    <Setter Property="Background" Value="{StaticResource PrimarySoftColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="QuickActionStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Effect" Value="{StaticResource ElevationShadow1}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusLarge}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder" Property="Background" Value="{StaticResource PrimaryLightColor}"/>
                                <Setter TargetName="ActionBorder" Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ActionBorder" Property="BorderBrush" Value="{StaticResource FocusBorderColor}"/>
                                <Setter TargetName="ActionBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionBorder" Property="Background" Value="{StaticResource SurfacePressedColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActivityItemStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="2"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceHoverColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Storyboard x:Key="StaggerEnterStoryboard">
            <DoubleAnimation Storyboard.TargetName="StatsRow1" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.4" BeginTime="0:0:0.05"/>
            <DoubleAnimation Storyboard.TargetName="StatsRow1RT" Storyboard.TargetProperty="Y"
                             From="24" To="0" Duration="0:0:0.4" BeginTime="0:0:0.05"/>
            <DoubleAnimation Storyboard.TargetName="StatsRow2" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.4" BeginTime="0:0:0.15"/>
            <DoubleAnimation Storyboard.TargetName="StatsRow2RT" Storyboard.TargetProperty="Y"
                             From="24" To="0" Duration="0:0:0.4" BeginTime="0:0:0.15"/>
            <DoubleAnimation Storyboard.TargetName="QuickActionsSection" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.4" BeginTime="0:0:0.25"/>
            <DoubleAnimation Storyboard.TargetName="QuickActionsRT" Storyboard.TargetProperty="Y"
                             From="24" To="0" Duration="0:0:0.4" BeginTime="0:0:0.25"/>
            <DoubleAnimation Storyboard.TargetName="RecentActivitiesSection" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.4" BeginTime="0:0:0.35"/>
            <DoubleAnimation Storyboard.TargetName="RecentActivitiesRT" Storyboard.TargetProperty="Y"
                             From="24" To="0" Duration="0:0:0.4" BeginTime="0:0:0.35"/>
        </Storyboard>

        <Storyboard x:Key="CursorBlinkStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="TypewriterCursor"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.5" AutoReverse="True"/>
        </Storyboard>

        <Storyboard x:Key="PulseGlowStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="GlowEffect"
                             Storyboard.TargetProperty="Opacity"
                             From="0.03" To="0.08" Duration="0:0:5" AutoReverse="True"/>
        </Storyboard>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundColor}"
            BorderBrush="{StaticResource BorderColor}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusXLarge}"
            ClipToBounds="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="68"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <!-- Premium title bar -->
            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceColor}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="18,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="40" Height="40" CornerRadius="12"
                            Background="{StaticResource PrimaryColor}"
                            VerticalAlignment="Center">
                        <TextBlock Text="D" Foreground="White" FontSize="18"
                                   FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="DVLD" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryColor}"/>
                        <TextBlock Text="Driving &amp; Vehicle License Department"
                                   FontSize="10" Foreground="{StaticResource TextMutedColor}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="2" Margin="0,0,18,0"
                            Padding="14,7"
                            CornerRadius="{StaticResource RadiusPill}"
                            Background="{StaticResource SurfaceSecondaryColor}"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessColor}"
                                     VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="{Binding CurrentUserRole,RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryColor}"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="44" Height="40" Background="Transparent"
                                Cursor="Hand" MouseLeftButtonDown="MinBtn_Click">
                            <TextBlock Text="─" FontSize="14"
                                       Foreground="{StaticResource TextSecondaryColor}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Width="44" Height="40" Background="Transparent"
                                Cursor="Hand" MouseLeftButtonDown="MaxBtn_Click">
                            <TextBlock Text="□" FontSize="14"
                                       Foreground="{StaticResource TextSecondaryColor}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Width="44" Height="40" Background="Transparent"
                                Cursor="Hand" MouseLeftButtonDown="CloseBtn_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource DangerColor}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="×" FontSize="20"
                                       Foreground="{StaticResource TextSecondaryColor}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main shell -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="248"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar: the navy treatment is intentionally isolated from the warm content canvas. -->
                <Border Grid.Column="0" Background="{StaticResource SidebarNavyBackground}"
                        BorderBrush="{StaticResource SidebarNavyBorder}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="82"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="184"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="14,12,12,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                            <Border Width="38" Height="38" CornerRadius="12" Background="{StaticResource SidebarNavyActive}" VerticalAlignment="Center">
                                <TextBlock Text="D" Foreground="{StaticResource SidebarNavyAccent}" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="9,0,4,0" VerticalAlignment="Center">
                                <TextBlock Tag="SidebarLabel" Text="DVLD" Foreground="{StaticResource SidebarNavyText}" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Tag="SidebarLabel" Text="Enterprise Portal" Foreground="{StaticResource SidebarNavyMuted}" FontSize="9" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button x:Name="SidebarCollapseButton" Grid.Column="2" ToolTip="Collapse sidebar" Click="SidebarCollapseButton_Click"
                                    Background="Transparent" BorderBrush="Transparent" Foreground="{StaticResource SidebarNavyMuted}" Padding="4">
                                <TextBlock x:Name="SidebarCollapseGlyph" Text="‹" FontSize="20" HorizontalAlignment="Center"/>
                            </Button>
                        </Grid>

                        <ScrollViewer Grid.Row="1" x:Name="SidebarNavigationScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="8,2,8,10">
                                <Button x:Name="NavDashboard" Tag="Dashboard" ToolTip="Dashboard" Style="{StaticResource NavItemActiveStyle}" Click="NavDashboard_Click">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="⌂" Width="28" FontSize="17" Foreground="{StaticResource SidebarNavyAccent}" TextAlignment="Center"/><TextBlock Tag="SidebarLabel" Text="Dashboard" Foreground="{StaticResource SidebarNavyText}" FontWeight="SemiBold"/></StackPanel>
                                </Button>

                                <TextBlock x:Name="NavPeopleHeader" Tag="SidebarSection" Text="DIRECTORY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource SidebarNavyMuted}" Margin="12,15,0,6"/>
                                <Button x:Name="NavPeople" Tag="Manage People" ToolTip="People" Style="{StaticResource NavItemStyle}" Click="NavPage_Click">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="●" Width="28" Foreground="{StaticResource SidebarNavyAccent}" TextAlignment="Center"/><TextBlock Tag="SidebarLabel" Text="People" Foreground="{StaticResource SidebarNavyText}"/></StackPanel>
                                </Button>
                                <Button x:Name="NavDrivers" Tag="Manage Drivers" ToolTip="Drivers" Style="{StaticResource NavItemStyle}" Click="NavPage_Click">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="◆" Width="28" Foreground="{StaticResource SidebarNavyAccent}" TextAlignment="Center"/><TextBlock Tag="SidebarLabel" Text="Drivers" Foreground="{StaticResource SidebarNavyText}"/></StackPanel>
                                </Button>

                                <TextBlock x:Name="NavApplicationsHeader" Tag="SidebarSection" Text="APPLICATIONS &amp; TESTS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource SidebarNavyMuted}" Margin="12,15,0,6"/>
                                <Button x:Name="NavLocalApps" Tag="Local Applications" ToolTip="Local Applications" Style="{StaticResource NavItemStyle}" Click="NavPage_Click">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="▦" Width="28" Foreground="{StaticResource SidebarNavyAccent}" TextAlignment="Center"/><TextBlock Tag="SidebarLabel" Text="Local Applications" Foreground="{StaticResource SidebarNavyText}"/></StackPanel>
                                </Button>
                                <Button Tag="Test Appointments" ToolTip="Test appointments are opened from a local application" Style="{StaticResource NavItemStyle}" IsEnabled="False">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="◷" Width="28" Foreground="{StaticResource SidebarNavyMuted}" TextAlignment="Center"/><TextBlock Tag="SidebarLabel" Text="Test Appointments" Foreground="{StaticResource SidebarNavyText}"/></StackPanel>
                                </Button>
                                <Button x:Name="NavIntlApps" Tag="International Apps" ToolTip="International Licenses" Style="{StaticResource NavItemStyle}" Click="NavPage_Click">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="◎" Width="28" Foreground="{StaticResource SidebarNavyAccent}" TextAlignment="Center"/><TextBlock Tag="SidebarLabel" Text="International Licenses" Foreground="{StaticResource SidebarNavyText}"/></StackPanel>
                                </Button>

                                <TextBlock x:Name="NavLicenseServicesHeader" Tag="SidebarSection" Text="LICENSE SERVICES" FontSize="9" FontWeight="Bold" Foreground="{StaticResource SidebarNavyMuted}" Margin="12,15,0,6"/>
                                <Button Tag="Licenses" ToolTip="License details are opened from a person or driver record" Style="{StaticResource NavItemStyle}" IsEnabled="False">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="▤" Width="28" Foreground="{StaticResource SidebarNavyMuted}" TextAlignment="Center"/><TextBlock Tag="SidebarLabel" Text="Licenses" Foreground="{StaticResource SidebarNavyText}"/></StackPanel>
                                </Button>
                                <Button x:Name="NavRenew" Tag="Renew License" ToolTip="Renew License" Style="{StaticResource NavItemStyle}" Click="NavRenew_Click">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="↻" Width="28" Foreground="{StaticResource SidebarNavyAccent}" TextAlignment="Center"/><TextBlock Tag="SidebarLabel" Text="Renew License" Foreground="{StaticResource SidebarNavyText}"/></StackPanel>
                                </Button>
                                <Button x:Name="NavReplace" Tag="Replace License" ToolTip="Replace License" Style="{StaticResource NavItemStyle}" Click="NavReplace_Click">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="◇" Width="28" Foreground="{StaticResource SidebarNavyAccent}" TextAlignment="Center"/><TextBlock Tag="SidebarLabel" Text="Replace License" Foreground="{StaticResource SidebarNavyText}"/></StackPanel>
                                </Button>
                                <Button x:Name="NavDetainLicense" Tag="Detain License" ToolTip="Detain License" Style="{StaticResource NavItemStyle}" Click="NavDetainLicense_Click">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="⊗" Width="28" Foreground="{StaticResource DangerColor}" TextAlignment="Center"/><TextBlock Tag="SidebarLabel" Text="Detain License" Foreground="{StaticResource SidebarNavyText}"/></StackPanel>
                                </Button>
                                <Button x:Name="NavDetained" Tag="Detained Licenses" ToolTip="Detained Licenses" Style="{StaticResource NavItemStyle}" Click="NavPage_Click">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="!" Width="28" Foreground="{StaticResource DangerColor}" TextAlignment="Center"/><TextBlock Tag="SidebarLabel" Text="Detained Licenses" Foreground="{StaticResource SidebarNavyText}"/></StackPanel>
                                </Button>

                                <TextBlock x:Name="NavSettingsHeader" Tag="SidebarSection" Text="SETTINGS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource SidebarNavyMuted}" Margin="12,15,0,6"/>
                                <Button x:Name="NavSettings" Tag="Settings" ToolTip="Settings" Style="{StaticResource NavItemStyle}" Click="NavSettings_Click">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions><TextBlock Text="⚙" FontSize="15" Foreground="{StaticResource SidebarNavyAccent}" TextAlignment="Center"/><TextBlock Grid.Column="1" Tag="SidebarLabel" Text="Settings" Foreground="{StaticResource SidebarNavyText}"/><TextBlock x:Name="SettingsChevron" Grid.Column="2" Tag="SidebarLabel" Text="›" Foreground="{StaticResource SidebarNavyMuted}" TextAlignment="Center"/></Grid>
                                </Button>
                                <StackPanel x:Name="SettingsSubmenu" Margin="18,0,0,0" Visibility="Collapsed">
                                    <Button x:Name="NavUsers" Tag="Users" ToolTip="Users" Style="{StaticResource NavItemStyle}" Click="NavPage_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="•" Width="20" Foreground="{StaticResource SidebarNavyAccent}" TextAlignment="Center"/><TextBlock Tag="SidebarLabel" Text="Users" Foreground="{StaticResource SidebarNavyText}"/></StackPanel></Button>
                                    <Button x:Name="NavAppTypes" Tag="Application Types" ToolTip="Application Types" Style="{StaticResource NavItemStyle}" Click="NavPage_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="•" Width="20" Foreground="{StaticResource SidebarNavyAccent}" TextAlignment="Center"/><TextBlock Tag="SidebarLabel" Text="Application Types" Foreground="{StaticResource SidebarNavyText}"/></StackPanel></Button>
                                    <Button x:Name="NavLicenseClasses" Tag="License Classes" ToolTip="License Classes" Style="{StaticResource NavItemStyle}" Click="NavPage_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="•" Width="20" Foreground="{StaticResource SidebarNavyAccent}" TextAlignment="Center"/><TextBlock Tag="SidebarLabel" Text="License Classes" Foreground="{StaticResource SidebarNavyText}"/></StackPanel></Button>
                                    <Button x:Name="NavTestTypes" Tag="Test Types" ToolTip="Test Types" Style="{StaticResource NavItemStyle}" Click="NavPage_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="•" Width="20" Foreground="{StaticResource SidebarNavyAccent}" TextAlignment="Center"/><TextBlock Tag="SidebarLabel" Text="Test Types" Foreground="{StaticResource SidebarNavyText}"/></StackPanel></Button>
                                    <Button x:Name="NavCountries" Tag="Countries" ToolTip="Countries" Style="{StaticResource NavItemStyle}" Click="NavPage_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="•" Width="20" Foreground="{StaticResource SidebarNavyAccent}" TextAlignment="Center"/><TextBlock Tag="SidebarLabel" Text="Countries" Foreground="{StaticResource SidebarNavyText}"/></StackPanel></Button>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Row="2" Margin="10,5,10,10" Background="{StaticResource SidebarNavySurface}" BorderBrush="{StaticResource SidebarNavyBorder}" BorderThickness="1" CornerRadius="12" Padding="5">
                            <StackPanel>
                                <TextBlock Tag="SidebarSection" Text="ACCOUNT" FontSize="9" FontWeight="Bold" Foreground="{StaticResource SidebarNavyMuted}" Margin="8,3,0,3"/>
                                <Button x:Name="NavMyProfile" Tag="My Profile" ToolTip="My Profile" Style="{StaticResource NavItemStyle}" Click="NavMyProfile_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="○" Width="28" Foreground="{StaticResource SidebarNavyAccent}" TextAlignment="Center"/><TextBlock Tag="SidebarLabel" Text="My Profile" Foreground="{StaticResource SidebarNavyText}"/></StackPanel></Button>
                                <Button x:Name="NavChangePassword" Tag="Change Password" ToolTip="Change Password" Style="{StaticResource NavItemStyle}" Click="NavChangePassword_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⌘" Width="28" Foreground="{StaticResource SidebarNavyAccent}" TextAlignment="Center"/><TextBlock Tag="SidebarLabel" Text="Change Password" Foreground="{StaticResource SidebarNavyText}"/></StackPanel></Button>
                                <Border Height="1" Background="{StaticResource SidebarNavyBorder}" Margin="8,5"/>
                                <Button x:Name="NavSignOut" Tag="Sign Out" ToolTip="Sign Out" Style="{StaticResource NavItemStyle}" Click="NavSignOut_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="↪" Width="28" Foreground="#FDA4AF" TextAlignment="Center" FontSize="15"/><TextBlock Tag="SidebarLabel" Text="Sign Out" Foreground="{StaticResource SidebarNavyText}" FontWeight="SemiBold"/></StackPanel></Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Content -->
                <Grid Grid.Column="1" Background="{StaticResource BackgroundColor}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="76"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource SurfaceColor}"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="0,0,0,1"
                            Padding="28,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="HeaderTitle" Text="Dashboard"
                                           FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryColor}"/>
                                <TextBlock x:Name="HeaderSubtitle"
                                           Text="Overview of your driving license system"
                                           FontSize="11"
                                           Foreground="{StaticResource TextMutedColor}"
                                           Margin="0,5,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Border Padding="12,8" CornerRadius="{StaticResource RadiusMedium}"
                                        Background="{StaticResource SurfaceSecondaryColor}"
                                        BorderBrush="{StaticResource BorderColor}"
                                        BorderThickness="1" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="◷" Foreground="{StaticResource PrimaryColor}"
                                                   FontSize="14" Margin="0,0,7,0"/>
                                        <StackPanel>
                                            <TextBlock x:Name="ClockText" Text="--:-- --"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryColor}"/>
                                            <TextBlock x:Name="DateText" Text="---, --- --"
                                                       FontSize="9" Foreground="{StaticResource TextMutedColor}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Width="38" Height="38" CornerRadius="11"
                                        Background="{StaticResource PrimaryLightColor}"
                                        BorderBrush="{StaticResource PrimaryColor}"
                                        BorderThickness="1">
                                    <TextBlock x:Name="PeriodText"
                                               Text="AM" Foreground="{StaticResource PrimaryColor}"
                                               FontSize="10" FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Frame x:Name="MainFrame"
                               Visibility="Collapsed"
                               NavigationUIVisibility="Hidden"
                               Margin="22"/>

                        <ScrollViewer x:Name="DashboardPanel"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="30,26,30,32">

                                <!-- Welcome hero -->
                                <Border MinHeight="172" CornerRadius="{StaticResource RadiusXLarge}"
                                        Background="{StaticResource PrimaryColor}"
                                        BorderBrush="{StaticResource PrimaryPressedColor}" BorderThickness="1"
                                        Padding="30"
                                        ClipToBounds="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="180"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="WELCOME BACK"
                                                       FontSize="10" FontWeight="Bold"
                                                        Foreground="{StaticResource PrimaryLightColor}"/>
                                            <TextBlock Text="{Binding CurrentUserFullName,RelativeSource={RelativeSource AncestorType=Window}}"
                                                       FontSize="30" FontWeight="Bold"
                                                        Foreground="{StaticResource TextOnPrimaryColor}"
                                                       Margin="0,6,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <TextBlock x:Name="TypewriterText"
                                                           FontSize="11"
                                                            Foreground="{StaticResource PrimaryLightColor}"
                                                           TextWrapping="Wrap"
                                                           MaxWidth="650"/>
                                                <TextBlock x:Name="TypewriterCursor"
                                                           Text="▌"
                                                           FontSize="11"
                                                            Foreground="{StaticResource PrimaryLightColor}"
                                                           Margin="2,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Grid Grid.Column="1" HorizontalAlignment="Right"
                                              VerticalAlignment="Center">
                                            <Ellipse x:Name="GlowEffect"
                                                     Width="150" Height="150"
                                                      Fill="{StaticResource SecondaryBrownColor}"
                                                      Opacity="0.12"/>
                                            <Border Width="88" Height="88"
                                                    CornerRadius="28"
                                                    Background="{StaticResource PrimaryLightColor}"
                                                    BorderBrush="{StaticResource BorderColor}"
                                                    BorderThickness="1">
                                                <TextBlock Text="D"
                                                           Foreground="{StaticResource PrimaryColor}"
                                                           FontSize="38"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Background="{StaticResource WarningLightColor}"
                                        BorderBrush="{StaticResource WarningColor}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusMedium}"
                                        Padding="14,10"
                                        Margin="0,14,0,0"
                                        Visibility="{Binding HasDashboardError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding ErrorMessage}"
                                               Foreground="{StaticResource TextPrimaryColor}"
                                               TextWrapping="Wrap"/>
                                </Border>

                                <!-- Primary KPIs -->
                                <StackPanel Margin="0,22,0,0">
                                    <TextBlock Text="SYSTEM OVERVIEW"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource TextMutedColor}" Margin="5,0,0,8"/>
                                    <StackPanel x:Name="StatsRow1"
                                                Opacity="0"
                                                RenderTransformOrigin="0.5,0.5">
                                        <StackPanel.RenderTransform>
                                            <TranslateTransform x:Name="StatsRow1RT" Y="24"/>
                                        </StackPanel.RenderTransform>
                                        <UniformGrid x:Name="StatsPrimaryGrid" Columns="4">
                                            <Border Style="{StaticResource StatCardStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="42" Height="42" CornerRadius="12"
                                                            Background="{StaticResource PrimaryLightColor}">
                                                        <TextBlock Text="P" Foreground="{StaticResource PrimaryColor}"
                                                                   FontWeight="Bold" FontSize="15"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                        <TextBlock Text="Total People" FontSize="10"
                                                                   Foreground="{StaticResource TextMutedColor}"/>
                                                        <TextBlock Text="{Binding TotalPeople}" FontSize="24"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource TextPrimaryColor}"
                                                                   Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <Border Style="{StaticResource StatCardStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="42" Height="42" CornerRadius="12"
                                                            Background="{StaticResource SuccessLightColor}">
                                                        <TextBlock Text="D" Foreground="{StaticResource SuccessColor}"
                                                                   FontWeight="Bold" FontSize="15"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                        <TextBlock Text="Drivers" FontSize="10"
                                                                   Foreground="{StaticResource TextMutedColor}"/>
                                                        <TextBlock Text="{Binding TotalDrivers}" FontSize="24"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource TextPrimaryColor}"
                                                                   Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <Border Style="{StaticResource StatCardStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="42" Height="42" CornerRadius="12"
                                                            Background="{StaticResource SuccessLightColor}">
                                                        <TextBlock Text="✓" Foreground="{StaticResource SuccessColor}"
                                                                   FontWeight="Bold" FontSize="15"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                        <TextBlock Text="Active Licenses" FontSize="10"
                                                                   Foreground="{StaticResource TextMutedColor}"/>
                                                        <TextBlock Text="{Binding ActiveLicenses}" FontSize="24"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource TextPrimaryColor}"
                                                                   Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <Border Style="{StaticResource StatCardStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="42" Height="42" CornerRadius="12"
                                                            Background="{StaticResource WarningLightColor}">
                                                        <TextBlock Text="!" Foreground="{StaticResource WarningColor}"
                                                                   FontWeight="Bold" FontSize="15"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                        <TextBlock Text="Pending Apps" FontSize="10"
                                                                   Foreground="{StaticResource TextMutedColor}"/>
                                                        <TextBlock Text="{Binding PendingApplications}" FontSize="24"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource TextPrimaryColor}"
                                                                   Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </UniformGrid>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Secondary KPIs -->
                                <StackPanel x:Name="StatsRow2"
                                            Margin="0,8,0,0"
                                            Opacity="0"
                                            RenderTransformOrigin="0.5,0.5">
                                    <StackPanel.RenderTransform>
                                        <TranslateTransform x:Name="StatsRow2RT" Y="24"/>
                                    </StackPanel.RenderTransform>
                                    <UniformGrid x:Name="StatsSecondaryGrid" Columns="4">
                                        <Border Style="{StaticResource StatCardStyle}" Padding="15">
                                            <StackPanel>
                                                <TextBlock Text="LOCAL APPLICATIONS" FontSize="9"
                                                           FontWeight="Bold" Foreground="{StaticResource TextMutedColor}"/>
                                                <TextBlock Text="{Binding LocalDrivingLicenseApplications}"
                                                           FontSize="21" FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimaryColor}"
                                                           Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource StatCardStyle}" Padding="15">
                                            <StackPanel>
                                                <TextBlock Text="INTERNATIONAL LICENSES" FontSize="9"
                                                           FontWeight="Bold" Foreground="{StaticResource TextMutedColor}"/>
                                                <TextBlock Text="{Binding InternationalLicenses}"
                                                           FontSize="21" FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimaryColor}"
                                                           Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource StatCardStyle}" Padding="15">
                                            <StackPanel>
                                                <TextBlock Text="DETAINED LICENSES" FontSize="9"
                                                           FontWeight="Bold" Foreground="{StaticResource TextMutedColor}"/>
                                                <TextBlock Text="{Binding DetainedLicenses}"
                                                           FontSize="21" FontWeight="Bold"
                                                           Foreground="{StaticResource DangerColor}"
                                                           Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource StatCardStyle}" Padding="15">
                                            <StackPanel>
                                                <TextBlock Text="UPCOMING TESTS" FontSize="9"
                                                           FontWeight="Bold" Foreground="{StaticResource TextMutedColor}"/>
                                                <TextBlock Text="{Binding UpcomingTests}"
                                                           FontSize="21" FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimaryColor}"
                                                           Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                </StackPanel>

                                <!-- Quick actions + activity -->
                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.45*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="QuickActionsSection"
                                            Grid.Column="0"
                                            Background="{StaticResource SurfaceColor}"
                                            BorderBrush="{StaticResource BorderColor}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusXLarge}"
                                            Padding="16"
                                            Opacity="0"
                                            RenderTransformOrigin="0.5,0.5"
                                            Margin="0,0,8,0">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="QuickActionsRT" Y="24"/>
                                        </Border.RenderTransform>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <TextBlock Text="QUICK ACTIONS" FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource TextMutedColor}"/>
                                                <TextBlock Text="Start the most common workflows"
                                                           FontSize="11" Foreground="{StaticResource TextSecondaryColor}"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" Text="SHORTCUTS"
                                                       FontSize="9" Foreground="{StaticResource TextMutedColor}"
                                                       VerticalAlignment="Center"/>

                                            <UniformGrid Grid.Row="1" Grid.ColumnSpan="2" Columns="3"
                                                         Margin="0,12,0,0">
                                                <Button Style="{StaticResource QuickActionStyle}"
                                                        Click="QuickNewLocal_Click">
                                                    <StackPanel>
                                                        <Border Width="34" Height="34" CornerRadius="10"
                                                                Background="{StaticResource PrimaryLightColor}">
                                                            <TextBlock Text="+" Foreground="{StaticResource PrimaryColor}"
                                                                       FontSize="18" HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Text="New Local License" FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryColor}"
                                                                   Margin="0,9,0,0"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button Style="{StaticResource QuickActionStyle}"
                                                        Click="QuickRenew_Click">
                                                    <StackPanel>
                                                        <Border Width="34" Height="34" CornerRadius="10"
                                                                Background="{StaticResource SuccessLightColor}">
                                                            <TextBlock Text="↻" Foreground="{StaticResource SuccessColor}"
                                                                       FontSize="17" HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Text="Renew License" FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryColor}"
                                                                   Margin="0,9,0,0"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button Style="{StaticResource QuickActionStyle}"
                                                        Click="QuickNewInternational_Click">
                                                    <StackPanel>
                                                        <Border Width="34" Height="34" CornerRadius="10"
                                                                Background="{StaticResource PrimaryLightColor}">
                                                            <TextBlock Text="◎" Foreground="{StaticResource PrimaryColor}"
                                                                       FontSize="16" HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Text="International" FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryColor}"
                                                                   Margin="0,9,0,0"/>
                                                    </StackPanel>
                                                </Button>
                                            </UniformGrid>
                                        </Grid>
                                    </Border>

                                    <Border x:Name="RecentActivitiesSection"
                                            Grid.Column="1"
                                            Background="{StaticResource SurfaceColor}"
                                            BorderBrush="{StaticResource BorderColor}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusXLarge}"
                                            Padding="16"
                                            Opacity="0"
                                            RenderTransformOrigin="0.5,0.5"
                                            Margin="8,0,0,0">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="RecentActivitiesRT" Y="24"/>
                                        </Border.RenderTransform>
                                        <StackPanel>
                                            <TextBlock Text="SYSTEM STATUS" FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource TextMutedColor}"/>
                                            <TextBlock Text="Current session overview"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryColor}"
                                                       Margin="0,4,0,10"/>

                                            <Border Style="{StaticResource ActivityItemStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Width="8" Height="8"
                                                             Margin="2,0,10,0" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{StaticResource WarningColor}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDashboardAvailable}" Value="True">
                                                                        <Setter Property="Fill" Value="{StaticResource SuccessColor}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="Dashboard data status" FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryColor}"/>
                                                        <TextBlock Text="{Binding DashboardStatus}"
                                                                   FontSize="9" Foreground="{StaticResource TextMutedColor}"
                                                                   Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <Border Style="{StaticResource ActivityItemStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Width="8" Height="8" Fill="{StaticResource SecondaryBrownColor}"
                                                             Margin="2,0,10,0" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="Dashboard summary" FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryColor}"/>
                                                        <TextBlock Text="Values reflect the most recent successful statistics response."
                                                                   FontSize="9" Foreground="{StaticResource TextMutedColor}"
                                                                   Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <Border Style="{StaticResource ActivityItemStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Width="8" Height="8" Fill="{StaticResource PrimaryColor}"
                                                             Margin="2,0,10,0" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="Role-based access enabled" FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryColor}"/>
                                                        <TextBlock Text="Navigation reflects your account role"
                                                                   FontSize="9" Foreground="{StaticResource TextMutedColor}"
                                                                   Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <Border Background="{StaticResource SurfaceColor}"
                                Opacity="0.96"
                                Panel.ZIndex="10"
                                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ProgressBar Width="180" Height="6" IsIndeterminate="True"/>
                                <TextBlock Text="Loading dashboard statistics…"
                                           Style="{StaticResource CaptionStyle}"
                                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="2"
                    Background="{StaticResource SurfaceColor}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessColor}"
                                 VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="System ready" FontSize="9"
                                   Foreground="{StaticResource TextMutedColor}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="DVLD • Secure Session"
                               FontSize="9" Foreground="{StaticResource TextMutedColor}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>











