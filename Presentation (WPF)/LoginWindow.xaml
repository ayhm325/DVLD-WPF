<Window x:Class="Presentation.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:Presentation.Helpers"
        Title="DVLD"
        Width="980"
        Height="620"
        MinWidth="980"
        MinHeight="620"
        MaxWidth="980"
        MaxHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="LoginCloseButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="CloseBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBorder"
                                        Property="Background"
                                        Value="{StaticResource DangerLightColor}"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource DangerColor}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CloseBorder"
                                        Property="Background"
                                        Value="{StaticResource DangerColor}"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource OnPrimaryColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginTextBoxStyle"
               TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,7,0,18"/>
        </Style>

        <Style x:Key="LoginPasswordBoxStyle"
               TargetType="{x:Type PasswordBox}"
               BasedOn="{StaticResource {x:Type PasswordBox}}">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,7,0,0"/>
        </Style>

        <Style x:Key="LoginEyeButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="EyeBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="EyeBorder" Property="Background" Value="{StaticResource PrimaryLightColor}"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="EyeBorder" Property="Background" Value="{StaticResource SurfacePressedColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="14"
            MouseLeftButtonDown="Window_MouseLeftButtonDown"
            Background="{StaticResource BackgroundColor}"
            BorderBrush="{StaticResource BorderColor}"
            BorderThickness="1"
            CornerRadius="24"
            Effect="{StaticResource ElevationShadow3}">
        <Grid ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.43*"/>
                <ColumnDefinition Width="0.57*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource PrimaryColor}"
                    CornerRadius="24,0,0,24">
                <Grid ClipToBounds="True">
                    <Ellipse Width="390"
                             Height="390"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Margin="-170,-160,0,0"
                             Fill="{StaticResource OnPrimaryBrush}"
                             Opacity="0.035"/>
                    <Ellipse Width="300"
                             Height="300"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Bottom"
                             Margin="0,0,-145,-125"
                             Fill="{StaticResource OnPrimaryBrush}"
                             Opacity="0.045"/>
                    <Ellipse Width="170"
                             Height="170"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"
                             Margin="0,55,-75,0"
                             Fill="{StaticResource OnPrimaryBrush}"
                             Opacity="0.035"/>

                    <Border Width="76"
                            Height="76"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="34,30,0,0"
                            CornerRadius="22"
                            Background="#22FFFFFF"
                            BorderBrush="#40FFFFFF"
                            BorderThickness="1">
                        <Border Width="48"
                                Height="48"
                                CornerRadius="15"
                                Background="{StaticResource OnPrimaryColor}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <TextBlock Text="D"
                                       Foreground="{StaticResource PrimaryColor}"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Border>

                    <StackPanel VerticalAlignment="Center"
                                Margin="48,35,42,30">
                        <TextBlock Text="DVLD"
                                   Foreground="{StaticResource OnPrimaryColor}"
                                   FontSize="46"
                                   FontWeight="Bold"/>
                        <TextBlock Text="DRIVING &amp; VEHICLE"
                                   Foreground="{StaticResource PrimaryLightColor}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="3,1,0,0"/>
                        <TextBlock Text="LICENSE DEPARTMENT"
                                   Foreground="{StaticResource PrimaryLightColor}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="3,0,0,0"/>
                        <Border Height="1"
                                Width="70"
                                HorizontalAlignment="Left"
                                Background="#70FFFFFF"
                                Margin="3,24,0,22"/>
                        <TextBlock Text="Everything you need to manage people, drivers, applications and licenses."
                                   Foreground="{StaticResource PrimaryLightColor}"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   LineHeight="23"
                                   MaxWidth="300"
                                   Opacity="0.92"/>
                        <StackPanel Orientation="Horizontal"
                                    Margin="3,30,0,0">
                            <Border Width="8"
                                    Height="8"
                                    CornerRadius="4"
                                    Background="{StaticResource SuccessColor}"
                                    VerticalAlignment="Center"/>
                            <TextBlock Text="  Secure administration"
                                       Foreground="{StaticResource PrimaryLightColor}"
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Margin="3,10,0,0">
                            <Border Width="8"
                                    Height="8"
                                    CornerRadius="4"
                                    Background="{StaticResource SuccessColor}"
                                    VerticalAlignment="Center"/>
                            <TextBlock Text="  Centralized management"
                                       Foreground="{StaticResource PrimaryLightColor}"
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="DVLD MANAGEMENT SYSTEM"
                               Foreground="#80FFFFFF"
                               FontSize="9"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Bottom"
                               Margin="48,0,0,28"/>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Button Content="✕"
                        Click="Close_Click"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="22"
                        Style="{StaticResource LoginCloseButtonStyle}"
                        Panel.ZIndex="20"/>

                <Grid Width="360"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="WELCOME BACK"
                                   Foreground="{StaticResource PrimaryColor}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Left"/>
                        <TextBlock Text="Sign in to continue"
                                   Foreground="{StaticResource TextPrimaryColor}"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   Margin="0,7,0,0"/>
                        <TextBlock Text="Access your DVLD management workspace."
                                   Foreground="{StaticResource TextMutedColor}"
                                   FontSize="12"
                                   Margin="0,7,0,28"/>

                        <TextBlock Text="Username"
                                   Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding Username,UpdateSourceTrigger=PropertyChanged}"
                                 />

                        <TextBlock Text="Password"
                                   Style="{StaticResource LabelStyle}"/>
                        <Grid Margin="0,7,0,0">
                            <PasswordBox x:Name="PasswordBox"
                                         helpers:PasswordBoxHelper.Attach="True"
                                         helpers:PasswordBoxHelper.Password="{Binding Password, Mode=TwoWay}"
                                         PasswordChanged="PasswordBox_PasswordChanged"
                                         Padding="14,0,46,0"
                                         Margin="0"
                                         >
                                <PasswordBox.Style>
                                    <Style TargetType="PasswordBox" BasedOn="{StaticResource LoginPasswordBoxStyle}">
                                        <Setter Property="Margin" Value="0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </PasswordBox.Style>
                            </PasswordBox>

                            <TextBox Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="14,0,46,0"
                                     Margin="0"
                                     >
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource LoginTextBoxStyle}">
                                        <Setter Property="Margin" Value="0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPasswordVisible}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>

                            <Button HorizontalAlignment="Right"
                                    Margin="0,0,3,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource LoginEyeButtonStyle}"
                                    Command="{Binding TogglePasswordVisibilityCommand}"
                                    ToolTip="Show or hide password">
                                <Path Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                      Width="18" Height="18" Stretch="Uniform">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Data" Value="M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9Z"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                                                    <Setter Property="Data" Value="M11.83,9L15,12.16C15,12.11 15,12.05 15,12A3,3 0 0,0 12,9C11.95,9 11.89,9 11.83,9M7.53,9.8L9.08,11.35C9.03,11.56 9,11.77 9,12A3,3 0 0,0 12,15C12.22,15 12.44,14.97 12.65,14.92L14.2,16.47C13.53,16.8 12.79,17 12,17A5,5 0 0,1 7,12C7,11.21 7.2,10.47 7.53,9.8M2,4.27L4.28,6.55L4.73,7C3.08,8.3 1.78,10 1,12C2.73,16.39 7,19.5 12,19.5C13.55,19.5 15.03,19.2 16.38,18.66L16.81,19.08L19.73,22L21,20.73L3.27,3M12,7A5,5 0 0,1 17,12C17,12.64 16.87,13.26 16.64,13.82L19.57,16.75C21.07,15.5 22.27,13.86 23,12C21.27,7.61 17,4.5 12,4.5C10.6,4.5 9.27,4.75 8.07,5.24L10.18,7.35C10.74,7.13 11.35,7 12,7Z"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Button>
                        </Grid>

                        <Grid Margin="0,15,0,0">
                            <CheckBox Content="Remember me"
                                      IsChecked="{Binding RememberMe,Mode=TwoWay}"
                                      VerticalAlignment="Center"/>
                            <TextBlock Text="Protected access"
                                       Foreground="{StaticResource SuccessColor}"
                                       FontSize="10"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Button Content="SIGN IN  →"
                                Command="{Binding LoginCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="48"
                                Margin="0,24,0,0"
                                IsDefault="True"/>

                        <Grid Margin="0,28,0,0">
                            <Border Height="1"
                                    Background="{StaticResource BorderColor}"
                                    VerticalAlignment="Center"/>
                            <Border Background="{StaticResource BackgroundColor}"
                                    Padding="12,0"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="DVLD CONTROL CENTER"
                                           Foreground="{StaticResource TextMutedColor}"
                                           FontSize="9"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </Grid>

                        <TextBlock Text="Authorized personnel only"
                                   Foreground="{StaticResource TextMutedColor}"
                                   FontSize="10"
                                   HorizontalAlignment="Center"
                                   Margin="0,18,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>