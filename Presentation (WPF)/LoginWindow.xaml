<Window x:Class="Presentation.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DVLD"
        Width="980"
        Height="620"
        MinWidth="980"
        MinHeight="620"
        MaxWidth="980"
        MaxHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="LoginCloseButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="CloseBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBorder"
                                        Property="Background"
                                        Value="{StaticResource DangerLightColor}"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource DangerColor}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CloseBorder"
                                        Property="Background"
                                        Value="{StaticResource DangerColor}"/>
                                <Setter Property="Foreground"
                                        Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LoginTextBoxStyle"
               TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,7,0,18"/>
        </Style>
        <Style x:Key="LoginPasswordBoxStyle"
               TargetType="{x:Type PasswordBox}"
               BasedOn="{StaticResource {x:Type PasswordBox}}">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,7,0,0"/>
        </Style>
    </Window.Resources>
    <Border Margin="14"
            Background="{StaticResource BackgroundColor}"
            BorderBrush="{StaticResource BorderColor}"
            BorderThickness="1"
            CornerRadius="24">
        <Border.Effect>
            <DropShadowEffect Color="#000000"
                              BlurRadius="35"
                              ShadowDepth="0"
                              Opacity="0.16"/>
        </Border.Effect>
        <Grid ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.43*"/>
                <ColumnDefinition Width="0.57*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Background="{StaticResource PrimaryColor}"
                    CornerRadius="24,0,0,24">
                <Grid ClipToBounds="True">
                    <Ellipse Width="390"
                             Height="390"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Margin="-170,-160,0,0"
                             Fill="White"
                             Opacity="0.035"/>
                    <Ellipse Width="300"
                             Height="300"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Bottom"
                             Margin="0,0,-145,-125"
                             Fill="White"
                             Opacity="0.045"/>
                    <Ellipse Width="170"
                             Height="170"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"
                             Margin="0,55,-75,0"
                             Fill="White"
                             Opacity="0.035"/>
                    <Border Width="76"
                            Height="76"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="34,30,0,0"
                            CornerRadius="22"
                            Background="#22FFFFFF"
                            BorderBrush="#40FFFFFF"
                            BorderThickness="1">
                        <Grid>
                            <Border Width="48"
                                    Height="48"
                                    CornerRadius="15"
                                    Background="White"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <TextBlock Text="D"
                                           Foreground="{StaticResource PrimaryColor}"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Center"
                                Margin="48,35,42,30">
                        <TextBlock Text="DVLD"
                                   Foreground="White"
                                   FontSize="46"
                                   FontWeight="Bold"/>
                        <TextBlock Text="DRIVING &amp; VEHICLE"
                                   Foreground="#D9FFFA"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="3,1,0,0"/>
                        <TextBlock Text="LICENSE DEPARTMENT"
                                   Foreground="#D9FFFA"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="3,0,0,0"/>
                        <Border Height="1"
                                Width="70"
                                HorizontalAlignment="Left"
                                Background="#70FFFFFF"
                                Margin="3,24,0,22"/>
                        <TextBlock Text="Everything you need to manage people, drivers, applications and licenses."
                                   Foreground="#E9FFFC"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   LineHeight="23"
                                   MaxWidth="300"
                                   Opacity="0.92"/>
                        <StackPanel Orientation="Horizontal"
                                    Margin="3,30,0,0">
                            <Border Width="8"
                                    Height="8"
                                    CornerRadius="4"
                                    Background="#B8FFF5"
                                    VerticalAlignment="Center"/>
                            <TextBlock Text="  Secure administration"
                                       Foreground="#E1FFFB"
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Margin="3,10,0,0">
                            <Border Width="8"
                                    Height="8"
                                    CornerRadius="4"
                                    Background="#B8FFF5"
                                    VerticalAlignment="Center"/>
                            <TextBlock Text="  Centralized management"
                                       Foreground="#E1FFFB"
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="DVLD MANAGEMENT SYSTEM"
                               Foreground="#80FFFFFF"
                               FontSize="9"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Bottom"
                               Margin="48,0,0,28"/>
                </Grid>
            </Border>
            <Grid Grid.Column="1"
                  Margin="0">
                <Button Content="✕"
                        Click="Close_Click"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="22"
                        Style="{StaticResource LoginCloseButtonStyle}"
                        Panel.ZIndex="20"/>
                <Grid Width="360"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="WELCOME BACK"
                                   Foreground="{StaticResource PrimaryColor}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Left"/>
                        <TextBlock Text="Sign in to continue"
                                   Foreground="{StaticResource TextPrimaryColor}"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   Margin="0,7,0,0"/>
                        <TextBlock Text="Access your DVLD management workspace."
                                   Foreground="{StaticResource TextMutedColor}"
                                   FontSize="12"
                                   Margin="0,7,0,28"/>
                        <TextBlock Text="Username"
                                   Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding Username,UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource LoginTextBoxStyle}"/>
                        <TextBlock Text="Password"
                                   Style="{StaticResource LabelStyle}"/>
                        <PasswordBox x:Name="PasswordBox"
                                     PasswordChanged="PasswordBox_PasswordChanged"
                                     Style="{StaticResource LoginPasswordBoxStyle}"/>
                        <Grid Margin="0,15,0,0">
                            <CheckBox Content="Remember me"
                                      IsChecked="{Binding RememberMe,Mode=TwoWay}"
                                      VerticalAlignment="Center"/>
                            <TextBlock Text="Protected access"
                                       Foreground="{StaticResource SuccessColor}"
                                       FontSize="10"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <Button Content="SIGN IN  →"
                                Command="{Binding LoginCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="48"
                                Margin="0,24,0,0"
                                IsDefault="True"/>
                        <Grid Margin="0,28,0,0">
                            <Border Height="1"
                                    Background="{StaticResource BorderColor}"
                                    VerticalAlignment="Center"/>
                            <Border Background="{StaticResource BackgroundColor}"
                                    Padding="12,0"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="DVLD CONTROL CENTER"
                                           Foreground="{StaticResource TextMutedColor}"
                                           FontSize="9"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="Authorized personnel only"
                                   Foreground="{StaticResource TextMutedColor}"
                                   FontSize="10"
                                   HorizontalAlignment="Center"
                                   Margin="0,18,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>