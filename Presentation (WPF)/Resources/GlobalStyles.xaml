<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        DVLD PROFESSIONAL MODERN LIGHT DESIGN SYSTEM
        Graphite + Burgundy + Warm Gold + Emerald
        No blue / cyan / teal / indigo tones.
        Global resource dictionary: resource names are kept stable for existing Views.
    -->

    <!-- ============================================================
         0. DESIGN TOKENS
         ============================================================ -->

    <FontFamily x:Key="DefaultFontFamily">Segoe UI Variable, Segoe UI</FontFamily>

    <sys:Double x:Key="Spacing4">4</sys:Double>
    <sys:Double x:Key="Spacing8">8</sys:Double>
    <sys:Double x:Key="Spacing12">12</sys:Double>
    <sys:Double x:Key="Spacing16">16</sys:Double>
    <sys:Double x:Key="Spacing20">20</sys:Double>
    <sys:Double x:Key="Spacing24">24</sys:Double>
    <sys:Double x:Key="Spacing32">32</sys:Double>
    <sys:Double x:Key="Spacing40">40</sys:Double>

    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="GroupBoxPadding">16</Thickness>
    <Thickness x:Key="InputPadding">12,0</Thickness>
    <Thickness x:Key="ButtonPadding">20,0</Thickness>
    <Thickness x:Key="ButtonPaddingCompact">16,0</Thickness>
    <Thickness x:Key="DataGridCellPadding">12,8</Thickness>
    <Thickness x:Key="DataGridHeaderPadding">12,10</Thickness>

    <CornerRadius x:Key="RadiusSmall">6</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">9</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">14</CornerRadius>
    <CornerRadius x:Key="RadiusXLarge">18</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>
    <CornerRadius x:Key="RadiusFocusRing">10</CornerRadius>

    <sys:Double x:Key="FontSizeCaption">12</sys:Double>
    <sys:Double x:Key="FontSizeLabel">13</sys:Double>
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeHeader">18</sys:Double>
    <sys:Double x:Key="FontSizeSection">20</sys:Double>
    <sys:Double x:Key="FontSizePageTitle">24</sys:Double>
    <sys:Double x:Key="FontSizeHero">30</sys:Double>

    <FontWeight x:Key="FontWeightRegular">Regular</FontWeight>
    <FontWeight x:Key="FontWeightMedium">Medium</FontWeight>
    <FontWeight x:Key="FontWeightSemiBold">SemiBold</FontWeight>
    <FontWeight x:Key="FontWeightBold">Bold</FontWeight>

    <sys:Double x:Key="ButtonHeight">40</sys:Double>
    <sys:Double x:Key="ButtonFontSize">14</sys:Double>
    <sys:Double x:Key="InputHeight">40</sys:Double>
    <sys:Double x:Key="InputFontSize">14</sys:Double>

    <Duration x:Key="MotionFast">0:0:0.10</Duration>
    <Duration x:Key="MotionNormal">0:0:0.16</Duration>
    <Duration x:Key="MotionSlow">0:0:0.22</Duration>

    <!-- ============================================================
         1. COLOR SYSTEM
         ============================================================ -->

    <!-- Primary: sophisticated wine/burgundy, deliberately distinct from Danger. -->
    <SolidColorBrush x:Key="PrimaryColor" Color="#7F1D3A"/>
    <SolidColorBrush x:Key="PrimaryHoverColor" Color="#6B1731"/>
    <SolidColorBrush x:Key="PrimaryPressedColor" Color="#561226"/>
    <SolidColorBrush x:Key="PrimaryLightColor" Color="#F9E8EE"/>
    <SolidColorBrush x:Key="PrimarySoftColor" Color="#FDF3F6"/>

    <!-- Warm application canvas. -->
    <SolidColorBrush x:Key="BackgroundColor" Color="#F7F5F2"/>
    <SolidColorBrush x:Key="SurfaceColor" Color="#FFFEFC"/>
    <SolidColorBrush x:Key="SurfaceSecondaryColor" Color="#FBF9F6"/>
    <SolidColorBrush x:Key="SurfaceHoverColor" Color="#F1EEE9"/>
    <SolidColorBrush x:Key="SurfacePressedColor" Color="#EAE5DE"/>
    <SolidColorBrush x:Key="InputBackgroundColor" Color="#FFFEFC"/>

    <!-- Typography. -->
    <SolidColorBrush x:Key="TextPrimaryColor" Color="#211F1D"/>
    <SolidColorBrush x:Key="TextSecondaryColor" Color="#514B46"/>
    <SolidColorBrush x:Key="TextMutedColor" Color="#756D66"/>
    <SolidColorBrush x:Key="TextDisabledColor" Color="#AAA39C"/>
    <SolidColorBrush x:Key="TextOnPrimaryColor" Color="#FFFFFF"/>

    <!-- Borders. -->
    <SolidColorBrush x:Key="BorderColor" Color="#E2DDD6"/>
    <SolidColorBrush x:Key="BorderStrongColor" Color="#CEC7BE"/>
    <SolidColorBrush x:Key="InputBorderColor" Color="#CFC8BF"/>
    <SolidColorBrush x:Key="FocusBorderColor" Color="#9F274B"/>

    <!-- Success. -->
    <SolidColorBrush x:Key="SuccessColor" Color="#16845A"/>
    <SolidColorBrush x:Key="SuccessHoverColor" Color="#126C4A"/>
    <SolidColorBrush x:Key="SuccessPressedColor" Color="#0E563B"/>
    <SolidColorBrush x:Key="SuccessLightColor" Color="#EAF7F0"/>

    <!-- Warning. -->
    <SolidColorBrush x:Key="WarningColor" Color="#B56A00"/>
    <SolidColorBrush x:Key="WarningHoverColor" Color="#955700"/>
    <SolidColorBrush x:Key="WarningPressedColor" Color="#774600"/>
    <SolidColorBrush x:Key="WarningLightColor" Color="#FFF4DE"/>

    <!-- Danger. -->
    <SolidColorBrush x:Key="DangerColor" Color="#B4232D"/>
    <SolidColorBrush x:Key="DangerHoverColor" Color="#941D25"/>
    <SolidColorBrush x:Key="DangerPressedColor" Color="#74171E"/>
    <SolidColorBrush x:Key="DangerLightColor" Color="#FCEBED"/>

    <SolidColorBrush x:Key="ErrorColor" Color="#B4232D"/>

    <!-- Information uses warm gold rather than blue. -->
    <SolidColorBrush x:Key="InfoColor" Color="#9A5B00"/>
    <SolidColorBrush x:Key="InfoHoverColor" Color="#7E4A00"/>
    <SolidColorBrush x:Key="InfoPressedColor" Color="#633A00"/>
    <SolidColorBrush x:Key="InfoLightColor" Color="#FFF4DE"/>

    <!-- Selection. -->
    <SolidColorBrush x:Key="SelectionBackgroundColor" Color="#F2D7E0"/>
    <SolidColorBrush x:Key="SelectionForegroundColor" Color="#67172F"/>
    <SolidColorBrush x:Key="SelectionHoverBackgroundColor" Color="#E9C4D1"/>

    <SolidColorBrush x:Key="ButtonPressedColor" Color="#EEE6E7"/>

    <!-- Compatibility aliases used by existing Views. -->
    <SolidColorBrush x:Key="TextColor" Color="#211F1D"/>
    <SolidColorBrush x:Key="CardBackground" Color="#FFFEFC"/>
    <SolidColorBrush x:Key="SecondaryTextColor" Color="#514B46"/>
    <SolidColorBrush x:Key="SecondaryColor" Color="#514B46"/>
    <SolidColorBrush x:Key="InputBackground" Color="#FFFEFC"/>

    <!-- ============================================================
         2. MOTION / EFFECTS
         ============================================================ -->

    <DropShadowEffect x:Key="ElevationShadow1"
                      Color="#000000"
                      Direction="270"
                      ShadowDepth="2"
                      BlurRadius="14"
                      Opacity="0.055"/>

    <DropShadowEffect x:Key="ElevationShadow2"
                      Color="#000000"
                      Direction="270"
                      ShadowDepth="4"
                      BlurRadius="18"
                      Opacity="0.095"/>

    <DropShadowEffect x:Key="ElevationShadow3"
                      Color="#000000"
                      Direction="270"
                      ShadowDepth="8"
                      BlurRadius="28"
                      Opacity="0.13"/>

    <DropShadowEffect x:Key="CardShadow"
                      Color="#000000"
                      Direction="270"
                      ShadowDepth="2"
                      BlurRadius="14"
                      Opacity="0.055"/>

    <DropShadowEffect x:Key="PopupShadow"
                      Color="#000000"
                      Direction="270"
                      ShadowDepth="6"
                      BlurRadius="22"
                      Opacity="0.14"/>

    <!-- ============================================================
         3. GLOBAL WINDOW / FOCUS
         ============================================================ -->

    <Style TargetType="{x:Type Window}">
        <Setter Property="Background" Value="{StaticResource BackgroundColor}"/>
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="FocusVisualStyle" TargetType="{x:Type Control}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Border Margin="1"
                            CornerRadius="{StaticResource RadiusFocusRing}"
                            BorderBrush="{StaticResource FocusBorderColor}"
                            BorderThickness="2"
                            Opacity="0.85"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         4. SCROLLBARS
         ============================================================ -->

    <Style x:Key="ScrollBarThumb" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="ThumbBorder"
                            Width="7"
                            Margin="1,2"
                            Background="{StaticResource BorderStrongColor}"
                            CornerRadius="4"
                            Opacity="0.82"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder"
                                    Property="Background"
                                    Value="{StaticResource TextMutedColor}"/>
                            <Setter TargetName="ThumbBorder"
                                    Property="Opacity"
                                    Value="1"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder"
                                    Property="Background"
                                    Value="{StaticResource PrimaryColor}"/>
                            <Setter TargetName="ThumbBorder"
                                    Property="Opacity"
                                    Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
        <Setter Property="Foreground" Value="{StaticResource BorderStrongColor}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="11"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid Width="11" Background="Transparent">
                        <Track x:Name="PART_Track"
                               Focusable="False"
                               IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.LineUpCommand"
                                              CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                              Focusable="False"
                                              IsTabStop="False"
                                              Opacity="0"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBarThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.LineDownCommand"
                                              CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                              Focusable="False"
                                              IsTabStop="False"
                                              Opacity="0"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="11"/>
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid Height="11" Background="Transparent">
                                <Track x:Name="PART_Track"
                                       Focusable="False"
                                       IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.LineLeftCommand"
                                                      CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                      Focusable="False"
                                                      IsTabStop="False"
                                                      Opacity="0"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollBarThumb}"
                                               Margin="2,1"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.LineRightCommand"
                                                      CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                      Focusable="False"
                                                      IsTabStop="False"
                                                      Opacity="0"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================
         5. CONTAINERS
         ============================================================ -->

    <Style x:Key="CardStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="{StaticResource CardPadding}"/>
        <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource BorderStrongColor}"/>
                <Setter Property="Effect" Value="{StaticResource ElevationShadow2}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type GroupBox}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="{StaticResource GroupBoxPadding}"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusLarge}"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Margin="12,-10,12,6"
                                    Padding="9,1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="{StaticResource BackgroundColor}"
                                    CornerRadius="{StaticResource RadiusSmall}">
                                <ContentPresenter ContentSource="Header"
                                                  TextElement.FontWeight="{StaticResource FontWeightSemiBold}"
                                                  TextElement.Foreground="{StaticResource TextPrimaryColor}"
                                                  TextElement.FontSize="15"/>
                            </Border>
                            <ContentPresenter Grid.Row="1"
                                              Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         6. TYPOGRAPHY
         ============================================================ -->

    <Style x:Key="PageTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource FontSizePageTitle}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSection}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
    </Style>

    <Style x:Key="HeaderStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeHeader}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
    </Style>

    <Style x:Key="LabelStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeLabel}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightMedium}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryColor}"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>

    <Style x:Key="CaptionStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
        <Setter Property="Foreground" Value="{StaticResource TextMutedColor}"/>
    </Style>

    <Style x:Key="ValueTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ============================================================
         7. BUTTON SYSTEM
         ============================================================ -->

    <Style TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource ButtonFontSize}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightMedium}"/>
        <Setter Property="Height" Value="{StaticResource ButtonHeight}"/>
        <Setter Property="MinWidth" Value="88"/>
        <Setter Property="Padding" Value="{StaticResource ButtonPaddingCompact}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualStyle}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusMedium}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder"
                                    Property="Opacity"
                                    Value="0.93"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder"
                                    Property="Opacity"
                                    Value="0.82"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder"
                                    Property="Opacity"
                                    Value="0.48"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
        <Setter Property="Foreground" Value="{StaticResource TextOnPrimaryColor}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}"/>
        <Setter Property="MinWidth" Value="110"/>
        <Setter Property="Effect" Value="{StaticResource ElevationShadow1}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimaryHoverColor}"/>
                <Setter Property="BorderBrush" Value="{StaticResource PrimaryHoverColor}"/>
                <Setter Property="Effect" Value="{StaticResource ElevationShadow2}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimaryPressedColor}"/>
                <Setter Property="BorderBrush" Value="{StaticResource PrimaryPressedColor}"/>
                <Setter Property="Effect" Value="{StaticResource ElevationShadow1}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SecondaryButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongColor}"/>
        <Setter Property="Effect" Value="{StaticResource ElevationShadow1}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SurfaceHoverColor}"/>
                <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource SurfacePressedColor}"/>
                <Setter Property="BorderBrush" Value="{StaticResource PrimaryPressedColor}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SuccessButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource SuccessColor}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource SuccessColor}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SuccessHoverColor}"/>
                <Setter Property="BorderBrush" Value="{StaticResource SuccessHoverColor}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource SuccessPressedColor}"/>
                <Setter Property="BorderBrush" Value="{StaticResource SuccessPressedColor}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DangerButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource DangerColor}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource DangerColor}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource DangerHoverColor}"/>
                <Setter Property="BorderBrush" Value="{StaticResource DangerHoverColor}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource DangerPressedColor}"/>
                <Setter Property="BorderBrush" Value="{StaticResource DangerPressedColor}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="WarningButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource WarningColor}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource WarningColor}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource WarningHoverColor}"/>
                <Setter Property="BorderBrush" Value="{StaticResource WarningHoverColor}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource WarningPressedColor}"/>
                <Setter Property="BorderBrush" Value="{StaticResource WarningPressedColor}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GhostButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryColor}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimaryLightColor}"/>
                <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource SelectionBackgroundColor}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IconButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="MinWidth" Value="36"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryColor}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="IconBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusMedium}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="IconBorder"
                                    Property="Background"
                                    Value="{StaticResource PrimaryLightColor}"/>
                            <Setter Property="Foreground"
                                    Value="{StaticResource PrimaryColor}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="IconBorder"
                                    Property="Background"
                                    Value="{StaticResource SelectionBackgroundColor}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         8. INPUT SYSTEM
         ============================================================ -->

    <Style TargetType="{x:Type TextBox}">
        <Setter Property="Height" Value="{StaticResource InputHeight}"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="Padding" Value="{StaticResource InputPadding}"/>
        <Setter Property="FontSize" Value="{StaticResource InputFontSize}"/>
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
        <Setter Property="Background" Value="{StaticResource InputBackgroundColor}"/>
        <Setter Property="BorderBrush" Value="{StaticResource InputBorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="InputBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusMedium}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="InputBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource BorderStrongColor}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="InputBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource FocusBorderColor}"/>
                            <Setter TargetName="InputBorder"
                                    Property="BorderThickness"
                                    Value="1.5"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="InputBorder"
                                    Property="Background"
                                    Value="{StaticResource SurfaceSecondaryColor}"/>
                            <Setter TargetName="InputBorder"
                                    Property="Opacity"
                                    Value="0.65"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type PasswordBox}">
        <Setter Property="Height" Value="{StaticResource InputHeight}"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="Padding" Value="{StaticResource InputPadding}"/>
        <Setter Property="FontSize" Value="{StaticResource InputFontSize}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
        <Setter Property="Background" Value="{StaticResource InputBackgroundColor}"/>
        <Setter Property="BorderBrush" Value="{StaticResource InputBorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualStyle}"/>
    </Style>

    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="Height" Value="{StaticResource InputHeight}"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="FontSize" Value="{StaticResource InputFontSize}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
        <Setter Property="Background" Value="{StaticResource InputBackgroundColor}"/>
        <Setter Property="BorderBrush" Value="{StaticResource InputBorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="{StaticResource InputPadding}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualStyle}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="{StaticResource RadiusSmall}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder"
                                    Property="Background"
                                    Value="{StaticResource PrimaryLightColor}"/>
                            <Setter Property="Foreground"
                                    Value="{StaticResource PrimaryColor}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder"
                                    Property="Background"
                                    Value="{StaticResource SelectionBackgroundColor}"/>
                            <Setter Property="Foreground"
                                    Value="{StaticResource SelectionForegroundColor}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualStyle}"/>
        <Setter Property="Margin" Value="0,2"/>
    </Style>

    <Style TargetType="{x:Type RadioButton}">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualStyle}"/>
        <Setter Property="Margin" Value="0,2"/>
    </Style>

    <!-- ============================================================
         9. TAB SYSTEM
         ============================================================ -->

    <Style x:Key="TabItemStyle" TargetType="{x:Type TabItem}">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryColor}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightMedium}"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Grid>
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource RadiusMedium}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ContentSource="Header"/>
                        </Border>
                        <Border x:Name="ActiveLine"
                                Height="3"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Stretch"
                                Background="{StaticResource PrimaryColor}"
                                CornerRadius="2"
                                Opacity="0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabBorder"
                                    Property="Background"
                                    Value="{StaticResource PrimarySoftColor}"/>
                            <Setter Property="Foreground"
                                    Value="{StaticResource PrimaryColor}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabBorder"
                                    Property="Background"
                                    Value="{StaticResource PrimaryLightColor}"/>
                            <Setter Property="Foreground"
                                    Value="{StaticResource PrimaryColor}"/>
                            <Setter Property="FontWeight"
                                    Value="{StaticResource FontWeightSemiBold}"/>
                            <Setter TargetName="ActiveLine"
                                    Property="Opacity"
                                    Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         10. DATA GRID
         ============================================================ -->

    <Style x:Key="DataGridHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background" Value="{StaticResource SurfaceHoverColor}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryColor}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeLabel}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}"/>
        <Setter Property="Padding" Value="{StaticResource DataGridHeaderPadding}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <Style x:Key="DataGridCellStyle" TargetType="{x:Type DataGridCell}">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="{StaticResource DataGridCellPadding}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualStyle}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{StaticResource SelectionForegroundColor}"/>
                <Setter Property="Background" Value="{StaticResource SelectionBackgroundColor}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DataGridRowStyle" TargetType="{x:Type DataGridRow}">
        <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Margin" Value="0,1"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SurfaceHoverColor}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource SelectionBackgroundColor}"/>
                <Setter Property="Foreground" Value="{StaticResource SelectionForegroundColor}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type DataGrid}">
        <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="RowBackground" Value="{StaticResource SurfaceColor}"/>
        <Setter Property="AlternatingRowBackground" Value="{StaticResource SurfaceSecondaryColor}"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderColor}"/>
        <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource DataGridHeaderStyle}"/>
        <Setter Property="CellStyle" Value="{StaticResource DataGridCellStyle}"/>
        <Setter Property="RowStyle" Value="{StaticResource DataGridRowStyle}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualStyle}"/>
    </Style>

    <!-- ============================================================
         11. SEPARATORS / STATUS
         ============================================================ -->

    <Style TargetType="{x:Type Separator}">
        <Setter Property="Background" Value="{StaticResource BorderColor}"/>
        <Setter Property="Margin" Value="0,8"/>
        <Setter Property="Height" Value="1"/>
    </Style>

    <Style x:Key="StatusSuccessStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource SuccessLightColor}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SuccessColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}"/>
        <Setter Property="Padding" Value="9,4"/>
    </Style>

    <Style x:Key="StatusWarningStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource WarningLightColor}"/>
        <Setter Property="BorderBrush" Value="{StaticResource WarningColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}"/>
        <Setter Property="Padding" Value="9,4"/>
    </Style>

    <Style x:Key="StatusDangerStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource DangerLightColor}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DangerColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}"/>
        <Setter Property="Padding" Value="9,4"/>
    </Style>

    <Style x:Key="StatusInfoStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource InfoLightColor}"/>
        <Setter Property="BorderBrush" Value="{StaticResource InfoColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}"/>
        <Setter Property="Padding" Value="9,4"/>
    </Style>

    <!-- ============================================================
         12. TOOLTIP / MENU / POPUP
         ============================================================ -->

    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="Background" Value="{StaticResource TextPrimaryColor}"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="9,6"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Effect" Value="{StaticResource PopupShadow}"/>
    </Style>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="Effect" Value="{StaticResource PopupShadow}"/>
    </Style>

    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <Border x:Name="MenuBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource RadiusSmall}"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0"
                                              ContentSource="Icon"
                                              Margin="0,0,10,0"/>
                            <ContentPresenter Grid.Column="1"
                                              ContentSource="Header"
                                              VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="MenuBorder"
                                    Property="Background"
                                    Value="{StaticResource PrimaryLightColor}"/>
                            <Setter Property="Foreground"
                                    Value="{StaticResource PrimaryColor}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         13. PROGRESS / LOADING
         ============================================================ -->

    <Style TargetType="{x:Type ProgressBar}">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Background" Value="{StaticResource SurfaceHoverColor}"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="3"
                            ClipToBounds="True">
                        <Grid>
                            <Border x:Name="PART_Indicator"
                                    Background="{TemplateBinding Foreground}"
                                    HorizontalAlignment="Left"
                                    CornerRadius="3"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
