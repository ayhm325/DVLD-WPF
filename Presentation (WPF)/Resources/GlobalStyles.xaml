<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- DVLD PROFESSIONAL FLUENT LIGHT THEME V4.2 FINAL -->
    <!-- Graphite + Teal | Segoe UI Variable | Token Based -->

    <!-- 0. DESIGN TOKENS -->
    <FontFamily x:Key="DefaultFontFamily">Segoe UI Variable, Segoe UI</FontFamily>
    <sys:Double x:Key="Spacing4">4</sys:Double>
    <sys:Double x:Key="Spacing8">8</sys:Double>
    <sys:Double x:Key="Spacing12">12</sys:Double>
    <sys:Double x:Key="Spacing16">16</sys:Double>
    <sys:Double x:Key="Spacing20">20</sys:Double>
    <sys:Double x:Key="Spacing24">24</sys:Double>
    <sys:Double x:Key="Spacing32">32</sys:Double>
    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="GroupBoxPadding">16</Thickness>
    <Thickness x:Key="InputPadding">12,0</Thickness>
    <Thickness x:Key="ButtonPadding">20,0</Thickness>
    <Thickness x:Key="ButtonPaddingCompact">16,0</Thickness>
    <Thickness x:Key="DataGridCellPadding">12,8</Thickness>
    <Thickness x:Key="DataGridHeaderPadding">12,10</Thickness>
    <CornerRadius x:Key="RadiusSmall">6</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">12</CornerRadius>
    <CornerRadius x:Key="RadiusFocusRing">10</CornerRadius>
    <sys:Double x:Key="FontSizeCaption">12</sys:Double>
    <sys:Double x:Key="FontSizeLabel">13</sys:Double>
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeHeader">18</sys:Double>
    <sys:Double x:Key="FontSizeSection">20</sys:Double>
    <sys:Double x:Key="FontSizePageTitle">24</sys:Double>
    <FontWeight x:Key="FontWeightRegular">Regular</FontWeight>
    <FontWeight x:Key="FontWeightMedium">Medium</FontWeight>
    <FontWeight x:Key="FontWeightSemiBold">SemiBold</FontWeight>
    <FontWeight x:Key="FontWeightBold">Bold</FontWeight>
    <sys:Double x:Key="ButtonHeight">40</sys:Double>
    <sys:Double x:Key="ButtonFontSize">14</sys:Double>
    <sys:Double x:Key="InputHeight">40</sys:Double>
    <sys:Double x:Key="InputFontSize">14</sys:Double>

    <!-- 1. COLORS -->
    <!--<SolidColorBrush x:Key="PrimaryColor" Color="#0F766E"/>-->
    <!--<SolidColorBrush x:Key="PrimaryColor" Color="Goldenrod"/>-->
    <!--<SolidColorBrush x:Key="PrimaryColor" Color="#D97706"/>-->
    <!--<SolidColorBrush x:Key="PrimaryColor" Color="#B45309"/>-->
    <SolidColorBrush x:Key="PrimaryColor" Color="#DC2626"/>
    <SolidColorBrush x:Key="PrimaryHoverColor" Color="#B91C1C"/>
    <SolidColorBrush x:Key="PrimaryPressedColor" Color="#991B1B"/>
    <SolidColorBrush x:Key="PrimaryLightColor" Color="#FEF2F2"/>

    <SolidColorBrush x:Key="BackgroundColor" Color="#F6F8F7"/>
    <SolidColorBrush x:Key="SurfaceColor" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceSecondaryColor" Color="#F8FAF9"/>
    <SolidColorBrush x:Key="SurfaceHoverColor" Color="#EEF2F1"/>
    <SolidColorBrush x:Key="InputBackgroundColor" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="TextPrimaryColor" Color="#18211F"/>
    <SolidColorBrush x:Key="TextSecondaryColor" Color="#4B5B56"/>
    <SolidColorBrush x:Key="TextMutedColor" Color="#66756F"/>
    <SolidColorBrush x:Key="TextDisabledColor" Color="#98A6A1"/>

    <SolidColorBrush x:Key="BorderColor" Color="#DCE5E2"/>
    <SolidColorBrush x:Key="BorderStrongColor" Color="#C6D2CE"/>
    <SolidColorBrush x:Key="InputBorderColor" Color="#C6D2CE"/>

    <!-- Focus -->
    <SolidColorBrush x:Key="FocusBorderColor" Color="#DC2626"/>

    <!-- Success -->
    <SolidColorBrush x:Key="SuccessColor" Color="#16A34A"/>
    <SolidColorBrush x:Key="SuccessHoverColor" Color="#15803D"/>
    <SolidColorBrush x:Key="SuccessPressedColor" Color="#166534"/>
    <SolidColorBrush x:Key="SuccessLightColor" Color="#F0FDF4"/>

    <!-- Warning -->
    <SolidColorBrush x:Key="WarningColor" Color="#D97706"/>
    <SolidColorBrush x:Key="WarningHoverColor" Color="#B45309"/>
    <SolidColorBrush x:Key="WarningPressedColor" Color="#92400E"/>
    <SolidColorBrush x:Key="WarningLightColor" Color="#FFFBEB"/>

    <!-- Danger -->
    <SolidColorBrush x:Key="DangerColor" Color="#DC2626"/>
    <SolidColorBrush x:Key="DangerHoverColor" Color="#B91C1C"/>
    <SolidColorBrush x:Key="DangerPressedColor" Color="#991B1B"/>
    <SolidColorBrush x:Key="DangerLightColor" Color="#FEF2F2"/>

    <SolidColorBrush x:Key="ErrorColor" Color="#DC2626"/>

    <!-- Info -->
    <SolidColorBrush x:Key="InfoColor" Color="#D97706"/>
    <SolidColorBrush x:Key="InfoHoverColor" Color="#B45309"/>
    <SolidColorBrush x:Key="InfoPressedColor" Color="#92400E"/>
    <SolidColorBrush x:Key="InfoLightColor" Color="#FFFBEB"/>

    <!-- Selection -->
    <SolidColorBrush x:Key="SelectionBackgroundColor" Color="#FECACA"/>
    <SolidColorBrush x:Key="SelectionForegroundColor" Color="#991B1B"/>
    <SolidColorBrush x:Key="SelectionHoverBackgroundColor" Color="#FCA5A5"/>

    <SolidColorBrush x:Key="ButtonPressedColor" Color="#F3E8E8"/>

    <!-- Compatibility aliases -->
    <SolidColorBrush x:Key="TextColor" Color="#18211F"/>
    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SecondaryTextColor" Color="#4B5B56"/>
    <SolidColorBrush x:Key="SecondaryColor" Color="#4B5B56"/>
    <SolidColorBrush x:Key="InputBackground" Color="#FFFFFF"/>

    <!-- 2. SHADOWS -->
    <DropShadowEffect x:Key="ElevationShadow1"
                      Color="#000000"
                      Direction="270"
                      ShadowDepth="2"
                      BlurRadius="12"
                      Opacity="0.06"/>
    <DropShadowEffect x:Key="ElevationShadow2"
                      Color="#000000"
                      Direction="270"
                      ShadowDepth="4"
                      BlurRadius="16"
                      Opacity="0.12"/>
    <DropShadowEffect x:Key="ElevationShadow3"
                      Color="#000000"
                      Direction="270"
                      ShadowDepth="8"
                      BlurRadius="24"
                      Opacity="0.16"/>
    <DropShadowEffect x:Key="CardShadow"
                      Color="#000000"
                      Direction="270"
                      ShadowDepth="2"
                      BlurRadius="12"
                      Opacity="0.06"/>
    <DropShadowEffect x:Key="PopupShadow"
                      Color="#000000"
                      Direction="270"
                      ShadowDepth="4"
                      BlurRadius="16"
                      Opacity="0.12"/>

    <!-- 3. GLOBAL -->
    <Style TargetType="{x:Type Window}">
        <Setter Property="Background" Value="{StaticResource BackgroundColor}"/>
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- 4. SCROLLBAR -->
    <Style x:Key="ScrollBarThumb" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="ThumbBorder"
                            Width="6"
                            Margin="1"
                            Background="{StaticResource BorderStrongColor}"
                            CornerRadius="3"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder"
                                    Property="Background"
                                    Value="{StaticResource TextMutedColor}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder"
                                    Property="Background"
                                    Value="{StaticResource TextSecondaryColor}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
        <Setter Property="Foreground" Value="{StaticResource BorderStrongColor}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid Width="10"
                          Background="Transparent">
                        <Track x:Name="PART_Track"
                               Focusable="False"
                               IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.LineUpCommand"
                                              CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                              Focusable="False"
                                              IsTabStop="False"
                                              Opacity="0"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBarThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.LineDownCommand"
                                              CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                              Focusable="False"
                                              IsTabStop="False"
                                              Opacity="0"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="10"/>
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid Height="10"
                                  Background="Transparent">
                                <Track x:Name="PART_Track"
                                       Focusable="False"
                                       IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.LineLeftCommand"
                                                      CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                      Focusable="False"
                                                      IsTabStop="False"
                                                      Opacity="0"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollBarThumb}"
                                               Margin="1"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.LineRightCommand"
                                                      CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                      Focusable="False"
                                                      IsTabStop="False"
                                                      Opacity="0"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 5. CONTAINERS -->
    <Style x:Key="CardStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="{StaticResource CardPadding}"/>
        <Setter Property="Effect" Value="{StaticResource ElevationShadow1}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style TargetType="{x:Type GroupBox}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="{StaticResource GroupBoxPadding}"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusLarge}"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Margin="12,-10,12,6"
                                    Padding="8,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="{StaticResource BackgroundColor}"
                                    CornerRadius="{StaticResource RadiusSmall}">
                                <ContentPresenter ContentSource="Header"
                                                  TextElement.FontWeight="{StaticResource FontWeightSemiBold}"
                                                  TextElement.Foreground="{StaticResource TextPrimaryColor}"
                                                  TextElement.FontSize="15"/>
                            </Border>
                            <ContentPresenter Grid.Row="1"
                                              Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 6. TYPOGRAPHY -->
    <Style x:Key="PageTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource FontSizePageTitle}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSection}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
    </Style>

    <Style x:Key="HeaderStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeHeader}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
    </Style>

    <Style x:Key="CardNumberStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource FontSizePageTitle}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
    </Style>

    <Style x:Key="LabelStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeLabel}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightMedium}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryColor}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style x:Key="CaptionStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
        <Setter Property="Foreground" Value="{StaticResource TextMutedColor}"/>
    </Style>

    <!-- 7. TEXT INPUTS -->
    <Style TargetType="{x:Type TextBox}">
        <Setter Property="Height" Value="{StaticResource InputHeight}"/>
        <Setter Property="Padding" Value="{StaticResource InputPadding}"/>
        <Setter Property="BorderBrush" Value="{StaticResource InputBorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="{StaticResource InputFontSize}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{StaticResource InputBackgroundColor}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
        <Setter Property="CaretBrush" Value="{StaticResource PrimaryColor}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusMedium}"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border"
                                    Property="BorderBrush"
                                    Value="{StaticResource BorderStrongColor}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Border"
                                    Property="BorderBrush"
                                    Value="{StaticResource FocusBorderColor}"/>
                            <Setter TargetName="Border"
                                    Property="BorderThickness"
                                    Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border"
                                    Property="Background"
                                    Value="{StaticResource SurfaceHoverColor}"/>
                            <Setter TargetName="Border"
                                    Property="BorderBrush"
                                    Value="{StaticResource BorderColor}"/>
                            <Setter Property="Foreground"
                                    Value="{StaticResource TextDisabledColor}"/>
                            <Setter Property="CaretBrush"
                                    Value="{StaticResource TextDisabledColor}"/>
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Border"
                                    Property="BorderBrush"
                                    Value="{StaticResource ErrorColor}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type PasswordBox}">
        <Setter Property="Height" Value="{StaticResource InputHeight}"/>
        <Setter Property="Padding" Value="{StaticResource InputPadding}"/>
        <Setter Property="BorderBrush" Value="{StaticResource InputBorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="{StaticResource InputFontSize}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{StaticResource InputBackgroundColor}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
        <Setter Property="CaretBrush" Value="{StaticResource PrimaryColor}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type PasswordBox}">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusMedium}"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border"
                                    Property="BorderBrush"
                                    Value="{StaticResource BorderStrongColor}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Border"
                                    Property="BorderBrush"
                                    Value="{StaticResource FocusBorderColor}"/>
                            <Setter TargetName="Border"
                                    Property="BorderThickness"
                                    Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border"
                                    Property="Background"
                                    Value="{StaticResource SurfaceHoverColor}"/>
                            <Setter TargetName="Border"
                                    Property="BorderBrush"
                                    Value="{StaticResource BorderColor}"/>
                            <Setter Property="Foreground"
                                    Value="{StaticResource TextDisabledColor}"/>
                            <Setter Property="CaretBrush"
                                    Value="{StaticResource TextDisabledColor}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 8. CHECKBOX -->
    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <StackPanel Orientation="Horizontal"
                                Margin="4">
                        <Grid Width="24"
                              Height="24"
                              Margin="0,0,10,0">
                            <Border x:Name="FocusRing"
                                    Width="24"
                                    Height="24"
                                    BorderBrush="{StaticResource FocusBorderColor}"
                                    BorderThickness="2"
                                    CornerRadius="{StaticResource RadiusFocusRing}"
                                    Visibility="Collapsed"/>
                            <Border x:Name="CheckBorder"
                                    Width="20"
                                    Height="20"
                                    Background="{StaticResource InputBackgroundColor}"
                                    BorderBrush="{StaticResource InputBorderColor}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusSmall}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Path x:Name="CheckMark"
                                      Data="M 0 5 L 5 10 L 12 0"
                                      Stroke="White"
                                      StrokeThickness="2"
                                      Stretch="Fill"
                                      Width="14"
                                      Height="14"
                                      Visibility="Collapsed"/>
                            </Border>
                        </Grid>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CheckBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource BorderStrongColor}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FocusRing"
                                    Property="Visibility"
                                    Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark"
                                    Property="Visibility"
                                    Value="Visible"/>
                            <Setter TargetName="CheckBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource PrimaryColor}"/>
                            <Setter TargetName="CheckBorder"
                                    Property="Background"
                                    Value="{StaticResource PrimaryColor}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="CheckBorder"
                                    Property="Background"
                                    Value="{StaticResource SurfaceHoverColor}"/>
                            <Setter TargetName="CheckBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource BorderColor}"/>
                            <Setter Property="Foreground"
                                    Value="{StaticResource TextDisabledColor}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="False"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="CheckMark"
                                    Property="Stroke"
                                    Value="{StaticResource TextDisabledColor}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 9. RADIO BUTTON -->
    <Style TargetType="{x:Type RadioButton}">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <StackPanel Orientation="Horizontal"
                                Margin="4">
                        <Grid Width="24"
                              Height="24"
                              Margin="0,0,10,0">
                            <Border x:Name="FocusRing"
                                    Width="24"
                                    Height="24"
                                    BorderBrush="{StaticResource FocusBorderColor}"
                                    BorderThickness="2"
                                    CornerRadius="12"
                                    Visibility="Collapsed"/>
                            <Border x:Name="RadioBorder"
                                    Width="20"
                                    Height="20"
                                    Background="{StaticResource InputBackgroundColor}"
                                    BorderBrush="{StaticResource InputBorderColor}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Ellipse x:Name="RadioMark"
                                         Width="10"
                                         Height="10"
                                         Fill="{StaticResource PrimaryColor}"
                                         Visibility="Collapsed"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RadioBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource BorderStrongColor}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FocusRing"
                                    Property="Visibility"
                                    Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="RadioMark"
                                    Property="Visibility"
                                    Value="Visible"/>
                            <Setter TargetName="RadioBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource PrimaryColor}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="RadioBorder"
                                    Property="Background"
                                    Value="{StaticResource SurfaceHoverColor}"/>
                            <Setter TargetName="RadioBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource BorderColor}"/>
                            <Setter Property="Foreground"
                                    Value="{StaticResource TextDisabledColor}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 10. COMBOBOX -->
    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="Height" Value="{StaticResource InputHeight}"/>
        <Setter Property="Background" Value="{StaticResource InputBackgroundColor}"/>
        <Setter Property="BorderBrush" Value="{StaticResource InputBorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
        <Setter Property="FontSize" Value="{StaticResource InputFontSize}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusMedium}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="SelectionPresenter"
                                              Grid.Column="0"
                                              Margin="{StaticResource InputPadding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              IsHitTestVisible="False"/>
                            <TextBox x:Name="PART_EditableTextBox"
                                     Grid.Column="0"
                                     Margin="{StaticResource InputPadding}"
                                     VerticalContentAlignment="Center"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{TemplateBinding Foreground}"
                                     FontSize="{TemplateBinding FontSize}"
                                     Visibility="Collapsed"/>
                            <ToggleButton x:Name="DropDownButton"
                                          Grid.Column="1"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="Transparent"
                                          BorderThickness="0">
                                <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                      Fill="{StaticResource TextMutedColor}"
                                      Width="8"
                                      Height="6"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </ToggleButton>
                        </Grid>
                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               PopupAnimation="Fade"
                               StaysOpen="False"
                               Focusable="False">
                            <Border Background="{StaticResource SurfaceColor}"
                                    BorderBrush="{StaticResource BorderColor}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusLarge}"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="260"
                                    Padding="4"
                                    Effect="{StaticResource ElevationShadow2}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="SelectionPresenter"
                                    Property="Visibility"
                                    Value="Collapsed"/>
                            <Setter TargetName="PART_EditableTextBox"
                                    Property="Visibility"
                                    Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border"
                                    Property="BorderBrush"
                                    Value="{StaticResource BorderStrongColor}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Border"
                                    Property="BorderBrush"
                                    Value="{StaticResource FocusBorderColor}"/>
                            <Setter TargetName="Border"
                                    Property="BorderThickness"
                                    Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border"
                                    Property="Background"
                                    Value="{StaticResource SurfaceHoverColor}"/>
                            <Setter TargetName="Border"
                                    Property="BorderBrush"
                                    Value="{StaticResource BorderColor}"/>
                            <Setter Property="Foreground"
                                    Value="{StaticResource TextDisabledColor}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Resources>
