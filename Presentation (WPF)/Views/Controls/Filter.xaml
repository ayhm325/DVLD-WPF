<UserControl x:Class="Presentation.Views.Controls.Filter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignWidth="900"
             d:DesignHeight="82"
             HorizontalContentAlignment="Stretch"
             Background="Transparent"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <UserControl.Resources>

        <Style x:Key="FilterLabelStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize"
                    Value="{StaticResource FontSizeCaption}"/>
            <Setter Property="FontWeight"
                    Value="{StaticResource FontWeightSemiBold}"/>
            <Setter Property="Foreground"
                    Value="{StaticResource SecondaryTextColor}"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
        </Style>

        <Style x:Key="FilterTitleStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize"
                    Value="{StaticResource FontSizeBody}"/>
            <Setter Property="FontWeight"
                    Value="{StaticResource FontWeightSemiBold}"/>
            <Setter Property="Foreground"
                    Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
        </Style>

        <Style x:Key="AddPersonButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Height"
                    Value="40"/>
            <Setter Property="MinWidth"
                    Value="145"/>
            <Setter Property="Padding"
                    Value="16,0"/>
        </Style>

        <Style x:Key="SearchButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Height"
                    Value="40"/>
            <Setter Property="MinWidth"
                    Value="105"/>
            <Setter Property="Padding"
                    Value="14,0"/>
        </Style>

    </UserControl.Resources>

    <Border Style="{StaticResource CardStyle}"
            Padding="18,14"
            Margin="0,5"
            HorizontalAlignment="Stretch">

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- FILTER ICON -->

            <Border Grid.Column="0"
                    Width="40"
                    Height="40"
                    CornerRadius="{StaticResource RadiusMedium}"
                    Background="{StaticResource PrimaryLightColor}"
                    VerticalAlignment="Center"
                    Margin="0,0,14,0">

                <materialDesign:PackIcon Kind="FilterVariant"
                                         Width="21"
                                         Height="21"
                                         Foreground="{StaticResource PrimaryColor}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>

            </Border>

            <!-- DIVIDER -->

            <Border Grid.Column="1"
                    Width="1"
                    Height="30"
                    Background="{StaticResource BorderColor}"
                    VerticalAlignment="Center"
                    Margin="0,0,18,0"/>

            <!-- TITLE -->

            <StackPanel Grid.Column="2"
                        VerticalAlignment="Center"
                        Margin="0,0,20,0">

                <TextBlock Text="Filter"
                           Style="{StaticResource FilterTitleStyle}"/>

                <TextBlock Text="Find person"
                           Style="{StaticResource FilterLabelStyle}"
                           Margin="0,2,0,0"/>

            </StackPanel>

            <!-- FIND BY -->

            <StackPanel Grid.Column="3"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0">

                <TextBlock Text="Find By"
                           Style="{StaticResource FilterLabelStyle}"
                           Margin="0,0,10,0"/>

                <ComboBox Width="145"
                          Height="40"
                          SelectedIndex="{Binding SelectedFilterIndex}"
                          VerticalAlignment="Center">

                    <ComboBoxItem Content="Person ID"/>
                    <ComboBoxItem Content="National No"/>

                </ComboBox>

            </StackPanel>

            <!-- SEARCH TEXT -->

            <TextBox Grid.Column="4"
                     Height="40"
                     MinWidth="150"
                     VerticalAlignment="Center"
                     Margin="0,0,12,0"
                     Text="{Binding FilterText,
                                    UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Enter a person ID or national number"/>

            <!-- SEARCH -->

            <Button Grid.Column="5"
                    Style="{StaticResource SearchButtonStyle}"
                    Command="{Binding SearchCommand}"
                    VerticalAlignment="Center"
                    Margin="0,0,10,0">

                <StackPanel Orientation="Horizontal">

                    <materialDesign:PackIcon Kind="Magnify"
                                             Width="18"
                                             Height="18"
                                             Margin="0,0,7,0"
                                             VerticalAlignment="Center"/>

                    <TextBlock Text="Search"
                               VerticalAlignment="Center"/>

                </StackPanel>

            </Button>

            <!-- ADD PERSON -->

            <Button Grid.Column="6"
                    Style="{StaticResource AddPersonButtonStyle}"
                    Command="{Binding AddPersonCommand}"
                    VerticalAlignment="Center">

                <StackPanel Orientation="Horizontal">

                    <materialDesign:PackIcon Kind="AccountPlusOutline"
                                             Width="19"
                                             Height="19"
                                             Margin="0,0,8,0"
                                             VerticalAlignment="Center"/>

                    <TextBlock Text="Add Person"
                               VerticalAlignment="Center"/>

                </StackPanel>

            </Button>

        </Grid>

    </Border>

</UserControl>