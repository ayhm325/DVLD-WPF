<UserControl x:Class="Presentation.Views.Controls.UserCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="92"
             d:DesignWidth="520"
             Background="Transparent"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <Border x:Name="CardBorder"
            Margin="5"
            Padding="0"
            Background="{StaticResource SurfaceColor}"
            BorderBrush="{StaticResource BorderColor}"
            BorderThickness="1"
            CornerRadius="16">

        <Border.Effect>
            <DropShadowEffect Color="#000000"
                              Direction="270"
                              ShadowDepth="0"
                              BlurRadius="14"
                              Opacity="0.06"/>
        </Border.Effect>

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="72"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="16"/>
            </Grid.ColumnDefinitions>

            <!-- ACCENT -->
            <Border Grid.Column="0"
                    CornerRadius="16,0,0,16"
                    Background="{StaticResource PrimaryColor}"/>

            <!-- AVATAR -->
            <Grid Grid.Column="1"
                  Width="52"
                  Height="52"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">

                <Ellipse Fill="{StaticResource PrimaryLightColor}"/>

                <materialDesign:PackIcon Kind="AccountCircle"
                                         Width="30"
                                         Height="30"
                                         Foreground="{StaticResource PrimaryColor}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>

            </Grid>

            <!-- USER INFORMATION -->
            <StackPanel Grid.Column="2"
                        VerticalAlignment="Center"
                        Margin="8,0,15,0">

                <TextBlock Text="SYSTEM USER"
                           FontSize="9"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextMutedColor}"/>

                <TextBlock Text="{Binding UserName}"
                           Margin="0,4,0,0"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryColor}"
                           TextTrimming="CharacterEllipsis"/>

                <StackPanel Orientation="Horizontal"
                            Margin="0,5,0,0">

                    <materialDesign:PackIcon Kind="ShieldAccountOutline"
                                             Width="13"
                                             Height="13"
                                             Foreground="{StaticResource TextMutedColor}"
                                             VerticalAlignment="Center"/>

                    <TextBlock Text="Authorized account"
                               Margin="5,0,0,0"
                               FontSize="10"
                               Foreground="{StaticResource TextMutedColor}"/>

                </StackPanel>

            </StackPanel>

            <!-- STATUS -->
            <Border Grid.Column="3"
                    Padding="12,7"
                    CornerRadius="10"
                    VerticalAlignment="Center"
                    Background="{StaticResource SuccessLightColor}">

                <StackPanel Orientation="Horizontal">

                    <Ellipse Width="7"
                             Height="7"
                             Fill="{StaticResource SuccessColor}"
                             VerticalAlignment="Center"
                             Margin="0,0,7,0"/>

                    <TextBlock Text="{Binding IsActive}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SuccessColor}"
                               VerticalAlignment="Center"/>

                </StackPanel>

            </Border>

            <!-- RIGHT SPACE -->
            <Border Grid.Column="4"/>

        </Grid>

    </Border>
</UserControl>