<UserControl x:Class="Presentation.Views.Controls.UserCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="92"
             d:DesignWidth="520"
             Background="Transparent"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <Border Style="{StaticResource CardStyle}"
            Margin="5"
            Padding="0"
            Background="{StaticResource SurfaceColor}"
            HorizontalAlignment="Stretch">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="72"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="16"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    CornerRadius="16,0,0,16"
                    Background="{StaticResource PrimaryColor}"/>

            <Grid Grid.Column="1"
                  Width="52"
                  Height="52"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
                <Ellipse Fill="{StaticResource PrimaryLightColor}"/>
                <materialDesign:PackIcon Kind="AccountCircle"
                                         Width="30"
                                         Height="30"
                                         Foreground="{StaticResource PrimaryColor}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
            </Grid>

            <StackPanel Grid.Column="2"
                        VerticalAlignment="Center"
                        Margin="8,0,15,0">
                <TextBlock Text="SYSTEM USER"
                           FontSize="{StaticResource FontSizeCaption}"
                           FontWeight="{StaticResource FontWeightSemiBold}"
                           Foreground="{StaticResource TextMutedColor}"/>
                <TextBlock Text="{Binding UserName}"
                           Margin="0,4,0,0"
                           FontSize="15"
                           FontWeight="{StaticResource FontWeightSemiBold}"
                           Foreground="{StaticResource TextPrimaryColor}"
                           TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <materialDesign:PackIcon Kind="ShieldAccountOutline"
                                             Width="13" Height="13"
                                             Foreground="{StaticResource TextMutedColor}"
                                             VerticalAlignment="Center"/>
                    <TextBlock Text="Authorized account"
                               Margin="5,0,0,0"
                               FontSize="10"
                               Foreground="{StaticResource TextMutedColor}"/>
                </StackPanel>
            </StackPanel>

            <Border Grid.Column="3"
                    Padding="12,7"
                    CornerRadius="{StaticResource RadiusSmall}"
                    VerticalAlignment="Center"
                    Background="{StaticResource SuccessLightColor}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7"
                             Fill="{StaticResource SuccessColor}"
                             VerticalAlignment="Center"
                             Margin="0,0,7,0"/>
                    <TextBlock Text="{Binding IsActive}"
                               FontSize="10"
                               FontWeight="{StaticResource FontWeightSemiBold}"
                               Foreground="{StaticResource SuccessColor}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4"/>
        </Grid>
    </Border>
</UserControl>