<UserControl x:Class="Presentation.Views.Controls.PageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Focusable="False">
    <Border Background="{StaticResource SurfaceColor}"
            BorderBrush="{StaticResource BorderColor}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusXLarge}"
            Margin="0,0,0,18"
            Effect="{StaticResource CardShadow}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PrimaryColor}"
                    CornerRadius="{StaticResource RadiusLeftLarge}"/>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,20,20,20">
                <TextBlock Text="{Binding Eyebrow, ElementName=Root}"
                           Foreground="{StaticResource PrimaryColor}"
                           FontSize="{StaticResource FontSizeCaption}"
                           FontWeight="{StaticResource FontWeightBold}"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="{Binding Heading, ElementName=Root}"
                               Style="{StaticResource PageTitleStyle}"/>
                    <Border Background="{StaticResource PrimaryLightColor}"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusPill}"
                            Padding="10,4" Margin="12,0,0,0"
                            VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Metric, ElementName=Root}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Metric, ElementName=Root}"
                                   Foreground="{StaticResource PrimaryColor}"
                                   FontWeight="{StaticResource FontWeightSemiBold}"
                                   FontSize="{StaticResource FontSizeCaption}"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding Description, ElementName=Root}"
                           Style="{StaticResource CaptionStyle}"
                           TextWrapping="Wrap" MaxWidth="760" Margin="0,6,0,0"/>
            </StackPanel>

            <Border Grid.Column="2" Background="{StaticResource SurfaceSecondaryColor}"
                    BorderBrush="{StaticResource BorderColor}" BorderThickness="1,0,0,0"
                    CornerRadius="{StaticResource RadiusRightLarge}"
                    Padding="20,14" Margin="0,1,1,1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActionContent, ElementName=Root}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ContentControl Content="{Binding ActionContent, ElementName=Root}"
                                VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
