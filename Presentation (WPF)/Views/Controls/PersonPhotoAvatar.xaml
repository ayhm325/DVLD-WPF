<UserControl x:Class="Presentation.Views.Controls.PersonPhotoAvatar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Width="38" Height="38"
             ClipToBounds="True">
    <Border CornerRadius="19"
            Background="{StaticResource SurfaceSecondaryColor}"
            BorderBrush="{StaticResource BorderColor}"
            BorderThickness="1"
            ClipToBounds="True">
        <Image Source="{Binding PhotoSource, ElementName=Root}"
               Stretch="UniformToFill"/>
    </Border>
</UserControl>
