<UserControl x:Class="Presentation.Views.Controls.ApplicationInfo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             x:Name="Root"
             HorizontalContentAlignment="Stretch"
             d:DesignHeight="250"
             d:DesignWidth="800"
             Background="Transparent"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource LabelStyle}">
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
            <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryColor}"/>
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource CardStyle}"
            Padding="{StaticResource CardPadding}"
            Margin="10"
            HorizontalAlignment="Stretch">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="74"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceSecondaryColor}"
                    CornerRadius="{StaticResource RadiusMedium}"
                    Padding="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42"
                            CornerRadius="{StaticResource RadiusMedium}"
                            Background="{StaticResource PrimaryLightColor}"
                            Margin="0,0,14,0">
                        <materialDesign:PackIcon Kind="FileDocumentOutline"
                                                 Width="23" Height="23"
                                                 Foreground="{StaticResource PrimaryColor}"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Application Info"
                                   FontSize="18"
                                   FontWeight="{StaticResource FontWeightSemiBold}"
                                   Foreground="{StaticResource TextPrimaryColor}"/>
                        <TextBlock Text="International license application details"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{StaticResource TextSecondaryColor}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Background="{StaticResource BorderColor}"/>

            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,15">
                    <TextBlock Text="APPLICATION ID" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding Application.ApplicationId, ElementName=Root}" Style="{StaticResource FieldValue}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,15">
                    <TextBlock Text="INTERNATIONAL LICENSE ID" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding Application.InternationalLicenseId, ElementName=Root}" Style="{StaticResource FieldValue}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,12,15">
                    <TextBlock Text="DRIVER ID" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding Application.DriverId, ElementName=Root}" Style="{StaticResource FieldValue}"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,0,15">
                    <TextBlock Text="LOCAL LICENSE ID" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding Application.IssuedUsingLocalLicenseId, ElementName=Root}" Style="{StaticResource FieldValue}"/>
                </StackPanel>

                <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,5,12,0">
                    <TextBlock Text="ISSUE DATE" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding Application.IssueDate, ElementName=Root, StringFormat='{}{0:dd/MMM/yyyy}'}" Style="{StaticResource FieldValue}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Grid.Row="1" Margin="0,5,12,0">
                    <TextBlock Text="EXPIRATION DATE" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding Application.ExpirationDate, ElementName=Root, StringFormat='{}{0:dd/MMM/yyyy}'}" Style="{StaticResource FieldValue}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Grid.Row="1" Margin="0,5,12,0">
                    <TextBlock Text="FEES" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding Application.Fees, ElementName=Root, StringFormat='{}{0:F2}'}" Style="{StaticResource FieldValue}"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Grid.Row="1" Margin="0,5,0,0">
                    <TextBlock Text="CREATED BY" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding Application.CreatedByUserName, ElementName=Root}"
                               Style="{StaticResource FieldValue}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>