<Window x:Class="Presentation.Views.Windows.LocalApplicationDetailsWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Presentation.Views.Controls"
        Title="Local Driving License Application Details"
        Height="800"
        Width="920"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Border Background="{StaticResource BackgroundColor}"
            BorderBrush="{StaticResource BorderColor}"
            BorderThickness="1"
            CornerRadius="16"
            Margin="15"
            Effect="{StaticResource ElevationShadow3}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceColor}"
                    CornerRadius="16,16,0,0"
                    Padding="25,18"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Width="40"
                                Height="40"
                                CornerRadius="{StaticResource RadiusMedium}"
                                Background="{StaticResource PrimaryLightColor}"
                                BorderBrush="{StaticResource BorderColor}"
                                BorderThickness="1"
                                Margin="0,0,14,0">
                            <Path Data="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"
                                  Stroke="{StaticResource PrimaryColor}"
                                  StrokeThickness="1.6"
                                  Fill="Transparent"
                                  Stretch="Uniform"
                                  Height="20"
                                  Width="20"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Local Driving License Application Details"
                                       Style="{StaticResource HeaderStyle}"/>
                            <TextBlock Text="Review application and license information"
                                       Style="{StaticResource CaptionStyle}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="✕"
                            Width="34"
                            Height="34"
                            Background="Transparent"
                            Foreground="{StaticResource TextMutedColor}"
                            BorderThickness="0"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Click="CloseButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border x:Name="CloseBorder"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="{StaticResource RadiusMedium}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CloseBorder"
                                                Property="Background"
                                                Value="{StaticResource DangerLightColor}"/>
                                        <Setter Property="Foreground"
                                                Value="{StaticResource DangerColor}"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Opacity" Value="0.75"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="20,15,20,20">
                <StackPanel>
                    <controls:DrivingLicenseApplicationInfo
                        x:Name="DrivingLicenseApplicationInfoControl"
                        DrivingLicenseApplicationId="{Binding LdlAppInfo.LocalDrivingLicenseApplicationId}"
                        LicenseId="{Binding LicenseInfo.LicenseId}"
                        PassedTests="{Binding LdlAppInfo.PassedTest}"
                        TotalTests="3"
                        LicenseClassName="{Binding LdlAppInfo.LicenseClassName}"
                        Margin="0,0,0,15"/>

                    <controls:ApplicationBasicInfo
                        x:Name="ApplicationBasicInfoControl"
                        Application="{Binding ApplicationInfo}"/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="{StaticResource SurfaceColor}"
                    Padding="20,15,25,20"
                    CornerRadius="0,0,16,16"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,1,0,0">
                <Button Content="Close"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="120"
                        HorizontalAlignment="Right"
                        Click="CloseButton_Click"/>
            </Border>
        </Grid>
    </Border>
</Window>