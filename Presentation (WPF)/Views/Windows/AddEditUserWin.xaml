<Window x:Class="Presentation.Views.Windows.AddEditUserWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Presentation.Views.Controls"
        xmlns:helpers="clr-namespace:Presentation.Helpers"
        Title="Add / Edit User"
        Height="780" Width="980"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        FontFamily="{StaticResource AppFontFamily}">
    <Border Margin="10"
            Background="{StaticResource SurfaceColor}"
            BorderBrush="{StaticResource BorderColor}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusXLarge}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.18"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="82"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="74"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown"
                    Background="{StaticResource PrimarySoftColor}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="16,16,0,0"
                    Padding="26,16">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="48" Height="48" CornerRadius="14"
                                Background="{StaticResource PrimaryColor}">
                            <Path Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"
                                  Fill="White" Width="22" Height="22" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="User Account" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextColor}"/>
                            <TextBlock Text="Create or update a system user and its linked person"
                                       Margin="0,4,0,0" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryColor}"/>
                        </StackPanel>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                            Style="{StaticResource GhostButtonStyle}"
                            Click="CloseButton_Click" ToolTip="Close">
                        <TextBlock Text="×" FontSize="24"/>
                    </Button>
                </Grid>
            </Border>

            <TabControl Grid.Row="1" x:Name="MainTabControl"
                        Margin="26,18,26,12"
                        Background="Transparent" BorderThickness="0"
                        SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
                <TabItem Header="1  Person">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,18,4,8">
                            <Border Style="{StaticResource CardStyle}" Padding="22">
                                <StackPanel>
                                    <TextBlock Text="Find the person linked to this account"
                                               FontSize="17" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextColor}"/>
                                    <TextBlock Text="Search by Person ID or National Number before continuing."
                                               Margin="0,5,0,18" FontSize="12"
                                               Foreground="{StaticResource TextMutedColor}"/>
                                    <controls:Filter Margin="0,0,0,18"/>
                                    <controls:InformationPerson Person="{Binding Person}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="2  Login" IsEnabled="{Binding CanGoToNextTab}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,18,4,8">
                            <Border Style="{StaticResource CardStyle}" Padding="24">
                                <StackPanel>
                                    <TextBlock Text="Login configuration" FontSize="17"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextColor}"/>
                                    <TextBlock Text="Set the username, password and account status."
                                               Margin="0,5,0,20" FontSize="12"
                                               Foreground="{StaticResource TextMutedColor}"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="User ID"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding UserIdDisplay, TargetNullValue=—}"
                                                   Style="{StaticResource FieldValueStyle}"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Username"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Width="340"
                                                 HorizontalAlignment="Left"
                                                 Text="{Binding UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                        <TextBlock Grid.Row="2" Grid.Column="1"
                                                   Text="{Binding UserNameValidationMessage}"
                                                   Foreground="{Binding UserNameValidationColor}"
                                                   FontSize="11" Margin="0,3,0,12"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Password"
                                                   Style="{StaticResource FieldLabelStyle}"
                                                   Visibility="{Binding PasswordVisibility}"/>
                                        <Grid Grid.Row="3" Grid.Column="1" Width="340"
                                              HorizontalAlignment="Left"
                                              Visibility="{Binding PasswordVisibility}">
                                            <PasswordBox helpers:PasswordBoxHelper.Attach="True"
                                                         helpers:PasswordBoxHelper.Password="{Binding Password, Mode=TwoWay}"
                                                         Padding="10,0,44,0">
                                                <PasswordBox.Style>
                                                    <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </PasswordBox.Style>
                                            </PasswordBox>
                                            <TextBox Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="10,0,44,0">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPasswordVisible}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                            <Button HorizontalAlignment="Right"
                                                    Width="40" Height="40"
                                                    Style="{StaticResource GhostButtonStyle}"
                                                    Command="{Binding TogglePasswordVisibilityCommand}"
                                                    ToolTip="Show or hide password">
                                                <Path Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                      Width="18" Height="18" Stretch="Uniform">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Data" Value="M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9Z"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                                                                    <Setter Property="Data" Value="M11.83,9L15,12.16C15,12.11 15,12.05 15,12A3,3 0 0,0 12,9C11.95,9 11.89,9 11.83,9M7.53,9.8L9.08,11.35C9.03,11.56 9,11.77 9,12A3,3 0 0,0 12,15C12.22,15 12.44,14.97 12.65,14.92L14.2,16.47C13.53,16.8 12.79,17 12,17A5,5 0 0,1 7,12C7,11.21 7.2,10.47 7.53,9.8M2,4.27L4.28,6.55L4.73,7C3.08,8.3 1.78,10 1,12C2.73,16.39 7,19.5 12,19.5C13.55,19.5 15.03,19.2 16.38,18.66L16.81,19.08L19.73,22L21,20.73L3.27,3M12,7A5,5 0 0,1 17,12C17,12.64 16.87,13.26 16.64,13.82L19.57,16.75C21.07,15.5 22.27,13.86 23,12C21.27,7.61 17,4.5 12,4.5C10.6,4.5 9.27,4.75 8.07,5.24L10.18,7.35C10.74,7.13 11.35,7 12,7Z"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </Button>
                                        </Grid>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Confirm Password"
                                                   Style="{StaticResource FieldLabelStyle}"
                                                   Visibility="{Binding ConfirmPasswordVisibility}"/>
                                        <Grid Grid.Row="4" Grid.Column="1" Width="340"
                                              HorizontalAlignment="Left"
                                              Visibility="{Binding ConfirmPasswordVisibility}">
                                            <PasswordBox helpers:PasswordBoxHelper.Attach="True"
                                                         helpers:PasswordBoxHelper.Password="{Binding ConfirmPassword, Mode=TwoWay}"
                                                         Padding="10,0,44,0">
                                                <PasswordBox.Style>
                                                    <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConfirmPasswordVisible}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </PasswordBox.Style>
                                            </PasswordBox>
                                            <TextBox Text="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="10,0,44,0">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConfirmPasswordVisible}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                            <Button HorizontalAlignment="Right"
                                                    Width="40" Height="40"
                                                    Style="{StaticResource GhostButtonStyle}"
                                                    Command="{Binding ToggleConfirmPasswordVisibilityCommand}"
                                                    ToolTip="Show or hide password">
                                                <Path Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                      Width="18" Height="18" Stretch="Uniform">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Data" Value="M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9Z"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsConfirmPasswordVisible}" Value="True">
                                                                    <Setter Property="Data" Value="M11.83,9L15,12.16C15,12.11 15,12.05 15,12A3,3 0 0,0 12,9C11.95,9 11.89,9 11.83,9M7.53,9.8L9.08,11.35C9.03,11.56 9,11.77 9,12A3,3 0 0,0 12,15C12.22,15 12.44,14.97 12.65,14.92L14.2,16.47C13.53,16.8 12.79,17 12,17A5,5 0 0,1 7,12C7,11.21 7.2,10.47 7.53,9.8M2,4.27L4.28,6.55L4.73,7C3.08,8.3 1.78,10 1,12C2.73,16.39 7,19.5 12,19.5C13.55,19.5 15.03,19.2 16.38,18.66L16.81,19.08L19.73,22L21,20.73L3.27,3M12,7A5,5 0 0,1 17,12C17,12.64 16.87,13.26 16.64,13.82L19.57,16.75C21.07,15.5 22.27,13.86 23,12C21.27,7.61 17,4.5 12,4.5C10.6,4.5 9.27,4.75 8.07,5.24L10.18,7.35C10.74,7.13 11.35,7 12,7Z"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </Button>
                                        </Grid>

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Account status"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <CheckBox Grid.Row="5" Grid.Column="1" Content="Active account"
                                                  IsChecked="{Binding IsActive, Mode=TwoWay}"
                                                  VerticalAlignment="Center" Margin="0,10,0,10"/>

                                        <Border Grid.Row="6" Grid.ColumnSpan="2"
                                                Background="{StaticResource PrimarySoftColor}"
                                                BorderBrush="{StaticResource BorderColor}"
                                                BorderThickness="1" CornerRadius="10"
                                                Padding="14" Margin="0,16,0,0">
                                            <TextBlock Text="Username and account rules are validated by the application and API."
                                                       TextWrapping="Wrap" FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryColor}"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <Border Grid.Row="2" Background="{StaticResource SurfaceSecondaryColor}"
                    BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,16,16" Padding="26,12">
                <Grid>
                    <TextBlock VerticalAlignment="Center"
                               Text="{Binding CurrentFullName}"
                               Foreground="{StaticResource TextMutedColor}" FontSize="12"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CancelCommand}" Margin="0,0,10,0"/>
                        <Button Content="Save User" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding SaveUserCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
