<Window x:Class="Presentation.Views.Windows.DriverLicenseInfoWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Driver License Information"
        Height="760" Width="920"
        MinHeight="680" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Border Margin="14"
            Background="{StaticResource SurfaceColor}"
            BorderBrush="{StaticResource BorderColor}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusLarge}"
            Effect="{StaticResource ElevationShadow3}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="76"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="72"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource PrimarySoftColor}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="16,16,0,0"
                    Padding="24,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="46" Height="46"
                            CornerRadius="{StaticResource RadiusMedium}"
                            Background="{StaticResource PrimaryColor}"
                            Margin="0,0,14,0">
                        <Path Data="M3,10H21M6,15H8M12,15H14M5,19H19A2,2 0,0 0,21,17V7A2,2 0,0 0,19,5H5A2,2 0,0 0,3,7V17A2,2 0,0 0,5,19Z"
                              Stroke="White" StrokeThickness="1.6"
                              Fill="Transparent" Stretch="Uniform"
                              Width="23" Height="23"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Driver License Details"
                                   FontSize="{StaticResource FontSizeHeader}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryColor}"/>
                        <TextBlock Text="Complete license and driver information"
                                   Margin="0,3,0,0"
                                   FontSize="13"
                                   Foreground="{StaticResource TextMutedColor}"/>
                    </StackPanel>

                    <Border Grid.Column="2"
                            Background="{StaticResource PrimaryLightColor}"
                            CornerRadius="{StaticResource RadiusPill}"
                            Padding="12,6"
                            VerticalAlignment="Center">
                        <TextBlock Foreground="{StaticResource PrimaryColor}"
                                   FontWeight="SemiBold"
                                   FontSize="12">
                            <Run Text="ID: "/>
                            <Run Text="{Binding LicenseData.LicenseId}"/>
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,22">

                    <Border Background="{StaticResource SurfaceSecondaryColor}"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusLarge}"
                            Padding="18"
                            Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="{Binding LicenseData.FullName}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryColor}"/>
                                <TextBlock Text="{Binding LicenseData.NationalNo}"
                                           Margin="0,4,0,0"
                                           FontSize="13"
                                           Foreground="{StaticResource TextMutedColor}"/>
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Background="{StaticResource SuccessLightColor}"
                                    CornerRadius="{StaticResource RadiusPill}"
                                    Padding="12,6"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8"
                                             Fill="{StaticResource SuccessColor}"
                                             Margin="0,0,7,0"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding LicenseData.IsActive}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource SuccessColor}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{StaticResource SurfaceColor}"
                                BorderBrush="{StaticResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusLarge}"
                                Padding="18"
                                Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="Personal Information"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryColor}"
                                           Margin="0,0,0,14"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="125"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="Full Name" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LicenseData.FullName}"
                                               Foreground="{StaticResource TextPrimaryColor}" Margin="0,0,0,14"/>

                                    <TextBlock Grid.Row="1" Text="National No" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LicenseData.NationalNo}"
                                               Foreground="{StaticResource TextPrimaryColor}" Margin="0,0,0,14"/>

                                    <TextBlock Grid.Row="2" Text="Date Of Birth" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1"
                                               Text="{Binding LicenseData.DateOfBirth, StringFormat='{}{0:dd/MMM/yyyy}'}"
                                               Foreground="{StaticResource TextPrimaryColor}" Margin="0,0,0,14"/>

                                    <TextBlock Grid.Row="3" Text="Gender" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LicenseData.Gender}"
                                               Foreground="{StaticResource TextPrimaryColor}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Background="{StaticResource SurfaceColor}"
                                BorderBrush="{StaticResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusLarge}"
                                Padding="18"
                                Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="License Details"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryColor}"
                                           Margin="0,0,0,14"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="125"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="License Class" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LicenseData.LicenseClass}"
                                               Foreground="{StaticResource TextPrimaryColor}" Margin="0,0,0,14"/>

                                    <TextBlock Grid.Row="1" Text="Issue Date" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                               Text="{Binding LicenseData.IssueDate, StringFormat='{}{0:dd/MMM/yyyy}'}"
                                               Foreground="{StaticResource TextPrimaryColor}" Margin="0,0,0,14"/>

                                    <TextBlock Grid.Row="2" Text="Issue Reason" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LicenseData.IssueReason}"
                                               Foreground="{StaticResource TextPrimaryColor}" Margin="0,0,0,14"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Grid.Row="3" Text="Expiration Date" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1"
                                               Text="{Binding LicenseData.ExpirationDate, StringFormat='{}{0:dd/MMM/yyyy}'}"
                                               Foreground="{StaticResource TextPrimaryColor}" Margin="0,0,0,14"/>

                                    <TextBlock Grid.Row="4" Text="Driver ID" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LicenseData.DriverId}"
                                               Foreground="{StaticResource TextPrimaryColor}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Background="{StaticResource SurfaceSecondaryColor}"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusLarge}"
                            Padding="18">
                        <StackPanel>
                            <TextBlock Text="License Status"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryColor}"
                                       Margin="0,0,0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Active" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Grid.Column="1" Text="{Binding LicenseData.IsActive}"
                                           FontWeight="SemiBold" Foreground="{StaticResource SuccessColor}"/>

                                <TextBlock Grid.Column="2" Text="Detained" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Grid.Column="3" Text="{Binding LicenseData.IsDetained}"
                                           FontWeight="SemiBold" Foreground="{StaticResource DangerColor}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PrimarySoftColor}"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusLarge}"
                            Padding="18"
                            Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="Notes"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryColor}"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding LicenseData.Notes}"
                                       Foreground="{StaticResource TextSecondaryColor}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="{StaticResource SurfaceSecondaryColor}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,16,16"
                    Padding="24,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Close"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>