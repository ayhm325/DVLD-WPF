<Window x:Class="Presentation.Views.Windows.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:Presentation.Helpers"
        Title="Change Password"
        Height="600"
        Width="500"
        MinHeight="560"
        MinWidth="460"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        FontFamily="{StaticResource DefaultFontFamily}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="WindowCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource RadiusSmall}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBorder" Property="Background" Value="{StaticResource DangerLightColor}"/>
                                <Setter Property="Foreground" Value="{StaticResource DangerColor}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CloseBorder" Property="Background" Value="{StaticResource DangerColor}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EyeButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="EyeBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource RadiusMedium}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="EyeBorder" Property="Background" Value="{StaticResource PrimaryLightColor}"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="EyeBorder" Property="Background" Value="{StaticResource SurfacePressedColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PasswordFieldLabelStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource LabelStyle}">
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
    </Window.Resources>

    <Border Margin="14"
            Background="{StaticResource SurfaceColor}"
            BorderBrush="{StaticResource BorderColor}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusLarge}"
            Effect="{StaticResource ElevationShadow3}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="88"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="82"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource PrimarySoftColor}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="16,16,0,0"
                    Padding="24,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="48"
                            Height="48"
                            CornerRadius="{StaticResource RadiusMedium}"
                            Background="{StaticResource PrimaryColor}"
                            VerticalAlignment="Center"
                            Margin="0,0,14,0">
                        <Path Data="M12,17A2,2 0,1 0,12 13A2,2 0,0 0,12 17M18,8A2,2 0,0 1,20,10V18A2,2 0,0 1,18,20H6A2,2 0,0 1,4,18V10A2,2 0,0 1,6,8H7V6A5,5 0,0 1,12,1A5,5 0,0 1,17,6V8H18M9,8H15V6A3,3 0,0 0,9,6V8Z"
                              Fill="White"
                              Width="23"
                              Height="23"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Change Password"
                                   FontSize="{StaticResource FontSizeHeader}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryColor}"/>
                        <TextBlock Text="Secure your account with a new password"
                                   Margin="0,4,0,0"
                                   FontSize="13"
                                   Foreground="{StaticResource TextMutedColor}"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Style="{StaticResource WindowCloseButtonStyle}"
                            Click="CloseButton_Click"
                            ToolTip="Close"
                            VerticalAlignment="Center">
                        <TextBlock Text="×"
                                   FontSize="24"
                                   FontWeight="Light"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28,24">

                    <Border Background="{StaticResource SurfaceSecondaryColor}"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusLarge}"
                            Padding="16"
                            Margin="0,0,0,22">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="38"
                                    Height="38"
                                    CornerRadius="{StaticResource RadiusPill}"
                                    Background="{StaticResource PrimaryLightColor}">
                                <Path Data="M12,12A5,5 0,1 0,12 2A5,5 0,0 0,12 12M4,22A8,8 0,0 1,20 22H4Z"
                                      Fill="{StaticResource PrimaryColor}"
                                      Width="19"
                                      Height="19"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UserName}"
                                           FontSize="{StaticResource FontSizeBody}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryColor}"/>
                                <TextBlock Text="{Binding UserId, StringFormat=User ID: {0}}"
                                           Margin="0,2,0,0"
                                           FontSize="13"
                                           Foreground="{StaticResource TextMutedColor}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Update your password"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryColor}"/>
                        <TextBlock Text="Enter your current password, then choose and confirm a new one."
                                   Margin="0,4,0,0"
                                   FontSize="13"
                                   Foreground="{StaticResource TextMutedColor}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBlock Text="Current Password"
                               Style="{StaticResource PasswordFieldLabelStyle}"/>

                    <Grid Margin="0,0,0,18">
                        <PasswordBox helpers:PasswordBoxHelper.Attach="True"
                                     helpers:PasswordBoxHelper.Password="{Binding CurrentPassword, Mode=TwoWay}"
                                     Padding="12,0,48,0">
                            <PasswordBox.Style>
                                <Style TargetType="PasswordBox"
                                       BasedOn="{StaticResource {x:Type PasswordBox}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrentPasswordVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </PasswordBox.Style>
                        </PasswordBox>

                        <TextBox Text="{Binding CurrentPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="12,0,48,0">
                            <TextBox.Style>
                                <Style TargetType="TextBox"
                                       BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrentPasswordVisible}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <Button Style="{StaticResource EyeButtonStyle}"
                                HorizontalAlignment="Right"
                                Command="{Binding ToggleCurrentPasswordCommand}"
                                ToolTip="Show or hide password">
                            <Path Data="M2,12C4.7,7.3 8,5 12,5C16,5 19.3,7.3 22,12C19.3,16.7 16,19 12,19C8,19 4.7,16.7 2,12M12,16A4,4 0,1 0,12 8A4,4 0,0 0,12 16Z"
                                  Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  Width="18"
                                  Height="18"
                                  Stretch="Uniform"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="New Password"
                               Style="{StaticResource PasswordFieldLabelStyle}"/>

                    <Grid Margin="0,0,0,18">
                        <PasswordBox helpers:PasswordBoxHelper.Attach="True"
                                     helpers:PasswordBoxHelper.Password="{Binding NewPassword, Mode=TwoWay}"
                                     Padding="12,0,48,0">
                            <PasswordBox.Style>
                                <Style TargetType="PasswordBox"
                                       BasedOn="{StaticResource {x:Type PasswordBox}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNewPasswordVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </PasswordBox.Style>
                        </PasswordBox>

                        <TextBox Text="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="12,0,48,0">
                            <TextBox.Style>
                                <Style TargetType="TextBox"
                                       BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNewPasswordVisible}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <Button Style="{StaticResource EyeButtonStyle}"
                                HorizontalAlignment="Right"
                                Command="{Binding ToggleNewPasswordCommand}"
                                ToolTip="Show or hide password">
                            <Path Data="M2,12C4.7,7.3 8,5 12,5C16,5 19.3,7.3 22,12C19.3,16.7 16,19 12,19C8,19 4.7,16.7 2,12M12,16A4,4 0,1 0,12 8A4,4 0,0 0,12 16Z"
                                  Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  Width="18"
                                  Height="18"
                                  Stretch="Uniform"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="Confirm New Password"
                               Style="{StaticResource PasswordFieldLabelStyle}"/>

                    <Grid>
                        <PasswordBox helpers:PasswordBoxHelper.Attach="True"
                                     helpers:PasswordBoxHelper.Password="{Binding ConfirmNewPassword, Mode=TwoWay}"
                                     Padding="12,0,48,0">
                            <PasswordBox.Style>
                                <Style TargetType="PasswordBox"
                                       BasedOn="{StaticResource {x:Type PasswordBox}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConfirmNewPasswordVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </PasswordBox.Style>
                        </PasswordBox>

                        <TextBox Text="{Binding ConfirmNewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="12,0,48,0">
                            <TextBox.Style>
                                <Style TargetType="TextBox"
                                       BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConfirmNewPasswordVisible}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <Button Style="{StaticResource EyeButtonStyle}"
                                HorizontalAlignment="Right"
                                Command="{Binding ToggleConfirmPasswordCommand}"
                                ToolTip="Show or hide password">
                            <Path Data="M2,12C4.7,7.3 8,5 12,5C16,5 19.3,7.3 22,12C19.3,16.7 16,19 12,19C8,19 4.7,16.7 2,12M12,16A4,4 0,1 0,12 8A4,4 0,0 0,12 16Z"
                                  Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  Width="18"
                                  Height="18"
                                  Stretch="Uniform"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="{StaticResource SurfaceSecondaryColor}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,16,16"
                    Padding="24,14">
                <Grid>
                    <TextBlock Text="Password must be different from the current password."
                               FontSize="13"
                               Foreground="{StaticResource TextMutedColor}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="240"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Content="Cancel"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="CloseButton_Click"
                                Margin="0,0,10,0"/>
                        <Button Content="Change Password"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding ChangePasswordCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>