<Window x:Class="Presentation.Views.Windows.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:Presentation.Helpers"

        Title="Change Password"

        Height="520"
        Width="450"

        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"

        Background="Transparent"
        FontFamily="Segoe UI"

        SnapsToDevicePixels="True"
        UseLayoutRounding="True">


    <!-- ========================================================= -->
    <!-- WINDOW RESOURCES                                          -->
    <!-- ========================================================= -->

    <Window.Resources>


        <!-- ===================================================== -->
        <!-- HEADER GRADIENT                                       -->
        <!-- ===================================================== -->

        <LinearGradientBrush x:Key="WindowHeaderGradient"
                             StartPoint="0,0"
                             EndPoint="1,0">

            <GradientStop Color="#FFFFFF"
                          Offset="0"/>

            <GradientStop Color="#F8FAFC"
                          Offset="1"/>

        </LinearGradientBrush>


        <!-- ===================================================== -->
        <!-- CLOSE BUTTON                                          -->
        <!-- ===================================================== -->

        <Style x:Key="CloseButtonStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Width"
                    Value="34"/>

            <Setter Property="Height"
                    Value="34"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextMutedColor}"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="CloseBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>


                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="CloseBorder"
                                        Property="Background"
                                        Value="{StaticResource DangerLightColor}"/>

                                <Setter Property="Foreground"
                                        Value="{StaticResource DangerColor}"/>

                            </Trigger>


                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter Property="Opacity"
                                        Value="0.75"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ===================================================== -->
        <!-- PASSWORD EYE BUTTON                                   -->
        <!-- ===================================================== -->

        <Style x:Key="EyeButtonStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Width"
                    Value="35"/>

            <Setter Property="Height"
                    Value="38"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="EyeBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="0,8,8,0">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>


                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="EyeBorder"
                                        Property="Background"
                                        Value="{StaticResource SurfaceHoverColor}"/>

                            </Trigger>


                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="EyeBorder"
                                        Property="Opacity"
                                        Value="0.75"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


    </Window.Resources>


    <!-- ========================================================= -->
    <!-- MAIN WINDOW                                               -->
    <!-- ========================================================= -->

    <Border Margin="10"

            Background="{StaticResource BackgroundColor}"

            BorderBrush="{StaticResource BorderColor}"

            BorderThickness="1"

            CornerRadius="16"

            SnapsToDevicePixels="True">


        <Border.Effect>

            <DropShadowEffect

                Color="#000000"

                Direction="270"

                ShadowDepth="0"

                BlurRadius="24"

                Opacity="0.16"/>

        </Border.Effect>


        <Grid>


            <!-- ================================================= -->
            <!-- ROW DEFINITIONS                                    -->
            <!-- ================================================= -->

            <Grid.RowDefinitions>

                <!-- Header -->

                <RowDefinition Height="Auto"/>


                <!-- User Information -->

                <RowDefinition Height="Auto"/>


                <!-- Fields -->

                <RowDefinition Height="*"/>


                <!-- Footer -->

                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- HEADER                                             -->
            <!-- ================================================= -->

            <Border Grid.Row="0"

                    Background="{StaticResource WindowHeaderGradient}"

                    BorderBrush="{StaticResource BorderColor}"

                    BorderThickness="0,0,0,1"

                    CornerRadius="16,16,0,0"

                    Padding="24,18">


                <Grid>


                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>


                    <!-- ========================================= -->
                    <!-- HEADER CONTENT                             -->
                    <!-- ========================================= -->

                    <StackPanel Grid.Column="0"

                                Orientation="Horizontal"

                                VerticalAlignment="Center">


                        <!-- ICON -->

                        <Border Width="42"

                                Height="42"

                                CornerRadius="11"

                                Background="{StaticResource PrimaryLightColor}"

                                BorderBrush="#DBEAFE"

                                BorderThickness="1"

                                Margin="0,0,14,0">


                            <Path

                                Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14M21,12V14H19V12H21M21,16V18H19V16H21M21,8V10H19V8H21M21,4V6H19V4H21Z"

                                Stroke="{StaticResource PrimaryColor}"

                                StrokeThickness="1.6"

                                Fill="Transparent"

                                Stretch="Uniform"

                                Width="21"

                                Height="21"

                                HorizontalAlignment="Center"

                                VerticalAlignment="Center"/>

                        </Border>


                        <!-- TITLE -->

                        <StackPanel VerticalAlignment="Center">


                            <TextBlock

                                Text="Change Password"

                                FontSize="19"

                                FontWeight="SemiBold"

                                Foreground="{StaticResource TextColor}"/>


                            <TextBlock

                                Text="Update your account password securely"

                                FontSize="12"

                                Foreground="{StaticResource TextSecondaryColor}"

                                Margin="0,3,0,0"/>

                        </StackPanel>

                    </StackPanel>


                    <!-- CLOSE -->

                    <Button Grid.Column="1"

                            Style="{StaticResource CloseButtonStyle}"

                            Click="CloseButton_Click"

                            ToolTip="Close"

                            VerticalAlignment="Center">


                        <TextBlock

                            Text="×"

                            FontSize="24"

                            FontWeight="Light"

                            VerticalAlignment="Center"

                            HorizontalAlignment="Center"/>

                    </Button>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- USER INFORMATION                                  -->
            <!-- ================================================= -->

            <Border Grid.Row="1"

                    Background="{StaticResource SurfaceColor}"

                    BorderBrush="{StaticResource BorderColor}"

                    BorderThickness="0,0,0,1"

                    Padding="24,12">


                <StackPanel

                    Orientation="Horizontal"

                    HorizontalAlignment="Center">


                    <TextBlock

                        Text="User:"

                        FontWeight="SemiBold"

                        Foreground="{StaticResource TextSecondaryColor}"

                        VerticalAlignment="Center"/>


                    <TextBlock

                        Text="{Binding UserName}"

                        FontWeight="SemiBold"

                        Margin="6,0,20,0"

                        Foreground="{StaticResource TextColor}"

                        VerticalAlignment="Center"/>


                    <TextBlock

                        Text="ID:"

                        FontWeight="SemiBold"

                        Foreground="{StaticResource TextSecondaryColor}"

                        VerticalAlignment="Center"/>


                    <TextBlock

                        Text="{Binding UserId}"

                        FontWeight="SemiBold"

                        Margin="6,0,0,0"

                        Foreground="{StaticResource TextColor}"

                        VerticalAlignment="Center"/>

                </StackPanel>

            </Border>


            <!-- ================================================= -->
            <!-- PASSWORD FIELDS                                   -->
            <!-- ================================================= -->

            <ScrollViewer Grid.Row="2"

                          VerticalScrollBarVisibility="Auto"

                          HorizontalScrollBarVisibility="Disabled">


                <StackPanel Margin="25,20,25,15">


                    <!-- ========================================= -->
                    <!-- CURRENT PASSWORD                           -->
                    <!-- ========================================= -->

                    <TextBlock

                        Text="Current Password"

                        Style="{StaticResource LabelStyle}"

                        Margin="0,0,0,4"/>


                    <Grid Margin="0,0,0,15">


                        <!-- HIDDEN PASSWORD -->

                        <PasswordBox

                            helpers:PasswordBoxHelper.Attach="True"

                            helpers:PasswordBoxHelper.Password="{Binding CurrentPassword, Mode=TwoWay}"

                            Padding="10,0,40,0">


                            <PasswordBox.Style>

                                <Style

                                    TargetType="{x:Type PasswordBox}"

                                    BasedOn="{StaticResource {x:Type PasswordBox}}">


                                    <Style.Triggers>

                                        <DataTrigger

                                            Binding="{Binding IsCurrentPasswordVisible}"

                                            Value="True">

                                            <Setter

                                                Property="Visibility"

                                                Value="Collapsed"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </PasswordBox.Style>

                        </PasswordBox>


                        <!-- VISIBLE PASSWORD -->

                        <TextBox

                            Text="{Binding CurrentPassword,
                                           Mode=TwoWay,
                                           UpdateSourceTrigger=PropertyChanged}"

                            Padding="10,0,40,0">


                            <TextBox.Style>

                                <Style

                                    TargetType="{x:Type TextBox}"

                                    BasedOn="{StaticResource {x:Type TextBox}}">


                                    <Style.Triggers>

                                        <DataTrigger

                                            Binding="{Binding IsCurrentPasswordVisible}"

                                            Value="False">

                                            <Setter

                                                Property="Visibility"

                                                Value="Collapsed"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </TextBox.Style>

                        </TextBox>


                        <!-- EYE -->

                        <Button

                            Style="{StaticResource EyeButtonStyle}"

                            HorizontalAlignment="Right"

                            Command="{Binding ToggleCurrentPasswordCommand}">


                            <TextBlock

                                Text="👁"

                                FontSize="14"

                                Foreground="{StaticResource PrimaryColor}"

                                HorizontalAlignment="Center"

                                VerticalAlignment="Center"/>

                        </Button>

                    </Grid>


                    <!-- ========================================= -->
                    <!-- NEW PASSWORD                               -->
                    <!-- ========================================= -->

                    <TextBlock

                        Text="New Password"

                        Style="{StaticResource LabelStyle}"

                        Margin="0,0,0,4"/>


                    <Grid Margin="0,0,0,15">


                        <!-- HIDDEN -->

                        <PasswordBox

                            helpers:PasswordBoxHelper.Attach="True"

                            helpers:PasswordBoxHelper.Password="{Binding NewPassword, Mode=TwoWay}"

                            Padding="10,0,40,0">


                            <PasswordBox.Style>

                                <Style

                                    TargetType="{x:Type PasswordBox}"

                                    BasedOn="{StaticResource {x:Type PasswordBox}}">


                                    <Style.Triggers>

                                        <DataTrigger

                                            Binding="{Binding IsNewPasswordVisible}"

                                            Value="True">

                                            <Setter

                                                Property="Visibility"

                                                Value="Collapsed"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </PasswordBox.Style>

                        </PasswordBox>


                        <!-- VISIBLE -->

                        <TextBox

                            Text="{Binding NewPassword,
                                           Mode=TwoWay,
                                           UpdateSourceTrigger=PropertyChanged}"

                            Padding="10,0,40,0">


                            <TextBox.Style>

                                <Style

                                    TargetType="{x:Type TextBox}"

                                    BasedOn="{StaticResource {x:Type TextBox}}">


                                    <Style.Triggers>

                                        <DataTrigger

                                            Binding="{Binding IsNewPasswordVisible}"

                                            Value="False">

                                            <Setter

                                                Property="Visibility"

                                                Value="Collapsed"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </TextBox.Style>

                        </TextBox>


                        <!-- EYE -->

                        <Button

                            Style="{StaticResource EyeButtonStyle}"

                            HorizontalAlignment="Right"

                            Command="{Binding ToggleNewPasswordCommand}">


                            <TextBlock

                                Text="👁"

                                FontSize="14"

                                Foreground="{StaticResource PrimaryColor}"

                                HorizontalAlignment="Center"

                                VerticalAlignment="Center"/>

                        </Button>

                    </Grid>


                    <!-- ========================================= -->
                    <!-- CONFIRM PASSWORD                           -->
                    <!-- ========================================= -->

                    <TextBlock

                        Text="Confirm New Password"

                        Style="{StaticResource LabelStyle}"

                        Margin="0,0,0,4"/>


                    <Grid>


                        <!-- HIDDEN -->

                        <PasswordBox

                            helpers:PasswordBoxHelper.Attach="True"

                            helpers:PasswordBoxHelper.Password="{Binding ConfirmNewPassword, Mode=TwoWay}"

                            Padding="10,0,40,0">


                            <PasswordBox.Style>

                                <Style

                                    TargetType="{x:Type PasswordBox}"

                                    BasedOn="{StaticResource {x:Type PasswordBox}}">


                                    <Style.Triggers>

                                        <DataTrigger

                                            Binding="{Binding IsConfirmNewPasswordVisible}"

                                            Value="True">

                                            <Setter

                                                Property="Visibility"

                                                Value="Collapsed"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </PasswordBox.Style>

                        </PasswordBox>


                        <!-- VISIBLE -->

                        <TextBox

                            Text="{Binding ConfirmNewPassword,
                                           Mode=TwoWay,
                                           UpdateSourceTrigger=PropertyChanged}"

                            Padding="10,0,40,0">


                            <TextBox.Style>

                                <Style

                                    TargetType="{x:Type TextBox}"

                                    BasedOn="{StaticResource {x:Type TextBox}}">


                                    <Style.Triggers>

                                        <DataTrigger

                                            Binding="{Binding IsConfirmNewPasswordVisible}"

                                            Value="False">

                                            <Setter

                                                Property="Visibility"

                                                Value="Collapsed"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </TextBox.Style>

                        </TextBox>


                        <!-- EYE -->

                        <Button

                            Style="{StaticResource EyeButtonStyle}"

                            HorizontalAlignment="Right"

                            Command="{Binding ToggleConfirmPasswordCommand}">


                            <TextBlock

                                Text="👁"

                                FontSize="14"

                                Foreground="{StaticResource PrimaryColor}"

                                HorizontalAlignment="Center"

                                VerticalAlignment="Center"/>

                        </Button>

                    </Grid>

                </StackPanel>

            </ScrollViewer>


            <!-- ================================================= -->
            <!-- FOOTER                                             -->
            <!-- ================================================= -->

            <Border Grid.Row="3"

                    Background="{StaticResource SurfaceColor}"

                    BorderBrush="{StaticResource BorderColor}"

                    BorderThickness="0,1,0,0"

                    CornerRadius="0,0,16,16"

                    Padding="20,14,25,18">


                <StackPanel

                    Orientation="Horizontal"

                    HorizontalAlignment="Right">


                    <!-- SAVE -->

                    <Button

                        Content="Save"

                        Style="{StaticResource PrimaryButtonStyle}"

                        Command="{Binding ChangePasswordCommand}"

                        Width="120"

                        Margin="0,0,12,0"/>


                    <!-- CLOSE -->

                    <Button

                        Content="Close"

                        Style="{StaticResource SecondaryButtonStyle}"

                        Click="CloseButton_Click"

                        Width="120"/>

                </StackPanel>

            </Border>

        </Grid>

    </Border>

</Window>