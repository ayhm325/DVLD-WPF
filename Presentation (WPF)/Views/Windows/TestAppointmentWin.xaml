<Window x:Class="Presentation.Views.Windows.TestAppointmentWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Presentation.Views.Controls"
        Title="{Binding PageTitle}"
        Height="800" Width="920"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">



    <Border Background="{StaticResource SurfaceColor}" BorderBrush="{StaticResource BorderColor}"
            BorderThickness="1" CornerRadius="{StaticResource RadiusLarge}" Margin="16"
            Effect="{StaticResource ElevationShadow3}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource SurfaceColor}"
                    BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1"
                    Padding="24,18" CornerRadius="16,16,0,0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="{StaticResource RadiusMedium}"
                            Background="{StaticResource PrimaryLightColor}" Margin="0,0,14,0">
                        <TextBlock Text="▣" Foreground="{StaticResource PrimaryColor}"
                                   FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding PageTitle}" Style="{StaticResource HeaderStyle}"/>
                        <TextBlock Text="{Binding PageDescription}" Style="{StaticResource CaptionStyle}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" Margin="24,18,24,16"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <controls:DrivingLicenseApplicationInfo
                        x:Name="DrivingLicenseApplicationInfoControl"
                        DrivingLicenseApplicationId="{Binding LdlAppInfo.LocalDrivingLicenseApplicationId}"
                        PassedTests="{Binding LdlAppInfo.PassedTest}"
                        TotalTests="3"
                        LicenseClassName="{Binding LdlAppInfo.LicenseClassName}"
                        Margin="0,0,0,14"/>

                    <controls:ApplicationBasicInfo
                        x:Name="ApplicationBasicInfoControl"
                        Application="{Binding ApplicationInfo}"
                        Margin="0,0,0,14"/>

                    <Border Style="{StaticResource CardStyle}" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="16"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Appointments" Style="{StaticResource SectionTitleStyle}"/>
                                    <Border Background="{StaticResource PrimaryColor}" CornerRadius="{StaticResource RadiusPill}"
                                            Padding="8,3" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding AppointmentsList.Count}" Foreground="{StaticResource OnPrimaryColor}"
                                                   FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Cancel Appointment" Command="{Binding CancelAppointmentCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" MinWidth="150" Margin="0,0,10,0"/>
                                    <Button Content="Add Appointment" Command="{Binding AddAppointmentCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}" MinWidth="160"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                                <TextBlock Text="{Binding EditRestrictionMessage}" TextWrapping="Wrap"
                                           Foreground="{StaticResource WarningColor}" Margin="0,0,0,4">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EditRestrictionMessage}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding WorkflowMessage}" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextMutedColor}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WorkflowMessage}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <Grid Grid.Row="3">
                            <DataGrid ItemsSource="{Binding AppointmentsList}"
                                      SelectedItem="{Binding SelectedAppointment}" MinHeight="250">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Edit" Command="{Binding EditAppointmentCommand}"/>
                                        <Separator/>
                                        <MenuItem Header="Take Test" Command="{Binding TakeTestCommand}"/>
                                        <Separator/>
                                        <MenuItem Header="Cancel Appointment" Command="{Binding CancelAppointmentCommand}"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Applicant" Binding="{Binding ApplicantFullName}" Width="190"/>
                                    <DataGridTextColumn Header="National No." Binding="{Binding NationalNo}" Width="130"/>
                                    <DataGridTextColumn Header="Test" Binding="{Binding TestTypeName}" Width="145"/>
                                    <DataGridTextColumn Header="Application ID" Binding="{Binding LocalDrivingLicenseApplicationId}" Width="120"/>
                                    <DataGridTextColumn Header="Appointment ID" Binding="{Binding TestAppointmentId}" Width="125"/>
                                    <DataGridTextColumn Header="Date" Binding="{Binding AppointmentDate, StringFormat=dd/MM/yyyy hh:mm tt}" Width="170"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                                    <DataGridTextColumn Header="Result" Binding="{Binding TestResultText}" Width="100"/>
                                    <DataGridTextColumn Header="Paid Fees" Binding="{Binding PaidFees, StringFormat=C}" Width="120"/>
                                    <DataGridTemplateColumn Header="Locked" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsLocked}" IsEnabled="False" IsHitTestVisible="False"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                                <Border Background="{StaticResource SurfaceColor}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20" CornerRadius="{StaticResource RadiusMedium}" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal"><ProgressBar Width="90" Height="6" IsIndeterminate="True" VerticalAlignment="Center"/><TextBlock Text="Loading appointments…" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                </Border>
                                <TextBlock Text="No appointments are available for this test stage." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextMutedColor}" IsHitTestVisible="False" Visibility="{Binding HasNoAppointments, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{StaticResource SurfaceSecondaryColor}"
                    Padding="20,15,24,20" CornerRadius="0,0,16,16"
                    BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0">
                <Button Content="Close" Width="120" HorizontalAlignment="Right"
                        Click="CloseButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
            </Border>
        </Grid>
    </Border>
</Window>




