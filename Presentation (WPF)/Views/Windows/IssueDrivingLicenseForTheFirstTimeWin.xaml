<Window x:Class="Presentation.Views.Windows.IssueDrivingLicenseForTheFirstTimeWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Presentation.Views.Controls"
        mc:Ignorable="d"
        Title="Get Driver License For The First Time"
        Width="820"
        Height="650"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource RadiusMedium}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource DangerLightColor}"/>
                                <Setter Property="Foreground" Value="{StaticResource DangerColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NotesTextBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="MinHeight" Value="70"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource SurfaceColor}"
            BorderBrush="{StaticResource BorderColor}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusXLarge}"
            Margin="15"
            SnapsToDevicePixels="True"
            Effect="{StaticResource ElevationShadow2}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceSecondaryColor}"
                    CornerRadius="16,16,0,0"
                    Padding="25,18"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="38"
                                Height="38"
                                CornerRadius="{StaticResource RadiusMedium}"
                                Background="{StaticResource PrimaryLightColor}"
                                BorderBrush="{StaticResource BorderColor}"
                                BorderThickness="1"
                                Margin="0,0,14,0"
                                Padding="8"
                                VerticalAlignment="Center">
                            <Path Data="M4,16V12C4,9.79 5.79,8 8,8H14.5L12.5,6H8A2,2 0 0,0 6,8V16A2,2 0 0,0 8,18H19A2,2 0 0,0 21,16V12C21,9.79 19.21,8 17,8H15.5L17.5,10H19A2,2 0 0,1 21,12V16A2,2 0 0,1 19,18H8A2,2 0 0,1 6,16M12,4L15,7H9L12,4M18,14H6V12H18V14Z"
                                  Stroke="{StaticResource PrimaryColor}"
                                  StrokeThickness="1.6"
                                  Fill="Transparent"
                                  Stretch="Uniform"
                                  Height="20"
                                  Width="20"/>
                        </Border>
                        <TextBlock Text="Get Driver License For The First Time"
                                   Style="{StaticResource HeaderStyle}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="20,15,20,20">
                <StackPanel>
                    <controls:DrivingLicenseApplicationInfo
                        x:Name="drivingLicenseInfo"
                        DrivingLicenseApplicationId="{Binding DrivingLicenseApplicationId}"
                        LicenseClassName="{Binding LicenseClassName}"
                        PassedTests="{Binding PassedTests}"
                        TotalTests="{Binding TotalTests}"
                        Margin="0,0,0,15"/>

                    <controls:ApplicationBasicInfo
                        x:Name="applicationBasicInfo"
                        Application="{Binding BasicApplicationInfo}"
                        Margin="0,0,0,15"/>

                    <Border Style="{StaticResource CardStyle}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Notes"
                                       Style="{StaticResource LabelStyle}"
                                       FontWeight="{StaticResource FontWeightSemiBold}"
                                       Margin="0,0,0,8"/>
                            <TextBox x:Name="txtNotes"
                                     Style="{StaticResource NotesTextBoxStyle}"
                                     Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="{StaticResource SurfaceColor}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,1,0,0"
                    Padding="20,15,25,20"
                    CornerRadius="0,0,16,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Close"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Width="120"
                            Margin="0,0,15,0"
                            Command="{Binding CloseCommand}"/>
                    <Button Content="Issue License"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="140"
                            Command="{Binding IssueCommand}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
