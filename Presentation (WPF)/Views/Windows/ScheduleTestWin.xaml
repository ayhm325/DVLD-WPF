<Window x:Class="Presentation.Views.Windows.ScheduleTestWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Schedule Test"
        Height="700" Width="520"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="ReadOnlyInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="{StaticResource SurfaceHoverColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedColor}"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>

        <Style x:Key="RetakeSectionStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PrimarySoftColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}"/>
            <Setter Property="Padding" Value="18,16"/>
        </Style>

        <Style x:Key="RetakeLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="RetakeTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource SurfaceColor}" BorderBrush="{StaticResource BorderColor}"
            BorderThickness="1" CornerRadius="{StaticResource RadiusLarge}" Margin="16"
            Effect="{StaticResource ElevationShadow3}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource SurfaceColor}"
                    BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1"
                    Padding="24,18" CornerRadius="16,16,0,0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="{StaticResource RadiusMedium}"
                            Background="{StaticResource PrimaryLightColor}" Margin="0,0,14,0">
                        <TextBlock Text="◉" Foreground="{StaticResource PrimaryColor}"
                                   FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Schedule Test" Style="{StaticResource HeaderStyle}"/>
                        <TextBlock Text="Vision Test" Style="{StaticResource CaptionStyle}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" Margin="24,18,24,0"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Applicant &amp; Appointment" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="D.L.App.ID" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Schedule.LocalDrivingLicenseApplicationId}" Style="{StaticResource ReadOnlyInput}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Trial" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Schedule.Trial}" Style="{StaticResource ReadOnlyInput}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                            <TextBlock Text="D. Class" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Schedule.LicenseClassName}" Style="{StaticResource ReadOnlyInput}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
                            <TextBlock Text="Name" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Schedule.FullName}" Style="{StaticResource ReadOnlyInput}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="6" Grid.Column="0">
                            <TextBlock Text="Date" Style="{StaticResource LabelStyle}"/>
                            <DatePicker SelectedDate="{Binding Schedule.Date}" DisplayDateStart="{Binding MinDate, Mode=OneWay}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="6" Grid.Column="2">
                            <TextBlock Text="Fees" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Schedule.Fees}" Style="{StaticResource ReadOnlyInput}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Style="{StaticResource RetakeSectionStyle}"
                    Visibility="{Binding IsRetake, Converter={StaticResource BoolToVis}}"
                    Margin="24,16,24,0">
                <StackPanel>
                    <TextBlock Text="Retake Test Info" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="R.App.Fees" Style="{StaticResource RetakeLabelStyle}"/>
                            <TextBox Text="{Binding Schedule.RetakerFees}" Style="{StaticResource RetakeTextBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Total Fees" Style="{StaticResource RetakeLabelStyle}"/>
                            <TextBox Text="{Binding TotalFees, Mode=OneWay}" Style="{StaticResource RetakeTextBoxStyle}"
                                     FontWeight="Bold" Foreground="{StaticResource PrimaryColor}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="R.Test.App.ID" Style="{StaticResource RetakeLabelStyle}"/>
                            <TextBox Text="{Binding Schedule.RetakeTestApplicationId}" Style="{StaticResource RetakeTextBoxStyle}"
                                     Foreground="{StaticResource TextSecondaryColor}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Background="{StaticResource SurfaceSecondaryColor}"
                    Padding="20,15,24,20" CornerRadius="0,0,16,16"
                    BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveCommand}"
                            Content="Save" Width="120" Margin="0,0,12,0"/>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CloseCommand}"
                            Content="Close" Width="120" Click="CloseButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
