<Window x:Class="Presentation.Views.Windows.Tests.EditTestTypeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Edit Test Type" Height="680" Width="820"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Border Margin="12" Background="{StaticResource BackgroundColor}"
            BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusXLarge}"
            Effect="{StaticResource ElevationShadow3}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="96"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="76"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource PrimarySoftColor}"
                    BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1"
                    CornerRadius="16,16,0,0" Padding="26,16">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="50" Height="50" CornerRadius="14"
                                Background="{StaticResource PrimaryColor}">
                            <materialDesign:PackIcon Kind="TestTube" Width="25" Height="25"
                                                     Foreground="White"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="TEST CONFIGURATION" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryColor}"/>
                            <TextBlock Text="Edit Test Type" FontSize="21" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryColor}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Style="{StaticResource GhostButtonStyle}"
                            Click="Close_Click">
                        <TextBlock Text="×" FontSize="24"/>
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="28,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}"
                            Padding="18" Margin="0,0,22,0">
                        <StackPanel>
                            <TextBlock Text="TEST TYPE" Style="{StaticResource CaptionStyle}"/>
                            <Border Width="54" Height="54" CornerRadius="16"
                                    Background="{StaticResource PrimaryLightColor}" Margin="0,12,0,16">
                                <materialDesign:PackIcon Kind="TestTube" Width="27" Height="27"
                                                         Foreground="{StaticResource PrimaryColor}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Identifier" Style="{StaticResource CaptionStyle}"/>
                            <TextBlock Text="{Binding CurrentTestType.TestTypeId}"
                                       FontSize="26" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryColor}" Margin="0,4,0,0"/>
                            <Border Height="1" Background="{StaticResource BorderColor}" Margin="0,18,0,14"/>
                            <TextBlock Text="SYSTEM DEFINITION" FontSize="9" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryColor}"/>
                            <TextBlock Text="Test definition and examination fee"
                                       TextWrapping="Wrap" FontSize="11"
                                       Foreground="{StaticResource TextMutedColor}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Test Details" Style="{StaticResource HeaderStyle}"/>
                        <TextBlock Text="Configure the title, description and examination fee."
                                   Style="{StaticResource CaptionStyle}" Margin="0,4,0,22"/>

                        <TextBlock Text="TEST TITLE" Style="{StaticResource LabelStyle}" Margin="0,0,0,7"/>
                        <Grid>
                            <Border Width="38" Height="38" CornerRadius="10"
                                    Background="{StaticResource PrimaryLightColor}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Panel.ZIndex="2" Margin="6,0,0,0">
                                <materialDesign:PackIcon Kind="TextBoxEditOutline" Width="19" Height="19"
                                                         Foreground="{StaticResource PrimaryColor}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBox Text="{Binding CurrentTestType.TestTypeTitle, UpdateSourceTrigger=PropertyChanged}"
                                     Height="46" Padding="54,0,14,0" VerticalContentAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="DESCRIPTION" Style="{StaticResource LabelStyle}" Margin="0,20,0,7"/>
                        <Grid>
                            <Border Width="38" Height="38" CornerRadius="10"
                                    Background="{StaticResource PrimaryLightColor}"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Panel.ZIndex="2" Margin="6,6,0,0">
                                <materialDesign:PackIcon Kind="TextBoxMultipleOutline" Width="19" Height="19"
                                                         Foreground="{StaticResource PrimaryColor}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBox Text="{Binding CurrentTestType.TestTypeDescription, UpdateSourceTrigger=PropertyChanged}"
                                     Height="112" Padding="54,12,14,12"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                        </Grid>

                        <TextBlock Text="EXAMINATION FEE" Style="{StaticResource LabelStyle}" Margin="0,20,0,7"/>
                        <Grid>
                            <Border Width="38" Height="38" CornerRadius="10"
                                    Background="{StaticResource SuccessLightColor}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Panel.ZIndex="2" Margin="6,0,0,0">
                                <materialDesign:PackIcon Kind="CashMultiple" Width="19" Height="19"
                                                         Foreground="{StaticResource SuccessColor}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBox Text="{Binding CurrentTestType.TestTypeFees, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F2}}"
                                     Height="46" Padding="54,0,55,0" VerticalContentAlignment="Center"/>
                            <TextBlock Text="JOD" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Margin="0,0,14,0" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedColor}" IsHitTestVisible="False"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{StaticResource SurfaceSecondaryColor}"
                    BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,16,16" Padding="28,12">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessColor}"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="Ready to save changes" FontSize="10"
                                   Foreground="{StaticResource TextMutedColor}" Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding CloseCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                Content="Cancel" Style="{StaticResource SecondaryButtonStyle}"
                                Width="105" Margin="0,0,10,0"/>
                        <Button Command="{Binding SaveCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                Content="Save Changes" Style="{StaticResource PrimaryButtonStyle}"
                                Width="125"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>