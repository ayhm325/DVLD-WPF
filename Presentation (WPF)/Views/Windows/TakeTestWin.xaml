<Window x:Class="Presentation.Views.Windows.TakeTestWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Take Test"
        Height="850"
        Width="520"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="LockedInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="{StaticResource SurfaceHoverColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Cursor" Value="Arrow"/>
        </Style>

        <Style x:Key="TestIdBox" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PrimarySoftColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,16,0,20"/>
        </Style>

        <Style x:Key="PassedToggle" TargetType="ToggleButton">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource SuccessColor}"/>
            <Setter Property="Background" Value="{StaticResource SuccessLightColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SuccessColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="B" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusMedium}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{StaticResource SuccessColor}"/>
                                <Setter Property="Foreground" Value="{StaticResource OnPrimaryColor}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource SuccessHoverColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FailedToggle" TargetType="ToggleButton">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource DangerColor}"/>
            <Setter Property="Background" Value="{StaticResource DangerLightColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DangerColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="B" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusMedium}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{StaticResource DangerColor}"/>
                                <Setter Property="Foreground" Value="{StaticResource OnPrimaryColor}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource DangerHoverColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource SurfaceColor}"
            BorderBrush="{StaticResource BorderColor}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusLarge}"
            Margin="16"
            Effect="{StaticResource ElevationShadow3}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceColor}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="16,16,0,0"
                    Padding="24,18">
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="{StaticResource RadiusMedium}"
                            Background="{StaticResource PrimaryLightColor}" Margin="0,0,14,0">
                        <TextBlock Text="✓" Foreground="{StaticResource PrimaryColor}"
                                   FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Vision Test" Style="{StaticResource HeaderStyle}"/>
                        <TextBlock Text="Record the applicant's test result"
                                   Style="{StaticResource CaptionStyle}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" Margin="24,18,24,8"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Test Information" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="125"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="D.L. App ID" Style="{StaticResource LabelStyle}"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Schedule.LocalDrivingLicenseApplicationId}" Style="{StaticResource LockedInput}"/>

                        <TextBlock Grid.Row="2" Text="D. Class" Style="{StaticResource LabelStyle}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Schedule.LicenseClassName}" Style="{StaticResource LockedInput}"/>

                        <TextBlock Grid.Row="4" Text="Name" Style="{StaticResource LabelStyle}"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Schedule.FullName}" Style="{StaticResource LockedInput}"/>

                        <TextBlock Grid.Row="6" Text="Trial" Style="{StaticResource LabelStyle}"/>
                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Schedule.Trial}" Style="{StaticResource LockedInput}"/>

                        <TextBlock Grid.Row="8" Text="Date" Style="{StaticResource LabelStyle}"/>
                        <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Schedule.Date, StringFormat='yyyy-MM-dd'}" Style="{StaticResource LockedInput}"/>

                        <TextBlock Grid.Row="10" Text="Fees" Style="{StaticResource LabelStyle}"/>
                        <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding Schedule.Fees}" Style="{StaticResource LockedInput}"/>
                    </Grid>

                    <Border Style="{StaticResource TestIdBox}">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="TEST" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryColor}" VerticalAlignment="Center"/>
                                <TextBlock Text="  •  Test ID" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryColor}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Schedule.TestId, TargetNullValue='Not Taken Yet'}"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryColor}"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="Result" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>
                    <UniformGrid Columns="2" Margin="0,0,0,22">
                        <ToggleButton Content="Passed" Style="{StaticResource PassedToggle}"
                                      Margin="0,0,8,0" IsChecked="{Binding IsPassed}"/>
                        <ToggleButton Content="Failed" Style="{StaticResource FailedToggle}"
                                      Margin="8,0,0,0" IsChecked="{Binding IsFailed}"/>
                    </UniformGrid>

                    <TextBlock Text="Notes" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                             Height="100" VerticalContentAlignment="Top"
                             Padding="12,10" TextWrapping="Wrap" AcceptsReturn="True"/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{StaticResource SurfaceSecondaryColor}"
                    Padding="20,15,24,20" CornerRadius="0,0,16,16"
                    BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Save" Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" Width="120" Margin="0,0,12,0"/>
                    <Button Content="Close" Command="{Binding CloseCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Width="120"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
