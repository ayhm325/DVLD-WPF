<Window x:Class="Presentation.Views.Windows.PersonDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Person Details"
        Height="650"
        Width="920"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        FontFamily="{StaticResource AppFontFamily}">

    <Border Margin="10"
            Background="{StaticResource SurfaceColor}"
            BorderBrush="{StaticResource BorderColor}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusXLarge}"
            Effect="{StaticResource ElevationShadow3}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="82"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="68"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="{StaticResource PrimarySoftColor}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="16,16,0,0"
                    Padding="26,15">

                <Grid>
                    <StackPanel Orientation="Horizontal">

                        <Border Width="48"
                                Height="48"
                                CornerRadius="14"
                                Background="{StaticResource PrimaryColor}">

                            <TextBlock Text="P"
                                       Foreground="White"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Margin="15,0,0,0"
                                    VerticalAlignment="Center">

                            <TextBlock Text="Person Details"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextColor}"/>

                            <TextBlock Text="Complete personal information and contact details"
                                       Margin="0,4,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryColor}"/>
                        </StackPanel>
                    </StackPanel>

                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Style="{StaticResource GhostButtonStyle}"
                            Click="Close_Click">

                        <TextBlock Text="×"
                                   FontSize="24"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Main Content -->
            <Grid Grid.Row="1"
                  Margin="26,22">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Person Image Card -->
                <Border Grid.Column="0"
                        Style="{StaticResource CardStyle}"
                        Padding="16"
                        Margin="0,0,18,0">

                    <StackPanel>

                        <Border Width="180"
                                Height="210"
                                CornerRadius="12"
                                Background="{StaticResource SurfaceSecondaryColor}"
                                BorderBrush="{StaticResource BorderColor}"
                                BorderThickness="1"
                                HorizontalAlignment="Center">

                            <Image x:Name="ImgPerson"
                                   Stretch="UniformToFill"/>
                        </Border>

                        <TextBlock x:Name="LblFullName"
                                   Text="—"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   Margin="0,15,0,0"
                                   Foreground="{StaticResource TextColor}"/>

                        <TextBlock x:Name="LblNationalNo"
                                   Text="—"
                                   FontSize="12"
                                   TextAlignment="Center"
                                   Margin="0,4,0,0"
                                   Foreground="{StaticResource TextMutedColor}"/>
                    </StackPanel>
                </Border>

                <!-- Person Information Card -->
                <Border Grid.Column="1"
                        Style="{StaticResource CardStyle}"
                        Padding="24">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Person ID -->
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="Person ID"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <TextBlock x:Name="LblPersonId"
                                   Grid.Row="0"
                                   Grid.Column="1"
                                   Style="{StaticResource FieldValueStyle}"/>

                        <!-- National Number -->
                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="National No."
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <TextBlock x:Name="LblNationalNo2"
                                   Grid.Row="1"
                                   Grid.Column="1"
                                   Text="{Binding Text, ElementName=LblNationalNo}"
                                   Style="{StaticResource FieldValueStyle}"/>

                        <!-- Gender -->
                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="Gender"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <TextBlock x:Name="LblGender"
                                   Grid.Row="2"
                                   Grid.Column="1"
                                   Style="{StaticResource FieldValueStyle}"/>

                        <!-- Date of Birth -->
                        <TextBlock Grid.Row="3"
                                   Grid.Column="0"
                                   Text="Date of Birth"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <TextBlock x:Name="LblDateOfBirth"
                                   Grid.Row="3"
                                   Grid.Column="1"
                                   Style="{StaticResource FieldValueStyle}"/>

                        <!-- Phone -->
                        <TextBlock Grid.Row="4"
                                   Grid.Column="0"
                                   Text="Phone"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <TextBlock x:Name="LblPhone"
                                   Grid.Row="4"
                                   Grid.Column="1"
                                   Style="{StaticResource FieldValueStyle}"/>

                        <!-- Email -->
                        <TextBlock Grid.Row="5"
                                   Grid.Column="0"
                                   Text="Email"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <TextBlock x:Name="LblEmail"
                                   Grid.Row="5"
                                   Grid.Column="1"
                                   Style="{StaticResource FieldValueStyle}"
                                   TextWrapping="Wrap"/>

                        <!-- Country -->
                        <TextBlock Grid.Row="6"
                                   Grid.Column="0"
                                   Text="Country"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <TextBlock x:Name="LblCountry"
                                   Grid.Row="6"
                                   Grid.Column="1"
                                   Style="{StaticResource FieldValueStyle}"/>

                        <!-- Address -->
                        <TextBlock Grid.Row="7"
                                   Grid.Column="0"
                                   Text="Address"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <TextBlock x:Name="LblAddress"
                                   Grid.Row="7"
                                   Grid.Column="1"
                                   Style="{StaticResource FieldValueStyle}"
                                   TextWrapping="Wrap"/>

                        <!-- API Information -->
                        <Border Grid.Row="8"
                                Grid.ColumnSpan="2"
                                Background="{StaticResource SurfaceSecondaryColor}"
                                CornerRadius="10"
                                Padding="12"
                                Margin="0,14,0,0">

                            <TextBlock Text="Personal record loaded from the backend API."
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedColor}"/>
                        </Border>

                    </Grid>
                </Border>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2"
                    Background="{StaticResource SurfaceSecondaryColor}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,16,16"
                    Padding="26,12">

                <Button Content="Close"
                        Width="100"
                        HorizontalAlignment="Right"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Close_Click"/>
            </Border>

        </Grid>
    </Border>
</Window>