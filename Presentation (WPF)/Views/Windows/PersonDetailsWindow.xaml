<Window x:Class="Presentation.Views.Windows.PersonDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Person Information Details"
        Height="500"
        Width="920"
        WindowStartupLocation="CenterScreen"       
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize">

    <Window.Resources>

        <!-- تدرج الهيدر: PrimaryLightColor(#FEF2F2) → SurfaceColor(#FFFFFF) -->
        <LinearGradientBrush x:Key="HeaderBgGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FEF2F2" Offset="0"/>
            <GradientStop Color="#FFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <!-- أبعاد محلية — تتبع نظام الـ Spacing -->
        <Thickness x:Key="HeaderPadding">24,16,24,16</Thickness>
        <Thickness x:Key="FooterPadding">24,16,24,20</Thickness>
        <Thickness x:Key="ContentMargin">24,16,24,20</Thickness>
        <Thickness x:Key="FieldRowMargin">0,0,0,15</Thickness>
        <GridLength x:Key="LabelColumnWidth">120</GridLength>

        <!-- ═══════ زر الإغلاق ═══════ -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource RadiusMedium}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="{StaticResource SurfaceHoverColor}"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource ErrorColor}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground"
                                        Value="{StaticResource TextDisabledColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════ نمط قيمة الحقل ═══════ -->
        <Style x:Key="ValueTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}"/>
        </Style>

        <!-- ═══════ زر ثانوي — يتبع الـ Tokens ═══════ -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="{StaticResource ButtonHeight}"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Padding" Value="{StaticResource ButtonPadding}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="{StaticResource ButtonFontSize}"/>
            <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}"/>
            <Setter Property="FontWeight" Value="{StaticResource FontWeightMedium}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusMedium}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                            <ContentPresenter x:Name="contentPresenter"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border"
                                        Property="BorderBrush"
                                        Value="{StaticResource TextSecondaryColor}"/>
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="{StaticResource SurfaceHoverColor}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="{StaticResource ButtonPressedColor}"/>
                                <Setter TargetName="border"
                                        Property="BorderBrush"
                                        Value="{StaticResource BorderStrongColor}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="{StaticResource SurfaceHoverColor}"/>
                                <Setter TargetName="border"
                                        Property="BorderBrush"
                                        Value="{StaticResource BorderColor}"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource TextDisabledColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ═══════════════ الحاوية الرئيسية ═══════════════ -->
    <Border Background="{StaticResource SurfaceColor}" 
            BorderBrush="{StaticResource BorderColor}" 
            BorderThickness="1" 
            CornerRadius="{StaticResource RadiusLarge}" 
            Margin="16"
            Effect="{StaticResource ElevationShadow3}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="*"/>
                <!-- Content -->
                <RowDefinition Height="Auto"/>
                <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- ==================== الهيدر ==================== -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeaderBgGradient}" 
                    CornerRadius="12,12,0,0"
                    Padding="{StaticResource HeaderPadding}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,0,0,1">

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Border Width="38"
                            Height="38"
                            CornerRadius="{StaticResource RadiusMedium}" 
                            Background="{StaticResource PrimaryLightColor}" 
                            Margin="0,0,16,0"
                            Padding="8"
                            VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="AccountDetails" 
                                                 Foreground="{StaticResource PrimaryColor}" 
                                                 Width="20" 
                                                 Height="20" 
                                                 VerticalAlignment="Center" 
                                                 HorizontalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Detailed Person Profile" 
                               Style="{StaticResource HeaderStyle}"
                               VerticalAlignment="Center"/>

                </StackPanel>
            </Border>

            <!-- ==================== المحتوى ==================== -->
            <Grid Grid.Row="1"
                  Margin="{StaticResource ContentMargin}">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===== العمود الأيسر ===== -->
                <StackPanel Grid.Column="0"
                            Margin="0,0,24,0">

                    <!-- Person ID -->
                    <Grid Margin="{StaticResource FieldRowMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource LabelColumnWidth}"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Person ID" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Column="1" x:Name="LblPersonId" Style="{StaticResource ValueTextStyle}"/>
                    </Grid>

                    <!-- National No -->
                    <Grid Margin="{StaticResource FieldRowMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource LabelColumnWidth}"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="National No" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Column="1" x:Name="LblNationalNo" Style="{StaticResource ValueTextStyle}"/>
                    </Grid>

                    <!-- Full Name -->
                    <Grid Margin="{StaticResource FieldRowMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource LabelColumnWidth}"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Full Name" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Column="1" x:Name="LblFullName" Style="{StaticResource ValueTextStyle}" TextWrapping="Wrap"/>
                    </Grid>

                    <!-- Gender -->
                    <Grid Margin="{StaticResource FieldRowMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource LabelColumnWidth}"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Gender" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Column="1" x:Name="LblGender" Style="{StaticResource ValueTextStyle}"/>
                    </Grid>

                    <!-- Phone -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource LabelColumnWidth}"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Phone" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Column="1" x:Name="LblPhone" Style="{StaticResource ValueTextStyle}"/>
                    </Grid>

                </StackPanel>

                <!-- ===== الصورة الشخصية ===== -->
                <Border Grid.Column="1"
                        Width="160"
                        Height="160"
                        Margin="0,0,24,0"
                        CornerRadius="80"
                        Background="{StaticResource InputBackgroundColor}"
                        BorderBrush="{StaticResource PrimaryColor}"
                        BorderThickness="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top">

                    <Border.Clip>
                        <EllipseGeometry Center="80,80" RadiusX="80" RadiusY="80"/>
                    </Border.Clip>

                    <Image x:Name="ImgPerson" Stretch="UniformToFill"/>
                </Border>

                <!-- ===== العمود الأيمن ===== -->
                <StackPanel Grid.Column="2">

                    <!-- Date Of Birth -->
                    <Grid Margin="{StaticResource FieldRowMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource LabelColumnWidth}"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Date Of Birth" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Column="1" x:Name="LblDateOfBirth" Style="{StaticResource ValueTextStyle}"/>
                    </Grid>

                    <!-- Email -->
                    <Grid Margin="{StaticResource FieldRowMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource LabelColumnWidth}"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Email" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Column="1" x:Name="LblEmail" Style="{StaticResource ValueTextStyle}" TextWrapping="Wrap"/>
                    </Grid>

                    <!-- Country -->
                    <Grid Margin="{StaticResource FieldRowMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource LabelColumnWidth}"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Country" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Column="1" x:Name="LblCountry" Style="{StaticResource ValueTextStyle}"/>
                    </Grid>

                    <!-- Address -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource LabelColumnWidth}"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Address" Style="{StaticResource LabelStyle}" VerticalAlignment="Top"/>
                        <TextBlock Grid.Column="1" x:Name="LblAddress" Style="{StaticResource ValueTextStyle}" TextWrapping="Wrap"/>
                    </Grid>

                </StackPanel>

            </Grid>

            <!-- ==================== شريط الأزرار ==================== -->
            <Border Grid.Row="2" 
                    Background="{StaticResource SurfaceColor}" 
                    Padding="{StaticResource FooterPadding}" 
                    CornerRadius="0,0,12,12"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,1,0,0">

                <Button Content="Close" 
                        HorizontalAlignment="Right"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Close_Click"/>

            </Border>

        </Grid>
    </Border>
</Window>