<Window x:Class="Presentation.Views.Windows.UserDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:controls="clr-namespace:Presentation.Views.Controls"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="User Details" 
        Width="970"
        Height="750"
        WindowStartupLocation="CenterScreen"       
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- تدرج الهيدر: PrimaryLightColor → SurfaceColor -->
        <LinearGradientBrush x:Key="HeaderBgGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#F0FDFA" Offset="0"/>
            <GradientStop Color="#FFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <!-- زر الإغلاق — يتبع الـ Tokens حرفياً -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource RadiusMedium}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="{StaticResource SurfaceHoverColor}"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource ErrorColor}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground"
                                        Value="{StaticResource TextDisabledColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- الحاوية الرئيسية -->
    <Border Background="{StaticResource BackgroundColor}" 
            BorderBrush="{StaticResource BorderColor}" 
            BorderThickness="1" 
            CornerRadius="{StaticResource RadiusLarge}" 
            Margin="16"
            Effect="{StaticResource ElevationShadow3}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="*"/>
                <!-- Content -->
                <RowDefinition Height="Auto"/>
                <!-- Buttons -->
            </Grid.RowDefinitions>

            <!-- ================= الهيدر ================= -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeaderBgGradient}" 
                    CornerRadius="12,12,0,0" 
                    Padding="24,16,24,16"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <!-- أيقونة الهيدر -->
                        <Border Width="38"
                                Height="38"
                                CornerRadius="{StaticResource RadiusMedium}" 
                                Background="{StaticResource PrimaryColor}" 
                                Opacity="0.15"
                                Margin="0,0,16,0"
                                Padding="8"
                                VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="AccountDetails" 
                                                     Foreground="{StaticResource PrimaryColor}" 
                                                     Width="20" 
                                                     Height="20" 
                                                     VerticalAlignment="Center" 
                                                     HorizontalAlignment="Center"/>
                        </Border>

                        <!-- عنوان الهيدر -->
                        <TextBlock Text="User Details" 
                                   Style="{StaticResource HeaderStyle}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= المحتوى ================= -->
            <ScrollViewer Grid.Row="1" 
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="20,16,20,0">

                <StackPanel>

                    <!-- بطاقة تفاصيل المستخدم -->
                    <controls:InformationPerson Person="{Binding Person}" 
                                                Margin="0,0,0,20"/>

                    <!-- بطاقة حالة المستخدم -->
                    <controls:UserCard DataContext="{Binding}"/>

                </StackPanel>

            </ScrollViewer>

            <!-- ================= شريط الأزرار السفلي ================= -->
            <Border Grid.Row="2" 
                    Background="{StaticResource BackgroundColor}" 
                    Padding="20,16,24,20" 
                    CornerRadius="0,0,12,12"
                    Margin="-1,0,-1,-1">
                <Button Content="Close" 
                        Width="120" 
                        HorizontalAlignment="Right"
                        Click="CloseButton_Click"
                        Style="{StaticResource SecondaryButtonStyle}"/>
            </Border>

        </Grid>
    </Border>
</Window>