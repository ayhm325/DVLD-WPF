<Window x:Class="Presentation.Views.Windows.UserDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:controls="clr-namespace:Presentation.Views.Controls"
        mc:Ignorable="d"
        Title="User Details"
        Width="970"
        Height="750"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <Thickness x:Key="HeaderPadding">24,16,24,16</Thickness>
        <Thickness x:Key="FooterPadding">20,16,24,20</Thickness>
        <Thickness x:Key="ContentMargin">20,16,20,0</Thickness>
    </Window.Resources>

    <Border Background="{StaticResource SurfaceColor}"
            BorderBrush="{StaticResource BorderColor}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusLarge}"
            Margin="16"
            Effect="{StaticResource ElevationShadow3}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceColor}"
                    CornerRadius="16,16,0,0"
                    Padding="{StaticResource HeaderPadding}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Width="40"
                            Height="40"
                            CornerRadius="{StaticResource RadiusMedium}"
                            Background="{StaticResource PrimaryLightColor}"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="1"
                            Margin="0,0,16,0"
                            Padding="8">
                        <Path Data="M12 12a4 4 0 100-8 4 4 0 000 8zm-7 8a7 7 0 0114 0"
                              Stroke="{StaticResource PrimaryColor}"
                              StrokeThickness="1.7"
                              Fill="Transparent"
                              Stretch="Uniform"
                              Width="21"
                              Height="21"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="User Details"
                                   Style="{StaticResource HeaderStyle}"/>
                        <TextBlock Text="View user profile and access information"
                                   Style="{StaticResource CaptionStyle}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="{StaticResource ContentMargin}">
                <StackPanel>
                    <controls:InformationPerson Person="{Binding Person}"
                                                Margin="0,0,0,20"/>
                    <controls:UserCard DataContext="{Binding}"/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="{StaticResource SurfaceColor}"
                    Padding="{StaticResource FooterPadding}"
                    CornerRadius="0,0,16,16"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,1,0,0">
                <Button Content="Close"
                        HorizontalAlignment="Right"
                        Click="CloseButton_Click"
                        Style="{StaticResource SecondaryButtonStyle}"/>
            </Border>
        </Grid>
    </Border>
</Window>