<Window x:Class="Presentation.Views.Windows.ReferenceData.EditLicenseClassWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit License Class" Width="620" Height="680"
        MinWidth="540" MinHeight="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource BackgroundColor}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="REFERENCE DATA" Style="{StaticResource CaptionStyle}" Foreground="{StaticResource PrimaryColor}"/>
            <TextBlock Text="Edit license class" Style="{StaticResource PageTitleStyle}" Margin="0,4,0,0"/>
            <TextBlock Text="Updates are validated by DVLD before they are saved."
                       Style="{StaticResource CaptionStyle}" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="22">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel DataContext="{Binding CurrentLicenseClass}">
                    <TextBlock Text="CLASS NAME" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding LicenseClassName, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}"
                             MaxLength="100" Height="42" VerticalContentAlignment="Center"/>

                    <TextBlock Text="DESCRIPTION" Style="{StaticResource LabelStyle}" Margin="0,18,0,6"/>
                    <TextBox Text="{Binding LicenseClassDescription, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}"
                             MaxLength="500" Height="88" Padding="12,9" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="MINIMUM AGE" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding MinAllowedAge, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}"
                                     Height="42" VerticalContentAlignment="Center" MaxLength="3"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="VALIDITY (YEARS)" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding DefaultValidityLength, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}"
                                     Height="42" VerticalContentAlignment="Center" MaxLength="3"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="LICENSE FEE (JOD)" Style="{StaticResource LabelStyle}" Margin="0,18,0,6"/>
                    <TextBox Text="{Binding LicenseClassFees, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F2}, ValidatesOnExceptions=True, NotifyOnValidationError=True}"
                             Height="42" VerticalContentAlignment="Center" MaxLength="20"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding CloseCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    MinWidth="100" Margin="0,0,10,0"/>
            <Button Content="Save changes"
                    Command="{Binding SaveCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    MinWidth="130">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSaving}" Value="True">
                                <Setter Property="Content" Value="Saving…"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>
