<Window x:Class="Presentation.Views.Windows.LicenseHistoryWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Presentation.Views.Controls"
        Title="License History"
        Height="760" Width="1100"
        MinHeight="680" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize">

    <Border Margin="14"
            Background="{StaticResource SurfaceColor}"
            BorderBrush="{StaticResource BorderColor}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusLarge}"
            Effect="{StaticResource ElevationShadow3}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="82"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="72"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource PrimarySoftColor}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="16,16,0,0"
                    Padding="24,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="48" Height="48"
                            CornerRadius="{StaticResource RadiusMedium}"
                            Background="{StaticResource PrimaryColor}"
                            Margin="0,0,14,0">
                        <Path Data="M6,2H18A2,2 0,0 1,20 4V20A2,2 0,0 1,18 22H6A2,2 0,0 1,4 20V4A2,2 0,0 1,6 2M8,6H16V8H8V6M8,10H16V12H8V10M8,14H13V16H8V14Z"
                              Fill="White" Width="22" Height="22"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="License History"
                                   FontSize="{StaticResource FontSizeHeader}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryColor}"/>
                        <TextBlock Text="Review local and international licenses for this person"
                                   Margin="0,3,0,0"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{StaticResource TextMutedColor}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,22">

                    <controls:InformationPerson x:Name="ucPersonInfo"
                                                Margin="0,0,0,20"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{StaticResource SurfaceColor}"
                                BorderBrush="{StaticResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusLarge}"
                                Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Local Licenses"
                                                   FontSize="{StaticResource FontSizeBody}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryColor}"/>
                                        <TextBlock Text="Issued driving licenses"
                                                   Margin="0,3,0,0"
                                                   FontSize="{StaticResource FontSizeCaption}"
                                                   Foreground="{StaticResource TextMutedColor}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Background="{StaticResource PrimaryLightColor}"
                                            CornerRadius="{StaticResource RadiusPill}"
                                            Padding="10,5">
                                        <TextBlock Text="{Binding LocalLicenses.Count}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryColor}"/>
                                    </Border>
                                </Grid>

                                <DataGrid Grid.Row="1"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          ItemsSource="{Binding LocalLicenses}"
                                          SelectedItem="{Binding SelectedLocalLicense}"
                                          RowHeaderWidth="0"
                                          HeadersVisibility="Column"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          SelectionMode="Single"
                                          MouseRightButtonUp="Row_RightClick"
>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="License ID" Binding="{Binding LicenseId}" Width="90"/>
                                        <DataGridTextColumn Header="Class" Binding="{Binding LicenseClassName}" Width="*"/>
                                        <DataGridTextColumn Header="Issue Date" Binding="{Binding IssueDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="120"/>
                                        <DataGridTextColumn Header="Expiration" Binding="{Binding ExpirationDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="120"/>
                                    </DataGrid.Columns>
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Show License"
                                                      Command="{Binding PlacementTarget.DataContext.ShowLicenseCommand,
                                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2"
                                Background="{StaticResource SurfaceColor}"
                                BorderBrush="{StaticResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusLarge}"
                                Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="International Licenses"
                                                   FontSize="{StaticResource FontSizeBody}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryColor}"/>
                                        <TextBlock Text="International driving permits"
                                                   Margin="0,3,0,0"
                                                   FontSize="{StaticResource FontSizeCaption}"
                                                   Foreground="{StaticResource TextMutedColor}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Background="{StaticResource InfoLightColor}"
                                            CornerRadius="{StaticResource RadiusPill}"
                                            Padding="10,5">
                                        <TextBlock Text="{Binding InternationalLicenses.Count}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource InfoColor}"/>
                                    </Border>
                                </Grid>

                                <DataGrid Grid.Row="1"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          ItemsSource="{Binding InternationalLicenses}"
                                          SelectedItem="{Binding SelectedInternationalLicense}"
                                          RowHeaderWidth="0"
                                          HeadersVisibility="Column"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          SelectionMode="Single"
>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID" Binding="{Binding InternationalLicenseId}" Width="80"/>
                                        <DataGridTextColumn Header="Local License" Binding="{Binding IssuedUsingLocalLicenseId}" Width="100"/>
                                        <DataGridTextColumn Header="Issue Date" Binding="{Binding IssueDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="120"/>
                                        <DataGridTextColumn Header="Expiration" Binding="{Binding ExpirationDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="120"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="{StaticResource SurfaceSecondaryColor}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,16,16"
                    Padding="24,12">
                <Grid>
                    <TextBlock Text="Right-click a local license to view its details."
                               VerticalAlignment="Center"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{StaticResource TextMutedColor}"/>
                    <Button Grid.Column="1"
                            Content="Close"
                            HorizontalAlignment="Right"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="btnClose_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>