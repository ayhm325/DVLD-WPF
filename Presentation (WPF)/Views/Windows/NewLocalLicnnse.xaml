<Window x:Class="Presentation.Views.Windows.NewLocalLicnnse"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Presentation.Views.Controls"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="New Local Driving License Application"
        Height="700"
        Width="870"
        MinHeight="650"
        MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundColor}"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="ValueTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="InfoIconBox" TargetType="Border">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}"/>
            <Setter Property="Background" Value="{StaticResource PrimaryLightColor}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource SurfaceColor}"
            BorderBrush="{StaticResource BorderColor}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusLarge}"
            Margin="16"
            Effect="{StaticResource ElevationShadow3}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ================= الهيدر ================= -->
            <Border Grid.Row="0"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,0,0,1"
                    Padding="{StaticResource CardPadding}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40"
                            Height="40"
                            CornerRadius="{StaticResource RadiusMedium}"
                            Background="{StaticResource PrimaryLightColor}"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="FileDocumentPlusOutline"
                                                 Foreground="{StaticResource PrimaryColor}"
                                                 Width="20"
                                                 Height="20"
                                                 VerticalAlignment="Center"
                                                 HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="New Local Driving License Application"
                               Style="{StaticResource HeaderStyle}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ================= المحتوى ================= -->
            <Grid Grid.Row="1" Margin="{StaticResource CardPadding}">
                <TabControl x:Name="MainTabControl"
                            Background="Transparent"
                            BorderThickness="0">

                    <TabItem Header="Personal Info"
                             Style="{StaticResource TabItemStyle}">
                        <DockPanel Margin="0,12,0,12"
                                   LastChildFill="True">
                            <controls:Filter DockPanel.Dock="Top"
                                              Margin="0,0,0,12"/>
                            <Button DockPanel.Dock="Bottom"
                                    Content="Next"
                                    HorizontalAlignment="Right"
                                    Margin="0,12,0,0"
                                    Click="NextButton_Click"
                                    Style="{StaticResource PrimaryButtonStyle}"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <controls:InformationPerson Person="{Binding Person}"/>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="Application Info"
                             Style="{StaticResource TabItemStyle}">
                        <Border Style="{StaticResource CardStyle}"
                                Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- D.L. Application ID -->
                                <Border Style="{StaticResource InfoIconBox}"
                                        Grid.Row="0"
                                        Grid.Column="0">
                                    <materialDesign:PackIcon Kind="Identifier"
                                                             Foreground="{StaticResource PrimaryColor}"
                                                             Width="18"
                                                             Height="18"
                                                             VerticalAlignment="Center"
                                                             HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Text="D.L. Application ID"
                                           Style="{StaticResource LabelStyle}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,16,0"/>
                                <TextBlock Grid.Row="0"
                                           Grid.Column="2"
                                           Text="{Binding ApplicationId}"
                                           Style="{StaticResource ValueTextStyle}"
                                           VerticalAlignment="Center"/>

                                <!-- Application Date -->
                                <Border Style="{StaticResource InfoIconBox}"
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="0,12,0,0">
                                    <materialDesign:PackIcon Kind="Calendar"
                                                             Foreground="{StaticResource PrimaryColor}"
                                                             Width="18"
                                                             Height="18"
                                                             VerticalAlignment="Center"
                                                             HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text="Application Date"
                                           Style="{StaticResource LabelStyle}"
                                           VerticalAlignment="Center"
                                           Margin="0,12,16,0"/>
                                <TextBlock Grid.Row="1"
                                           Grid.Column="2"
                                           Text="{Binding ApplicationDate, StringFormat='{}{0:dd/MM/yyyy}'}"
                                           Style="{StaticResource ValueTextStyle}"
                                           VerticalAlignment="Center"
                                           Margin="0,12,0,0"/>

                                <!-- License Class -->
                                <Border Style="{StaticResource InfoIconBox}"
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Margin="0,12,0,0">
                                    <materialDesign:PackIcon Kind="Car"
                                                             Foreground="{StaticResource PrimaryColor}"
                                                             Width="18"
                                                             Height="18"
                                                             VerticalAlignment="Center"
                                                             HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           Text="License Class"
                                           Style="{StaticResource LabelStyle}"
                                           VerticalAlignment="Center"
                                           Margin="0,12,16,0"/>

                                <ComboBox Grid.Row="2"
                                            Grid.Column="2"
                                            ItemsSource="{Binding LicenseClasses}"
                                            SelectedItem="{Binding SelectedLicenseClass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            MinWidth="250"
                                            Height="40"
                                            VerticalAlignment="Center"
                                            Margin="0,12,0,0">
                                    
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding LicenseClassName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- Application Fees -->
                                <Border Style="{StaticResource InfoIconBox}"
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        Margin="0,12,0,0">
                                    <materialDesign:PackIcon Kind="Cash"
                                                             Foreground="{StaticResource PrimaryColor}"
                                                             Width="18"
                                                             Height="18"
                                                             VerticalAlignment="Center"
                                                             HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Row="3"
                                           Grid.Column="1"
                                           Text="Application Fees"
                                           Style="{StaticResource LabelStyle}"
                                           VerticalAlignment="Center"
                                           Margin="0,12,16,0"/>
                                <TextBlock Grid.Row="3"
                                           Grid.Column="2"
                                           Text="{Binding ApplicationTypeFees, StringFormat='{}{0:F2}'}"
                                           Style="{StaticResource ValueTextStyle}"
                                           VerticalAlignment="Center"
                                           Margin="0,12,0,0"/>
                            </Grid>
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- ================= شريط الأزرار السفلي ================= -->
            <Border Grid.Row="2"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,1,0,0"
                    Padding="{StaticResource CardPadding}">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Close"
                            Click="CloseButton_Click"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,12,0"/>
                    <Button Content="Save"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</Window>