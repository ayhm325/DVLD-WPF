<Window x:Class="Presentation.Views.Windows.NewLocalLicnnse"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Presentation.Views.Controls"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="New Local Driving License Application"
        Height="700" Width="870" MinHeight="650" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundColor}"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="ValueTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="InfoIconBox" TargetType="Border">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
            <Setter Property="Background" Value="{StaticResource PrimaryLightColor}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource SurfaceColor}" BorderBrush="{StaticResource BorderColor}"
            BorderThickness="1" CornerRadius="{StaticResource RadiusLarge}" Margin="16"
            Effect="{StaticResource ElevationShadow3}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource SurfaceColor}"
                    BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1"
                    Padding="24,18" CornerRadius="16,16,0,0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="{StaticResource RadiusMedium}"
                            Background="{StaticResource PrimaryLightColor}" Margin="0,0,14,0">
                        <materialDesign:PackIcon Kind="FileDocumentPlusOutline"
                                                 Foreground="{StaticResource PrimaryColor}"
                                                 Width="21" Height="21"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="New Local Driving License Application" Style="{StaticResource HeaderStyle}"/>
                        <TextBlock Text="Create a new application and assign its license class"
                                   Style="{StaticResource CaptionStyle}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Margin="24,18">
                <TabControl x:Name="MainTabControl" Background="Transparent" BorderThickness="0">
                    <TabItem Header="Personal Info" Style="{StaticResource TabItemStyle}">
                        <DockPanel Margin="0,12,0,0">
                            <controls:Filter DockPanel.Dock="Top" Margin="0,0,0,14"/>
                            <Button DockPanel.Dock="Bottom" Content="Next"
                                    HorizontalAlignment="Right" Margin="0,14,0,0"
                                    Click="NextButton_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <controls:InformationPerson Person="{Binding Person}"/>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="Application Info" Style="{StaticResource TabItemStyle}">
                        <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Style="{StaticResource InfoIconBox}" Grid.Row="0" Grid.Column="0">
                                    <materialDesign:PackIcon Kind="Identifier" Foreground="{StaticResource PrimaryColor}"
                                                             Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="D.L. Application ID"
                                           Style="{StaticResource LabelStyle}" Margin="0,0,16,0"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding LocalApplicationId}"
                                           Style="{StaticResource ValueTextStyle}"/>

                                <Border Style="{StaticResource InfoIconBox}" Grid.Row="1" Grid.Column="0" Margin="0,12,0,0">
                                    <materialDesign:PackIcon Kind="Calendar" Foreground="{StaticResource PrimaryColor}"
                                                             Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Application Date"
                                           Style="{StaticResource LabelStyle}" Margin="0,12,16,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="2"
                                           Text="{Binding ApplicationDate, StringFormat='{}{0:dd/MM/yyyy}'}"
                                           Style="{StaticResource ValueTextStyle}" Margin="0,12,0,0"/>

                                <Border Style="{StaticResource InfoIconBox}" Grid.Row="2" Grid.Column="0" Margin="0,12,0,0">
                                    <materialDesign:PackIcon Kind="Car" Foreground="{StaticResource PrimaryColor}"
                                                             Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="License Class"
                                           Style="{StaticResource LabelStyle}" Margin="0,12,16,0"/>
                                <ComboBox Grid.Row="2" Grid.Column="2"
                                          ItemsSource="{Binding LicenseClasses}"
                                          SelectedItem="{Binding SelectedLicenseClass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Height="40" Margin="0,12,0,0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding LicenseClassName}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <Border Style="{StaticResource InfoIconBox}" Grid.Row="3" Grid.Column="0" Margin="0,12,0,0">
                                    <materialDesign:PackIcon Kind="Cash" Foreground="{StaticResource PrimaryColor}"
                                                             Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="Application Fees"
                                           Style="{StaticResource LabelStyle}" Margin="0,12,16,0"/>
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding ApplicationFees, StringFormat='{}{0:F2}'}"
                                           Style="{StaticResource ValueTextStyle}" Margin="0,12,0,0"/>
                            </Grid>
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>

            <Border Grid.Row="2" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0"
                    Background="{StaticResource SurfaceSecondaryColor}" Padding="24,15,24,20">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Close" Click="CloseButton_Click"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,12,0"/>
                    <Button Content="Save" Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
