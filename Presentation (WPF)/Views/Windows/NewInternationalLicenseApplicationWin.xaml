<Window x:Class="Presentation.Views.Windows.NewInternationalLicenseApplicationWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Presentation.Views.Controls"
        Title="New International License Application"
        Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        ResizeMode="NoResize" Background="Transparent"
        FontFamily="{StaticResource AppFontFamily}">
    <Border Margin="10" Background="{StaticResource SurfaceColor}"
            BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusXLarge}">
        <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.18"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition Height="*"/><RowDefinition Height="76"/></Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource PrimarySoftColor}"
                    BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1"
                    CornerRadius="16,16,0,0" Padding="26,16">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="50" Height="50" CornerRadius="14" Background="{StaticResource PrimaryColor}">
                            <TextBlock Text="I" Foreground="White" FontSize="25" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="International License" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextColor}"/>
                            <TextBlock Text="Create an international license from an eligible local license"
                                       Margin="0,4,0,0" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryColor}"/>
                        </StackPanel>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Style="{StaticResource GhostButtonStyle}"
                            Click="CloseButton_Click">
                        <TextBlock Text="×" FontSize="24"/>
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="26,22">
                    <Border Style="{StaticResource CardStyle}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Eligible Local License" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextColor}"/>
                            <TextBlock Text="Search for the local license used for the international application."
                                       Margin="0,4,0,16" FontSize="12"
                                       Foreground="{StaticResource TextMutedColor}"/>
                            <controls:DriverLicenseInfo
                                LicenseIdText="{Binding LicenseIdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                SearchCommand="{Binding SearchCommand}"
                                License="{Binding LicenseInfo}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="Application Information" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextColor}"/>
                            <TextBlock Text="Review the international application details returned by the backend."
                                       Margin="0,4,0,14" FontSize="12"
                                       Foreground="{StaticResource TextMutedColor}"/>
                            <controls:ApplicationInfo Application="{Binding ApplicationInfo}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{StaticResource SurfaceSecondaryColor}"
                    BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,16,16" Padding="26,12">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="License History" Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding ShowLicensesHistoryCommand}"
                                IsEnabled="{Binding IsLicenseIssued}"/>
                        <Button Content="License Info" Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding ShowLicensesInfoCommand}"
                                IsEnabled="{Binding IsLicenseIssued}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Issue" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding IssueCommand}" Margin="0,0,10,0"/>
                        <Button Content="Close" Style="{StaticResource SecondaryButtonStyle}"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>