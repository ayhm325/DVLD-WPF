<Window x:Class="Presentation.Views.Windows.Applications.EditApplicationTypeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Update Application Type"
        Height="570"
        Width="560"
        MinHeight="570"
        MinWidth="560"
        MaxHeight="570"
        MaxWidth="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="EditCloseButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="CloseBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBorder"
                                        Property="Background"
                                        Value="{StaticResource DangerLightColor}"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource DangerColor}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CloseBorder"
                                        Property="Background"
                                        Value="{StaticResource DangerColor}"/>
                                <Setter Property="Foreground"
                                        Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EditLabelStyle"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource LabelStyle}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="EditTextBoxStyle"
               TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="EditMultiLineTextBoxStyle"
               TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="82"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>
    </Window.Resources>
    <Border Margin="14"
            Background="{StaticResource BackgroundColor}"
            BorderBrush="{StaticResource BorderColor}"
            BorderThickness="1"
            CornerRadius="22">
        <Border.Effect>
            <DropShadowEffect Color="#000000"
                              BlurRadius="32"
                              ShadowDepth="0"
                              Opacity="0.18"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="86"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="82"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceColor}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="22,22,0,0">
                <Grid Margin="26,0">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Width="48"
                                Height="48"
                                CornerRadius="14"
                                Background="{StaticResource PrimaryLightColor}">
                            <materialDesign:PackIcon Kind="ApplicationEdit"
                                                     Width="23"
                                                     Height="23"
                                                     Foreground="{StaticResource PrimaryColor}"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="15,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="APPLICATION TYPE"
                                       Foreground="{StaticResource PrimaryColor}"
                                       FontSize="10"
                                       FontWeight="Bold"/>
                            <TextBlock Text="Update application type"
                                       Foreground="{StaticResource TextPrimaryColor}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Content="✕"
                            Click="Close_Click"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource EditCloseButtonStyle}"/>
                </Grid>
            </Border>
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="30,28,30,24">
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Application information"
                                       Foreground="{StaticResource TextPrimaryColor}"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Edit the details and pricing for this application type."
                                       Foreground="{StaticResource TextMutedColor}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1"
                                Height="58"
                                Background="{StaticResource SurfaceSecondaryColor}"
                                BorderBrush="{StaticResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="13">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="TYPE ID"
                                               Foreground="{StaticResource TextMutedColor}"
                                               FontSize="9"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding CurrentApplicationType.ApplicationTypeId}"
                                               Foreground="{StaticResource TextPrimaryColor}"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                                <Border Width="7"
                                        Height="7"
                                        CornerRadius="4"
                                        Background="{StaticResource SuccessColor}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <TextBlock Text="TITLE"
                               Style="{StaticResource EditLabelStyle}"/>
                    <TextBlock Text="Name displayed throughout the application."
                               Foreground="{StaticResource TextMutedColor}"
                               FontSize="10"
                               Margin="0,4,0,7"/>
                    <TextBox Text="{Binding CurrentApplicationType.ApplicationTypeTitle,UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource EditMultiLineTextBoxStyle}"
                             Margin="0,0,0,22"/>
                    <TextBlock Text="FEES"
                               Style="{StaticResource EditLabelStyle}"/>
                    <TextBlock Text="Amount charged when this application type is created."
                               Foreground="{StaticResource TextMutedColor}"
                               FontSize="10"
                               Margin="0,4,0,7"/>
                    <Grid>
                        <TextBox Text="{Binding CurrentApplicationType.ApplicationTypeFees,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:F2}}"
                                 Style="{StaticResource EditTextBoxStyle}"
                                 Padding="44,0,70,0"/>
                        <TextBlock Text="$"
                                   Foreground="{StaticResource PrimaryColor}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="15,0,0,0"/>
                        <TextBlock Text="JOD"
                                   Foreground="{StaticResource TextMutedColor}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="0,0,15,0"/>
                    </Grid>
                    <Border Margin="0,25,0,0"
                            Padding="14"
                            Background="{StaticResource PrimaryLightColor}"
                            CornerRadius="12">
                        <Grid>
                            <Border Width="30"
                                    Height="30"
                                    CornerRadius="9"
                                    Background="{StaticResource PrimaryColor}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="InformationOutline"
                                                         Width="16"
                                                         Height="16"
                                                         Foreground="White"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Changes will be applied to new applications using this type."
                                       Foreground="{StaticResource TextPrimaryColor}"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="42,0,5,0"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2"
                    Background="{StaticResource SurfaceColor}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,22,22">
                <Grid Margin="30,0">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left">
                        <Border Width="7"
                                Height="7"
                                CornerRadius="4"
                                Background="{StaticResource SuccessColor}"
                                VerticalAlignment="Center"/>
                        <TextBlock Text="Ready to save changes"
                                   Foreground="{StaticResource TextMutedColor}"
                                   FontSize="10"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Command="{Binding CloseCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                Width="105"
                                Height="40"
                                Margin="0,0,10,0"
                                Style="{StaticResource SecondaryButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Close"
                                                         Width="16"
                                                         Height="16"
                                                         Margin="0,0,7,0"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Cancel"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SaveCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                Width="115"
                                Height="40"
                                Style="{StaticResource PrimaryButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave"
                                                         Width="16"
                                                         Height="16"
                                                         Margin="0,0,7,0"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Save"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>