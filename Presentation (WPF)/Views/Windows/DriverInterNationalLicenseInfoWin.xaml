<Window x:Class="Presentation.Views.Windows.DriverInterNationalLicenseInfoWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="International Driver License Information"
        Height="650" Width="900"
        MinHeight="600" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Border Margin="14"
            Background="{StaticResource SurfaceColor}"
            BorderBrush="{StaticResource BorderColor}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusLarge}"
            Effect="{StaticResource ElevationShadow3}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="76"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="72"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource PrimarySoftColor}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="16,16,0,0"
                    Padding="24,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="46" Height="46"
                            CornerRadius="{StaticResource RadiusMedium}"
                            Background="{StaticResource PrimaryColor}"
                            Margin="0,0,14,0">
                        <Path Data="M12,2A10,10 0,1 0,22 12A10,10 0,0 0,12 2M12,6A2,2 0,1 1,12 10A2,2 0,0 1,12 6M7,17A5,5 0,0 1,17,17"
                              Stroke="White" StrokeThickness="1.6"
                              Fill="Transparent" Stretch="Uniform"
                              Width="23" Height="23"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="International License Details"
                                   FontSize="{StaticResource FontSizeHeader}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryColor}"/>
                        <TextBlock Text="International driving permit information"
                                   Margin="0,3,0,0"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{StaticResource TextMutedColor}"/>
                    </StackPanel>

                    <Border Grid.Column="2"
                            Background="{StaticResource PrimaryLightColor}"
                            CornerRadius="{StaticResource RadiusPill}"
                            Padding="12,6">
                        <TextBlock Foreground="{StaticResource PrimaryColor}"
                                   FontWeight="SemiBold"
                                   FontSize="12">
                            <Run Text="ID: "/>
                            <Run Text="{Binding LicenseData.InternationalLicenseId}"/>
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,22">

                    <Border Background="{StaticResource SurfaceSecondaryColor}"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusLarge}"
                            Padding="18"
                            Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding LicenseData.FullName}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryColor}"/>
                                <TextBlock Text="{Binding LicenseData.NationalNo}"
                                           Margin="0,4,0,0"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           Foreground="{StaticResource TextMutedColor}"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="{StaticResource SuccessLightColor}"
                                    CornerRadius="{StaticResource RadiusPill}"
                                    Padding="12,6">
                                <TextBlock Text="{Binding LicenseData.IsActive}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SuccessColor}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{StaticResource SurfaceColor}"
                                BorderBrush="{StaticResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusLarge}"
                                Padding="18">
                            <StackPanel>
                                <TextBlock Text="Personal Information"
                                           FontSize="{StaticResource FontSizeSubHeader}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryColor}"
                                           Margin="0,0,0,14"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="125"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="Full Name" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LicenseData.FullName}" Margin="0,0,0,14"/>

                                    <TextBlock Grid.Row="1" Text="Date Of Birth" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LicenseData.DateOfBirth, StringFormat='{}{0:dd/MMM/yyyy}'}" Margin="0,0,0,14"/>

                                    <TextBlock Grid.Row="2" Text="Gender" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LicenseData.Gender}" Margin="0,0,0,14"/>

                                    <TextBlock Grid.Row="3" Text="National No." Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LicenseData.NationalNo}" Margin="0,0,0,14"/>

                                    <TextBlock Grid.Row="4" Text="Driver ID" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LicenseData.DriverId}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Background="{StaticResource SurfaceColor}"
                                BorderBrush="{StaticResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusLarge}"
                                Padding="18">
                            <StackPanel>
                                <TextBlock Text="International License"
                                           FontSize="{StaticResource FontSizeSubHeader}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryColor}"
                                           Margin="0,0,0,14"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="Int. License ID" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LicenseData.InternationalLicenseId}" Margin="0,0,0,14"/>

                                    <TextBlock Grid.Row="1" Text="License ID" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LicenseData.IssuedUsingLocalLicenseId}" Margin="0,0,0,14"/>

                                    <TextBlock Grid.Row="2" Text="Application ID" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LicenseData.ApplicationId}" Margin="0,0,0,14"/>

                                    <TextBlock Grid.Row="3" Text="Issue Date" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LicenseData.IssueDate, StringFormat='{}{0:dd/MMM/yyyy}'}" Margin="0,0,0,14"/>

                                    <TextBlock Grid.Row="4" Text="Expiration Date" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LicenseData.ExpirationDate, StringFormat='{}{0:dd/MMM/yyyy}'}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="{StaticResource SurfaceSecondaryColor}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,16,16"
                    Padding="24,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Close"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>