<Page x:Class="Presentation.Views.Pages.InterLAppPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:Presentation.Views.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="International License Applications"
      Background="{StaticResource BackgroundColor}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource SurfaceSecondaryColor}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="{StaticResource SurfaceHoverColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryColor}"/>
            <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style TargetType="{x:Type DataGridCell}">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{StaticResource SelectionForegroundColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type ContextMenu}">
            <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Effect" Value="{StaticResource PopupShadow}"/>
        </Style>

        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
        </Style>
    </Page.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CardStyle}"
                Padding="22"
                Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="INTERNATIONAL LICENSES"
                               FontSize="{StaticResource FontSizeCaption}"
                               FontWeight="{StaticResource FontWeightSemiBold}"
                               Foreground="{StaticResource PrimaryColor}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="International License Applications"
                                   Style="{StaticResource HeaderStyle}"/>
                        <TextBlock Text="  •  "
                                   Style="{StaticResource HeaderStyle}"
                                   Foreground="{StaticResource TextMutedColor}"/>
                        <TextBlock Text="{Binding Applications.Count}"
                                   Style="{StaticResource HeaderStyle}"
                                   Foreground="{StaticResource PrimaryColor}"/>
                    </StackPanel>
                    <TextBlock Text="Manage international driving-license applications"
                               Foreground="{StaticResource TextMutedColor}"
                               FontSize="{StaticResource FontSizeCaption}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="+  Issue New"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding IssueNewCommand}"
                        Width="140"
                        Height="40"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}"
                Padding="12"
                Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="FILTER"
                           FontSize="{StaticResource FontSizeCaption}"
                           FontWeight="{StaticResource FontWeightSemiBold}"
                           Foreground="{StaticResource TextMutedColor}"
                           VerticalAlignment="Center"
                           Margin="0,0,14,0"/>

                <ComboBox Width="180"
                          Height="36"
                          Margin="0,0,12,0"
                          ItemsSource="{Binding Filters}"
                          SelectedItem="{Binding SelectedFilter,Mode=TwoWay}"/>

                <TextBox Width="240"
                         Height="36"
                         Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource CardStyle}"
                Padding="0"
                ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Applications}"
                      SelectedItem="{Binding SelectedApplication}">

                <DataGrid.RowStyle>
                    <Style TargetType="{x:Type DataGridRow}">
                        <Setter Property="Height" Value="46"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="Tag"
                                Value="{Binding DataContext,RelativeSource={RelativeSource AncestorType={x:Type Page}}}"/>
                        <EventSetter Event="MouseRightButtonDown"
                                     Handler="DataGridRow_MouseRightButtonDown"/>

                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu>
                                    <MenuItem Header="Show Person Details"
                                              Command="{Binding PlacementTarget.Tag.ShowPersonDetailsCommand,RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                                    <MenuItem Header="Show License Details"
                                              Command="{Binding PlacementTarget.Tag.ShowLicenseDetailsCommand,RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                                    <MenuItem Header="Show Person License History"
                                              Command="{Binding PlacementTarget.Tag.ShowPersonLicenseHistoryCommand,RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>

                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource SurfaceHoverColor}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource SelectionBackgroundColor}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Int License ID"
                                        Binding="{Binding InternationalLicenseId}"
                                        Width="130"/>
                    <DataGridTextColumn Header="Application ID"
                                        Binding="{Binding ApplicationId}"
                                        Width="130"/>
                    <DataGridTextColumn Header="Driver ID"
                                        Binding="{Binding DriverId}"
                                        Width="100"/>
                    <DataGridTextColumn Header="L.License ID"
                                        Binding="{Binding IssuedUsingLocalLicenseId}"
                                        Width="120"/>
                    <DataGridTextColumn Header="Issue Date"
                                        Binding="{Binding IssueDate,StringFormat='MM/dd/yyyy hh:mm tt'}"
                                        Width="180"/>
                    <DataGridTextColumn Header="Expiration Date"
                                        Binding="{Binding ExpirationDate,StringFormat='MM/dd/yyyy hh:mm tt'}"
                                        Width="190"/>
                    <DataGridTemplateColumn Header="Is Active" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="√"
                                           FontWeight="{StaticResource FontWeightSemiBold}"
                                           FontSize="18"
                                           Foreground="{StaticResource SuccessColor}"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsActive,Converter={StaticResource BoolToVis}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>