<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Presentation.Views.Pages.InterLAppPage"
      Title="International License Applications"
      Background="{StaticResource BackgroundColor}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid Margin="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Style="{StaticResource CardStyle}"
                Padding="22"
                Margin="0,0,0,18">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="INTERNATIONAL LICENSES"
                               FontSize="{StaticResource FontSizeCaption}"
                               FontWeight="{StaticResource FontWeightSemiBold}"
                               Foreground="{StaticResource PrimaryColor}" />

                    <StackPanel Orientation="Horizontal"
                                Margin="0,3,0,0">

                        <TextBlock Text="International License Applications"
                                   Style="{StaticResource HeaderStyle}" />

                        <TextBlock Text="  •  "
                                   Style="{StaticResource HeaderStyle}"
                                   Foreground="{StaticResource TextMutedColor}" />

                        <TextBlock Text="{Binding Applications.Count}"
                                   Style="{StaticResource HeaderStyle}"
                                   Foreground="{StaticResource PrimaryColor}" />

                    </StackPanel>

                    <TextBlock Text="Manage international driving-license applications"
                               Foreground="{StaticResource TextMutedColor}"
                               FontSize="{StaticResource FontSizeCaption}"
                               Margin="0,4,0,0" />

                </StackPanel>

                <Button Grid.Column="1"
                        Content="+  Issue New"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding IssueNewCommand}"
                        Width="140"
                        Height="40"
                        VerticalAlignment="Center" />

            </Grid>

        </Border>

        <!-- Filter -->
        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}"
                Padding="12"
                Margin="0,0,0,16">

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">

                <TextBlock Text="FILTER"
                           FontSize="{StaticResource FontSizeCaption}"
                           FontWeight="{StaticResource FontWeightSemiBold}"
                           Foreground="{StaticResource TextMutedColor}"
                           VerticalAlignment="Center"
                           Margin="0,0,14,0" />

                <ComboBox Width="180"
                          Height="36"
                          Margin="0,0,12,0"
                          ItemsSource="{Binding Filters}"
                          SelectedItem="{Binding SelectedFilter, Mode=TwoWay}" />

                <TextBox Width="240"
                         Height="36"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

            </StackPanel>

        </Border>

        <!-- Applications -->
        <Border Grid.Row="2"
                Style="{StaticResource CardStyle}"
                Padding="0"
                ClipToBounds="True">

            <DataGrid ItemsSource="{Binding Applications}"
                      SelectedItem="{Binding SelectedApplication}">

                <DataGrid.RowStyle>
                    <Style TargetType="{x:Type DataGridRow}"
                           BasedOn="{StaticResource DataGridRowStyle}">

                        <Setter Property="Tag"
                                Value="{Binding DataContext,
                                        RelativeSource={RelativeSource AncestorType={x:Type Page}}}" />

                        <EventSetter Event="MouseRightButtonDown"
                                     Handler="DataGridRow_MouseRightButtonDown" />

                        <Setter Property="ContextMenu">
                            <Setter.Value>

                                <ContextMenu>

                                    <!-- Person Details -->
                                    <MenuItem Header="Show Person Details"
                                              Command="{Binding PlacementTarget.Tag.ShowPersonDetailsCommand,
                                                  RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext,
                                                  RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">

                                        <MenuItem.Icon>
                                            <materialDesign:PackIcon Kind="AccountDetails"
                                                                     Width="18"
                                                                     Height="18"
                                                                     Foreground="{StaticResource PrimaryColor}" />
                                        </MenuItem.Icon>

                                    </MenuItem>

                                    <!-- License Details -->
                                    <MenuItem Header="Show License Details"
                                              Command="{Binding PlacementTarget.Tag.ShowLicenseDetailsCommand,
                                                  RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext,
                                                  RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">

                                        <MenuItem.Icon>
                                            <materialDesign:PackIcon Kind="CardAccountDetails"
                                                                     Width="18"
                                                                     Height="18"
                                                                     Foreground="{StaticResource WarningColor}" />
                                        </MenuItem.Icon>

                                    </MenuItem>

                                    <!-- License History -->
                                    <MenuItem Header="Show Person License History"
                                              Command="{Binding PlacementTarget.Tag.ShowPersonLicenseHistoryCommand,
                                                  RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext,
                                                  RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">

                                        <MenuItem.Icon>
                                            <materialDesign:PackIcon Kind="History"
                                                                     Width="18"
                                                                     Height="18"
                                                                     Foreground="{StaticResource SuccessColor}" />
                                        </MenuItem.Icon>

                                    </MenuItem>

                                </ContextMenu>

                            </Setter.Value>
                        </Setter>

                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Int License ID"
                                        Binding="{Binding InternationalLicenseId}"
                                        Width="130" />

                    <DataGridTextColumn Header="Application ID"
                                        Binding="{Binding ApplicationId}"
                                        Width="130" />

                    <DataGridTextColumn Header="Driver ID"
                                        Binding="{Binding DriverId}"
                                        Width="100" />

                    <DataGridTextColumn Header="L.License ID"
                                        Binding="{Binding IssuedUsingLocalLicenseId}"
                                        Width="120" />

                    <DataGridTextColumn Header="Issue Date"
                                        Binding="{Binding IssueDate,
                                            StringFormat='MM/dd/yyyy hh:mm tt'}"
                                        Width="180" />

                    <DataGridTextColumn Header="Expiration Date"
                                        Binding="{Binding ExpirationDate,
                                            StringFormat='MM/dd/yyyy hh:mm tt'}"
                                        Width="190" />

                    <DataGridTemplateColumn Header="Is Active"
                                            Width="*">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <TextBlock Text="√"
                                           FontWeight="{StaticResource FontWeightSemiBold}"
                                           FontSize="18"
                                           Foreground="{StaticResource SuccessColor}"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsActive,
                                               Converter={StaticResource BoolToVis}}" />

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</Page>