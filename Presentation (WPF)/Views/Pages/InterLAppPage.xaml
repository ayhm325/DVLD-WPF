<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:Presentation.Views.Controls" x:Class="Presentation.Views.Pages.InterLAppPage"
      Title="International License Applications"
      Background="{StaticResource BackgroundColor}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
<controls:PageHeader Grid.Row="0" Eyebrow="APPLICATIONS" Heading="International License Applications" Description="Review international license applications and issuance." Metric="{Binding Applications.Count}">
            <controls:PageHeader.ActionContent>
                <Button Content="+  Issue new" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding IssueNewCommand}" Width="140"/>
            </controls:PageHeader.ActionContent>
        </controls:PageHeader>

        <!-- Filter and results workspace -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14"
                VerticalAlignment="Top">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceSecondaryColor}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMedium}"
                Padding="12"
                Margin="0,0,0,12">

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">

                <TextBlock Text="FILTER"
                           FontSize="{StaticResource FontSizeCaption}"
                           FontWeight="{StaticResource FontWeightSemiBold}"
                           Foreground="{StaticResource TextMutedColor}"
                           VerticalAlignment="Center"
                           Margin="0,0,14,0" />

                <ComboBox Width="180"
                          Height="36"
                          Margin="0,0,12,0"
                          ItemsSource="{Binding Filters}"
                          SelectedItem="{Binding SelectedFilter, Mode=TwoWay}" />

                <TextBox Width="240"
                         Height="36"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

            </StackPanel>

        </Border>

        <!-- Applications -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceColor}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMedium}"
                Padding="0"
                ClipToBounds="True"
                VerticalAlignment="Top">

            <Grid>
            <DataGrid x:Name="dgInternationalApplications"
                      ItemsSource="{Binding Applications}"
                      SelectedItem="{Binding SelectedApplication}"
                      VerticalAlignment="Top"
                      MaxHeight="440">

                <DataGrid.RowStyle>
                    <Style TargetType="{x:Type DataGridRow}"
                           BasedOn="{StaticResource DataGridRowStyle}">

                        <Setter Property="Tag"
                                Value="{Binding DataContext,
                                        RelativeSource={RelativeSource AncestorType={x:Type Page}}}" />

                        <EventSetter Event="MouseRightButtonDown"
                                     Handler="DataGridRow_MouseRightButtonDown" />

                        <Setter Property="ContextMenu">
                            <Setter.Value>

                                <ContextMenu>

                                    <!-- Person Details -->
                                    <MenuItem Header="Show Person Details"
                                              Command="{Binding PlacementTarget.Tag.ShowPersonDetailsCommand,
                                                  RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext,
                                                  RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">

                                        <MenuItem.Icon>
                                            <materialDesign:PackIcon Kind="AccountDetails"
                                                                     Width="18"
                                                                     Height="18"
                                                                     Foreground="{StaticResource PrimaryColor}" />
                                        </MenuItem.Icon>

                                    </MenuItem>

                                    <!-- License Details -->
                                    <MenuItem Header="Show License Details"
                                              Command="{Binding PlacementTarget.Tag.ShowLicenseDetailsCommand,
                                                  RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext,
                                                  RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">

                                        <MenuItem.Icon>
                                            <materialDesign:PackIcon Kind="CardAccountDetails"
                                                                     Width="18"
                                                                     Height="18"
                                                                     Foreground="{StaticResource WarningColor}" />
                                        </MenuItem.Icon>

                                    </MenuItem>

                                    <!-- License History -->
                                    <MenuItem Header="Show Person License History"
                                              Command="{Binding PlacementTarget.Tag.ShowPersonLicenseHistoryCommand,
                                                  RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext,
                                                  RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">

                                        <MenuItem.Icon>
                                            <materialDesign:PackIcon Kind="History"
                                                                     Width="18"
                                                                     Height="18"
                                                                     Foreground="{StaticResource SuccessColor}" />
                                        </MenuItem.Icon>

                                    </MenuItem>

                                </ContextMenu>

                            </Setter.Value>
                        </Setter>

                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>

                    <DataGridTemplateColumn Header="Photo" Width="70" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <controls:PersonPhotoAvatar PersonId="{Binding PersonId}"
                                                            HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Int License ID"
                                        Binding="{Binding InternationalLicenseId}"
                                        Width="130" />

                    <DataGridTextColumn Header="Application ID"
                                        Binding="{Binding ApplicationId}"
                                        Width="130" />

                    <DataGridTextColumn Header="Driver ID"
                                        Binding="{Binding DriverId}"
                                        Width="100" />

                    <DataGridTextColumn Header="L.License ID"
                                        Binding="{Binding IssuedUsingLocalLicenseId}"
                                        Width="120" />

                    <DataGridTextColumn Header="Issue Date"
                                        Binding="{Binding IssueDate,
                                            StringFormat='MM/dd/yyyy hh:mm tt'}"
                                        Width="180" />

                    <DataGridTextColumn Header="Expiration Date"
                                        Binding="{Binding ExpirationDate,
                                            StringFormat='MM/dd/yyyy hh:mm tt'}"
                                        Width="190" />

                    <DataGridTemplateColumn Header="Is Active"
                                            Width="*">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <TextBlock Text="√"
                                           FontWeight="{StaticResource FontWeightSemiBold}"
                                           FontSize="18"
                                           Foreground="{StaticResource SuccessColor}"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsActive,
                                               Converter={StaticResource BoolToVis}}" />

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>
                <Border MinHeight="150" Background="{StaticResource SurfaceColor}" CornerRadius="{StaticResource RadiusMedium}"
                        Padding="20">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems, ElementName=dgInternationalApplications}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="No international license applications found." Style="{StaticResource CaptionStyle}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>

        </Border>
            </Grid>
        </Border>

    </Grid>

</Page>

