<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:Presentation.Views.Controls" x:Class="Presentation.Views.PeoplePage"
      Title="PeoplePage"
      Background="{StaticResource BackgroundColor}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
<controls:PageHeader Grid.Row="0" Eyebrow="PEOPLE" Heading="People Management" Description="Maintain personal records, nationality, and contact details." Metric="{Binding PeopleCount}">
            <controls:PageHeader.ActionContent>
                <Button Content="+  Add Person" Style="{StaticResource PrimaryButtonStyle}" Width="142" Click="AddPerson_Click"/>
            </controls:PageHeader.ActionContent>
        </controls:PageHeader>

        <!-- People -->
        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}"
                Padding="20"
                ClipToBounds="True"
                VerticalAlignment="Top">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Filter -->
                <Border Grid.Row="0"
                        Background="{StaticResource SurfaceSecondaryColor}"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMedium}"
                        Padding="12"
                        Margin="0,0,0,16">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="FILTER"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   FontWeight="{StaticResource FontWeightSemiBold}"
                                   Foreground="{StaticResource TextMutedColor}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,14,0" />

                        <ComboBox ItemsSource="{Binding FilterTypes}"
                                  SelectedItem="{Binding SelectedFilterType}"
                                  Width="160"
                                  Height="36"
                                  Margin="0,0,12,0" />

                        <TextBox Text="{Binding SearchText,
                                               UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{Binding SearchToolTip}"
                                 Visibility="{Binding IsSearchTextVisible,
                                     Converter={StaticResource BoolToVis}}"
                                 Width="230"
                                 Height="36" />

                        <ComboBox ItemsSource="{Binding GenderOptions}"
                                  SelectedItem="{Binding SelectedGender}"
                                  Visibility="{Binding IsGenderComboVisible,
                                      Converter={StaticResource BoolToVis}}"
                                  Width="130"
                                  Height="36" />

                    </StackPanel>

                </Border>

                <!-- DataGrid -->
                <Grid Grid.Row="1">
                    <DataGrid x:Name="dgPeople"
                              ItemsSource="{Binding FilteredPeople}"
                              SelectedItem="{Binding SelectedPerson, Mode=TwoWay}"
                              VerticalAlignment="Top"
                              MaxHeight="440">

                    <DataGrid.RowStyle>

                        <Style TargetType="{x:Type DataGridRow}"
                               BasedOn="{StaticResource DataGridRowStyle}">

                            <!-- ViewModel reference -->
                            <Setter Property="Tag"
                                    Value="{Binding DataContext,
                                        RelativeSource={RelativeSource AncestorType={x:Type Page}}}" />

                            <!-- Context Menu -->
                            <Setter Property="ContextMenu">

                                <Setter.Value>

                                    <ContextMenu>

                                        <!-- Show Details -->
                                        <MenuItem Header="Show Details"
                                                  Command="{Binding PlacementTarget.Tag.ShowDetailsCommand,
                                                      RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                                      RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">

                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="EyeOutline"
                                                                         Width="18"
                                                                         Height="18"
                                                                         Foreground="{StaticResource PrimaryColor}" />
                                            </MenuItem.Icon>

                                        </MenuItem>

                                        <Separator />

                                        <!-- Add Person -->
                                        <MenuItem Header="Add New Person"
                                                  Command="{Binding PlacementTarget.Tag.AddNewPersonCommand,
                                                      RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">

                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="AccountPlusOutline"
                                                                         Width="18"
                                                                         Height="18"
                                                                         Foreground="{StaticResource SuccessColor}" />
                                            </MenuItem.Icon>

                                        </MenuItem>

                                        <!-- Edit -->
                                        <MenuItem Header="Edit"
                                                  Command="{Binding PlacementTarget.Tag.EditPersonCommand,
                                                      RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                                      RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">

                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="PencilOutline"
                                                                         Width="18"
                                                                         Height="18"
                                                                         Foreground="{StaticResource WarningColor}" />
                                            </MenuItem.Icon>

                                        </MenuItem>

                                        <!-- Delete -->
                                        <MenuItem Header="Delete"
                                                  Command="{Binding PlacementTarget.Tag.DeletePersonCommand,
                                                      RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                                      RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">

                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="DeleteOutline"
                                                                         Width="18"
                                                                         Height="18"
                                                                         Foreground="{StaticResource DangerColor}" />
                                            </MenuItem.Icon>

                                        </MenuItem>

                                        <Separator />

                                        <!-- Send Email -->
                                        <MenuItem Header="Send Email"
                                                  Command="{Binding PlacementTarget.Tag.SendEmailCommand,
                                                      RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                                      RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">

                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="EmailOutline"
                                                                         Width="18"
                                                                         Height="18"
                                                                         Foreground="{StaticResource InfoColor}" />
                                            </MenuItem.Icon>

                                        </MenuItem>

                                        <!-- Phone Call -->
                                        <MenuItem Header="Phone Call"
                                                  Command="{Binding PlacementTarget.Tag.PhoneCallCommand,
                                                      RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                                      RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">

                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="PhoneOutline"
                                                                         Width="18"
                                                                         Height="18"
                                                                         Foreground="{StaticResource SuccessColor}" />
                                            </MenuItem.Icon>

                                        </MenuItem>

                                    </ContextMenu>

                                </Setter.Value>

                            </Setter>

                        </Style>

                    </DataGrid.RowStyle>

                    <!-- Columns -->
                    <DataGrid.Columns>

                        <DataGridTemplateColumn Header="Photo" Width="72" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:PersonPhotoAvatar PersonId="{Binding PersonId}"
                                                                HasPhoto="{Binding HasPhoto}"
                                                                HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="ID"
                                            Binding="{Binding PersonId}"
                                            Width="60" />

                        <DataGridTextColumn Header="National No"
                                            Binding="{Binding NationalNo}"
                                            Width="110" />

                        <DataGridTextColumn Header="Full Name"
                                            Binding="{Binding FullName}"
                                            Width="*" />

                        <DataGridTextColumn Header="Date Of Birth"
                                            Binding="{Binding DateOfBirth,
                                                StringFormat={}{0:dd/MM/yyyy}}"
                                            Width="125" />

                        <DataGridTextColumn Header="Gender"
                                            Binding="{Binding Gender}"
                                            Width="80" />

                        <DataGridTextColumn Header="Address"
                                            Binding="{Binding Address}"
                                            Width="250" />

                        <DataGridTextColumn Header="Phone"
                                            Binding="{Binding Phone}"
                                            Width="120" />

                        <DataGridTextColumn Header="Email"
                                            Binding="{Binding Email}"
                                            Width="170" />

                        <DataGridTextColumn Header="Country"
                                            Binding="{Binding CountryName}"
                                            Width="120" />

                    </DataGrid.Columns>

                    </DataGrid>
                    <Border HorizontalAlignment="Stretch" MinHeight="150" Background="{StaticResource SurfaceColor}"
                            CornerRadius="{StaticResource RadiusMedium}" Padding="20">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNoPeople}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="No people match the current filters." Style="{StaticResource CaptionStyle}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Background="{StaticResource DangerLightColor}"
                            BorderBrush="{StaticResource DangerColor}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMedium}" Padding="16"
                            Visibility="{Binding HasLoadError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding LoadErrorMessage}" Foreground="{StaticResource DangerColor}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </Border>
                    <Border Background="{StaticResource SurfaceColor}"
                            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar Width="140" Height="5" IsIndeterminate="True"/>
                            <TextBlock Text="Loading people…" Style="{StaticResource CaptionStyle}"
                                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>

        </Border>

    </Grid>

</Page>

