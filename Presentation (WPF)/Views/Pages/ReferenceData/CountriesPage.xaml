<Page xmlns:controls="clr-namespace:Presentation.Views.Controls" x:Class="Presentation.Views.Pages.ReferenceData.CountriesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Countries"
      Background="{StaticResource BackgroundColor}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

<controls:PageHeader Grid.Row="0" Eyebrow="REFERENCE DATA" Heading="Countries" Description="Browse the country list used when maintaining people records. This data is read-only." Metric="{Binding Countries.Count}"/>
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14" VerticalAlignment="Top">
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource SurfaceSecondaryColor}"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusMedium}" Padding="12"
                Margin="0,0,0,12">
            <DockPanel LastChildFill="False">
                <TextBlock Text="SEARCH" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <TextBox Width="320" Height="40" VerticalContentAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search by country name"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Countries.Count, StringFormat={}{0} countries}"
                           Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" Margin="18,0,0,0"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource SurfaceColor}"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusMedium}" Padding="0" VerticalAlignment="Top">
            <Grid>
                <DataGrid ItemsSource="{Binding FilteredCountries}"
                          VerticalAlignment="Top"
                          MaxHeight="440"
                          IsReadOnly="True"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding CountryId}" Width="110"/>
                        <DataGridTextColumn Header="Country" Binding="{Binding CountryName}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Border Background="{StaticResource SurfaceColor}" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="20" CornerRadius="{StaticResource RadiusMedium}"
                        Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <ProgressBar Width="90" Height="6" IsIndeterminate="True" VerticalAlignment="Center"/>
                        <TextBlock Text="Loading countries…" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="No countries match your search." HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource TextMutedColor}" IsHitTestVisible="False"
                           Visibility="{Binding HasNoResults, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </Border>
        </Grid>
        </Border>
    </Grid>
</Page>


