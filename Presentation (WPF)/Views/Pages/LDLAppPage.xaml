<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Presentation.Views.Pages.LDLAppPage"
      Title="Driving License Applications"
      Background="{StaticResource BackgroundColor}">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Style="{StaticResource CardStyle}"
                Padding="22"
                Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="LOCAL LICENSE APPLICATIONS"
                               FontSize="{StaticResource FontSizeCaption}"
                               FontWeight="{StaticResource FontWeightSemiBold}"
                               Foreground="{StaticResource PrimaryColor}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="Driving License Applications"
                                   Style="{StaticResource HeaderStyle}"/>
                        <TextBlock Text="  •  "
                                   Style="{StaticResource HeaderStyle}"
                                   Foreground="{StaticResource TextMutedColor}"/>
                        <TextBlock Text="{Binding Applications.Count}"
                                   Style="{StaticResource HeaderStyle}"
                                   Foreground="{StaticResource PrimaryColor}"/>
                    </StackPanel>

                    <TextBlock Text="Manage local driving-license application workflows"
                               Foreground="{StaticResource TextMutedColor}"
                               FontSize="{StaticResource FontSizeCaption}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="+  Add New"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding AddNewCommand}"
                        Width="140"
                        Height="40"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Filter -->
        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}"
                Padding="12"
                Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">

                <TextBlock Text="FILTER"
                           FontSize="{StaticResource FontSizeCaption}"
                           FontWeight="{StaticResource FontWeightSemiBold}"
                           Foreground="{StaticResource TextMutedColor}"
                           VerticalAlignment="Center"
                           Margin="0,0,14,0"/>

                <ComboBox Width="150"
                          Height="36"
                          Margin="0,0,12,0"
                          SelectedItem="{Binding SelectedFilter, Mode=TwoWay}">
                    <ComboBoxItem Content="Full Name"/>
                    <ComboBoxItem Content="National No."/>
                </ComboBox>

                <TextBox Width="220"
                         Height="36"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,18,0"/>

                <TextBlock Text="Status"
                           Style="{StaticResource LabelStyle}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <ComboBox Width="145"
                          Height="36"
                          ItemsSource="{Binding StatusFilterOptions}"
                          SelectedItem="{Binding SelectedStatusFilter, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </Border>

        <!-- Applications -->
        <Border Grid.Row="2"
                Style="{StaticResource CardStyle}"
                Padding="0"
                ClipToBounds="True">

            <DataGrid ItemsSource="{Binding Applications}"
                      SelectedItem="{Binding SelectedApplication}">

                <DataGrid.RowStyle>
                    <Style TargetType="{x:Type DataGridRow}"
                           BasedOn="{StaticResource DataGridRowStyle}">

                        <Setter Property="Tag"
                                Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"/>

                        <EventSetter Event="MouseRightButtonDown"
                                     Handler="DataGridRow_MouseRightButtonDown"/>

                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu>

                                    <MenuItem Header="Show Application Details"
                                              Command="{Binding PlacementTarget.Tag.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">
                                        <MenuItem.Icon>
                                            <materialDesign:PackIcon Kind="FileDocumentOutline"
                                                                     Width="18"
                                                                     Height="18"
                                                                     Foreground="{StaticResource PrimaryColor}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>

                                    <Separator/>

                                    <MenuItem Header="Edit Application"
                                              Command="{Binding PlacementTarget.Tag.EditCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">
                                        <MenuItem.Icon>
                                            <materialDesign:PackIcon Kind="PencilOutline"
                                                                     Width="18"
                                                                     Height="18"
                                                                     Foreground="{StaticResource WarningColor}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>

                                    <MenuItem Header="Delete Application"
                                              Command="{Binding PlacementTarget.Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext.LocalDrivingLicenseApplicationId, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">
                                        <MenuItem.Icon>
                                            <materialDesign:PackIcon Kind="DeleteOutline"
                                                                     Width="18"
                                                                     Height="18"
                                                                     Foreground="{StaticResource DangerColor}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>

                                    <MenuItem Header="Cancel Application"
                                              Command="{Binding PlacementTarget.Tag.CancelCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext.LocalDrivingLicenseApplicationId, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">
                                        <MenuItem.Icon>
                                            <materialDesign:PackIcon Kind="Cancel"
                                                                     Width="18"
                                                                     Height="18"
                                                                     Foreground="{StaticResource DangerColor}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>

                                    <Separator/>

                                    <MenuItem Header="Schedule Tests"
                                              IsEnabled="{Binding PlacementTarget.Tag.CanScheduleTests, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">
                                        <MenuItem.Icon>
                                            <materialDesign:PackIcon Kind="CalendarClock"
                                                                     Width="18"
                                                                     Height="18"
                                                                     Foreground="{StaticResource InfoColor}"/>
                                        </MenuItem.Icon>

                                        <MenuItem Header="Schedule Vision Test"
                                                  Command="{Binding PlacementTarget.Tag.ScheduleVisionCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="EyeOutline"
                                                                         Width="18"
                                                                         Height="18"
                                                                         Foreground="{StaticResource PrimaryColor}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>

                                        <MenuItem Header="Schedule Written Test"
                                                  Command="{Binding PlacementTarget.Tag.ScheduleWrittenCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="FileDocumentEditOutline"
                                                                         Width="18"
                                                                         Height="18"
                                                                         Foreground="{StaticResource InfoColor}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>

                                        <MenuItem Header="Schedule Street Test"
                                                  Command="{Binding PlacementTarget.Tag.ScheduleStreetCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="CarOutline"
                                                                         Width="18"
                                                                         Height="18"
                                                                         Foreground="{StaticResource SuccessColor}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </MenuItem>

                                    <Separator/>

                                    <MenuItem Header="Issue Driving License"
                                              Command="{Binding PlacementTarget.Tag.IssueLicenseCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">
                                        <MenuItem.Icon>
                                            <materialDesign:PackIcon Kind="CardAccountDetailsOutline"
                                                                     Width="18"
                                                                     Height="18"
                                                                     Foreground="{StaticResource SuccessColor}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>

                                    <MenuItem Header="Show License"
                                              Command="{Binding PlacementTarget.Tag.ShowLicenseCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">
                                        <MenuItem.Icon>
                                            <materialDesign:PackIcon Kind="CardAccountDetails"
                                                                     Width="18"
                                                                     Height="18"
                                                                     Foreground="{StaticResource PrimaryColor}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>

                                    <MenuItem Header="Show Person License History"
                                              Command="{Binding PlacementTarget.Tag.ShowHistoryCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">
                                        <MenuItem.Icon>
                                            <materialDesign:PackIcon Kind="History"
                                                                     Width="18"
                                                                     Height="18"
                                                                     Foreground="{StaticResource SuccessColor}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>

                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding LocalDrivingLicenseApplicationId}"
                                        Width="75"/>

                    <DataGridTextColumn Header="Driving Class"
                                        Binding="{Binding LicenseClassName}"
                                        Width="280"/>

                    <DataGridTextColumn Header="National No."
                                        Binding="{Binding NationalNo}"
                                        Width="145"/>

                    <DataGridTextColumn Header="Full Name"
                                        Binding="{Binding FullName}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Date"
                                        Binding="{Binding ApplicationDate, StringFormat=yyyy/MM/dd}"
                                        Width="125"/>

                    <DataGridTextColumn Header="Passed Test"
                                        Binding="{Binding PassedTest}"
                                        Width="125"/>

                    <DataGridTextColumn Header="Status"
                                        Binding="{Binding StatusText}"
                                        Width="135"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Pagination -->
        <Border Grid.Row="3"
                Style="{StaticResource CardStyle}"
                Padding="12"
                Margin="0,12,0,0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding Applications.Count, StringFormat={}{0} applications}"
                           Foreground="{StaticResource TextMutedColor}"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button Content="‹ Previous"
                            Command="{Binding PreviousPageCommand}"
                            IsEnabled="{Binding HasPreviousPage}"
                            MinWidth="100"
                            Height="36"
                            Margin="0,0,10,0"/>

                    <Border Padding="14,7"
                            Background="{StaticResource BackgroundColor}"
                            CornerRadius="4">
                        <TextBlock VerticalAlignment="Center">
                            <Run Text="Page "/>
                            <Run Text="{Binding CurrentPage}"/>
                            <Run Text=" of "/>
                            <Run Text="{Binding TotalPages}"/>
                        </TextBlock>
                    </Border>

                    <Button Content="Next ›"
                            Command="{Binding NextPageCommand}"
                            IsEnabled="{Binding HasNextPage}"
                            MinWidth="100"
                            Height="36"
                            Margin="10,0,0,0"/>
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="{Binding PageSize, StringFormat={}10 per page}"
                           Foreground="{StaticResource TextMutedColor}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

    </Grid>
</Page>