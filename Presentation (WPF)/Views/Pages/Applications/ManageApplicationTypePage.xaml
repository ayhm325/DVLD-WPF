<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Presentation.Views.Pages.Applications.ManageApplicationTypePage"
      Title="Manage Application Types"
      Background="{StaticResource BackgroundColor}">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Style="{StaticResource CardStyle}"
                Padding="20"
                Margin="0,0,0,20">

            <DockPanel LastChildFill="False">

                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBlock Text="Manage Application Types"
                               Style="{StaticResource HeaderStyle}" />

                    <TextBlock Text="  •  "
                               Foreground="{StaticResource TextMutedColor}"
                               FontSize="{StaticResource FontSizeBody}"
                               VerticalAlignment="Center" />

                    <TextBlock Text="{Binding ApplicationTypes.Count}"
                               Foreground="{StaticResource PrimaryColor}"
                               FontSize="{StaticResource FontSizeBody}"
                               FontWeight="{StaticResource FontWeightSemiBold}"
                               VerticalAlignment="Center" />

                    <TextBlock Text=" records"
                               Foreground="{StaticResource TextMutedColor}"
                               FontSize="{StaticResource FontSizeCaption}"
                               VerticalAlignment="Center"
                               Margin="4,0,0,0" />

                </StackPanel>

                <Border DockPanel.Dock="Right"
                        Background="{StaticResource PrimarySoftColor}"
                        BorderBrush="{StaticResource PrimaryLightColor}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusSmall}"
                        Padding="10,6">

                    <TextBlock Text="Right-click a record to edit"
                               Foreground="{StaticResource PrimaryColor}"
                               FontSize="{StaticResource FontSizeCaption}"
                               FontWeight="{StaticResource FontWeightSemiBold}" />

                </Border>

            </DockPanel>

        </Border>

        <!-- Application Types DataGrid -->
        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}"
                Padding="0">

            <DataGrid x:Name="dgAppType"
                      ItemsSource="{Binding ApplicationTypes}"
                      SelectionMode="Single"
                      SelectionUnit="FullRow">

                <!-- Context Menu -->
                <DataGrid.ContextMenu>
                    <ContextMenu>

                        <MenuItem Header="Edit Application Type"
                                  Command="{Binding EditApplicationTypeCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}">

                            <MenuItem.Icon>
                                <materialDesign:PackIcon Kind="PencilOutline"
                                                         Width="18"
                                                         Height="18"
                                                         Foreground="{StaticResource WarningColor}" />
                            </MenuItem.Icon>

                        </MenuItem>

                    </ContextMenu>
                </DataGrid.ContextMenu>

                <!-- Columns -->
                <DataGrid.Columns>

                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding ApplicationTypeId}"
                                        Width="90" />

                    <DataGridTextColumn Header="Title"
                                        Binding="{Binding ApplicationTypeTitle}"
                                        Width="*" />

                    <DataGridTextColumn Header="Fees"
                                        Binding="{Binding ApplicationTypeFees, StringFormat={}{0:C}}"
                                        Width="160" />

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</Page>