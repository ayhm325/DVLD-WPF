<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:Presentation.Views.Controls" x:Class="Presentation.Views.Pages.Applications.ManageApplicationTypePage"
      Title="Manage Application Types"
      Background="{StaticResource BackgroundColor}">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
<controls:PageHeader Grid.Row="0" Eyebrow="CONFIGURATION" Heading="Application Types" Description="Review configured application categories and fees." Metric="{Binding ApplicationTypes.Count}">
            <controls:PageHeader.ActionContent>
                <Border Background="{StaticResource PrimaryLightColor}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="{StaticResource RadiusPill}" Padding="12,7"><TextBlock Text="Select a row to edit" Foreground="{StaticResource PrimaryColor}" Style="{StaticResource CaptionStyle}"/></Border>
            </controls:PageHeader.ActionContent>
        </controls:PageHeader>

        <!-- Application Types DataGrid -->
        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}"
                Padding="0">
            <Grid>
            <DataGrid x:Name="dgAppType"
                      ItemsSource="{Binding ApplicationTypes}"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}">

                <!-- Context Menu -->
                <DataGrid.ContextMenu>
                    <ContextMenu>

                        <MenuItem Header="Edit Application Type"
                                  Command="{Binding PlacementTarget.Tag.EditApplicationTypeCommand,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}">

                            <MenuItem.Icon>
                                <materialDesign:PackIcon Kind="PencilOutline"
                                                         Width="18"
                                                         Height="18"
                                                         Foreground="{StaticResource WarningColor}" />
                            </MenuItem.Icon>

                        </MenuItem>

                    </ContextMenu>
                </DataGrid.ContextMenu>

                <!-- Columns -->
                <DataGrid.Columns>

                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding ApplicationTypeId}"
                                        Width="90" />

                    <DataGridTextColumn Header="Title"
                                        Binding="{Binding ApplicationTypeTitle}"
                                        Width="*" />

                    <DataGridTextColumn Header="Fees"
                                        Binding="{Binding ApplicationTypeFees, StringFormat={}{0:N2} JOD}"
                                        Width="160" />

                </DataGrid.Columns>

            </DataGrid>
            <Border Background="{StaticResource SurfaceColor}" CornerRadius="{StaticResource RadiusMedium}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems, ElementName=dgAppType}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="No application types to show" Style="{StaticResource SectionTitleStyle}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Configured application types will appear here."
                               Style="{StaticResource CaptionStyle}" Margin="0,5,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            </Grid>
        </Border>

    </Grid>

</Page>


