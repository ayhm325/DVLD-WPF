<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:Presentation.Views.Controls"
      x:Class="Presentation.Views.Pages.ListDetainedLicenses"
      Title="List Detained Licenses"
      Background="{StaticResource BackgroundColor}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Eyebrow="LICENSE MANAGEMENT"
                             Heading="Detained Licenses"
                             Description="Review detention records and manage license release workflows."
                             Metric="{Binding DetainedLicenses.Count}">
            <controls:PageHeader.ActionContent>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Detain" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding DetainCommand}" Width="120" Margin="0,0,10,0"/>
                    <Button Content="Release" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ReleaseDetainCommand}" Width="120"/>
                </StackPanel>
            </controls:PageHeader.ActionContent>
        </controls:PageHeader>

        <Border Grid.Row="1" Background="{StaticResource SurfaceSecondaryColor}"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusMedium}" Padding="12" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="FILTER" Style="{StaticResource LabelStyle}"
                           Margin="0,0,14,0" VerticalAlignment="Center"/>
                <ComboBox Width="160" Margin="0,0,12,0"
                          ItemsSource="{Binding FilterOptions}"
                          SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"
                          VerticalAlignment="Center"/>
                <TextBox Width="230" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search detained licenses" Margin="0,0,12,0"
                         VerticalAlignment="Center"
                         Visibility="{Binding IsSearchVisible, Converter={StaticResource BoolToVis}}"/>
                <ComboBox Width="150" ItemsSource="{Binding ReleaseFilterOptions}"
                          SelectedItem="{Binding SelectedReleaseFilter, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          Visibility="{Binding IsReleaseFilterVisible, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Border>

        <!-- Detained Licenses -->
        <Border Grid.Row="2"
                Style="{StaticResource CardStyle}"
                Padding="0" VerticalAlignment="Top">
            <Grid>

            <DataGrid x:Name="dgDetainedLicenses"
                      ItemsSource="{Binding DetainedLicenses}"
                      VerticalAlignment="Top" MaxHeight="440"
                      SelectedItem="{Binding SelectedDetainedLicense,
                          Mode=TwoWay}"
                      SelectionMode="Single"
                      SelectionUnit="FullRow">

                <DataGrid.RowStyle>

                    <Style TargetType="{x:Type DataGridRow}"
                           BasedOn="{StaticResource DataGridRowStyle}">

                        <!-- ViewModel reference -->
                        <Setter Property="Tag"
                                Value="{Binding DataContext,
                                    RelativeSource={RelativeSource AncestorType={x:Type Page}}}" />

                        <!-- Select row before opening ContextMenu -->
                        <EventSetter Event="MouseRightButtonDown"
                                     Handler="DataGridRow_MouseRightButtonDown" />

                        <!-- Context Menu -->
                        <Setter Property="ContextMenu">

                            <Setter.Value>

                                <ContextMenu>

                                    <!-- Person Details -->
                                    <MenuItem Header="Show Person Details"
                                              Command="{Binding PlacementTarget.Tag.ShowPersonDetailsCommand,
                                                  RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext,
                                                  RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">

                                        <MenuItem.Icon>
                                            <materialDesign:PackIcon Kind="AccountDetails"
                                                                     Width="18"
                                                                     Height="18"
                                                                     Foreground="{StaticResource PrimaryColor}" />
                                        </MenuItem.Icon>

                                    </MenuItem>

                                    <!-- License Details -->
                                    <MenuItem Header="Show License Details"
                                              Command="{Binding PlacementTarget.Tag.ShowLicenseDetailsCommand,
                                                  RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext,
                                                  RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">

                                        <MenuItem.Icon>
                                            <materialDesign:PackIcon Kind="CardAccountDetails"
                                                                     Width="18"
                                                                     Height="18"
                                                                     Foreground="{StaticResource WarningColor}" />
                                        </MenuItem.Icon>

                                    </MenuItem>

                                    <!-- License History -->
                                    <MenuItem Header="Show Person License History"
                                              Command="{Binding PlacementTarget.Tag.ShowPersonLicenseHistoryCommand,
                                                  RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext,
                                                  RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">

                                        <MenuItem.Icon>
                                            <materialDesign:PackIcon Kind="History"
                                                                     Width="18"
                                                                     Height="18"
                                                                     Foreground="{StaticResource SuccessColor}" />
                                        </MenuItem.Icon>

                                    </MenuItem>

                                    <Separator />

                                    <!-- Release License -->
                                    <MenuItem Header="Release Detained License"
                                              Command="{Binding PlacementTarget.Tag.ReleaseDetainedLicenseCommand,
                                                  RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext,
                                                  RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">

                                        <MenuItem.Icon>
                                            <materialDesign:PackIcon Kind="LockOpenVariant"
                                                                     Width="18"
                                                                     Height="18"
                                                                     Foreground="{StaticResource DangerColor}" />
                                        </MenuItem.Icon>

                                    </MenuItem>

                                </ContextMenu>

                            </Setter.Value>

                        </Setter>

                    </Style>

                </DataGrid.RowStyle>

                <!-- Columns -->
                <DataGrid.Columns>

                    <DataGridTemplateColumn Header="Photo" Width="70" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <controls:PersonPhotoAvatar PersonId="{Binding PersonId}"
                                                            HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Detain ID"
                                        Binding="{Binding DetainId}"
                                        Width="90" />

                    <DataGridTextColumn Header="License ID"
                                        Binding="{Binding LicenseId}"
                                        Width="90" />

                    <DataGridTextColumn Header="Detain Date"
                                        Binding="{Binding DetainDate,
                                            StringFormat={}{0:dd/MM/yyyy hh:mm tt}}"
                                        Width="160" />

                    <DataGridTemplateColumn Header="Status" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Detained"/>
                                            <Setter Property="Foreground" Value="{StaticResource WarningColor}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsReleased}" Value="True">
                                                    <Setter Property="Text" Value="Released"/>
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessColor}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Fine Fees"
                                        Binding="{Binding FineFees}"
                                        Width="110" />

                    <DataGridTextColumn Header="Release Date"
                                        Binding="{Binding ReleaseDate,
                                            StringFormat={}{0:dd/MM/yyyy hh:mm tt}}"
                                        Width="160" />

                    <DataGridTextColumn Header="National No"
                                        Binding="{Binding NationalNo}"
                                        Width="140" />

                    <DataGridTextColumn Header="Full Name"
                                        Binding="{Binding FullName}"
                                        Width="*" />

                    <DataGridTextColumn Header="Release App ID"
                                        Binding="{Binding ReleaseApplicationId}"
                                        Width="140" />

                    <DataGridTextColumn Header="Created By"
                                        Binding="{Binding CreatedByUserName}"
                                        Width="150" />

                    <DataGridTextColumn Header="Released By ID"
                                        Binding="{Binding ReleasedByUserId}"
                                        Width="125" />

                </DataGrid.Columns>

            </DataGrid>

            <Border MinHeight="150" Background="{StaticResource SurfaceColor}"
                    CornerRadius="{StaticResource RadiusMedium}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems, ElementName=dgDetainedLicenses}"
                                         Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="No detained licenses found" Style="{StaticResource SectionTitleStyle}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Detention records will appear here when available."
                               Style="{StaticResource CaptionStyle}" Margin="0,5,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            </Grid>

        </Border>

    </Grid>

</Page>
