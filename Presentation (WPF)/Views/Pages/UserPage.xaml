<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:Presentation.Views.Controls" x:Class="Presentation.Views.UserPage"
      Title="UserPage"
      Background="{StaticResource BackgroundColor}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
<controls:PageHeader Grid.Row="0" Eyebrow="ACCESS CONTROL" Heading="Users Management" Description="Manage application users, roles, and account status." Metric="{Binding UsersCount}">
            <controls:PageHeader.ActionContent>
                <Button Content="+  Add New User" Style="{StaticResource PrimaryButtonStyle}" Width="150" Command="{Binding AddNewUserCommand}"/>
            </controls:PageHeader.ActionContent>
        </controls:PageHeader>

        <!-- Users -->
        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}"
                Padding="20"
                ClipToBounds="True">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Filter -->
                <Border Grid.Row="0"
                        Background="{StaticResource SurfaceSecondaryColor}"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMedium}"
                        Padding="12"
                        Margin="0,0,0,16">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="FILTER"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   FontWeight="{StaticResource FontWeightSemiBold}"
                                   Foreground="{StaticResource TextMutedColor}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,14,0" />

                        <ComboBox ItemsSource="{Binding FilterOptions}"
                                  SelectedItem="{Binding SelectedFilterType}"
                                  Width="150"
                                  Height="36"
                                  Margin="0,0,12,0" />

                        <Grid Width="230">

                            <TextBox Text="{Binding SearchText,
                                                   UpdateSourceTrigger=PropertyChanged}"
                                     Height="36"
                                     Visibility="{Binding IsSearchVisible,
                                         Converter={StaticResource BoolToVisibilityConverter}}" />

                            <ComboBox ItemsSource="{Binding StatusOptions}"
                                      SelectedItem="{Binding SelectedStatus}"
                                      Height="36"
                                      Visibility="{Binding IsStatusVisible,
                                          Converter={StaticResource BoolToVisibilityConverter}}" />

                        </Grid>

                    </StackPanel>

                </Border>

                <!-- DataGrid -->
                <DataGrid x:Name="dgUsers" Grid.Row="1"
                          ItemsSource="{Binding Users}"
                          SelectedItem="{Binding SelectedUser}">

                    <DataGrid.RowStyle>

                        <Style TargetType="{x:Type DataGridRow}"
                               BasedOn="{StaticResource DataGridRowStyle}">

                            <!-- ViewModel reference -->
                            <Setter Property="Tag"
                                    Value="{Binding DataContext,
                                        RelativeSource={RelativeSource AncestorType={x:Type Page}}}" />

                            <!-- Context Menu -->
                            <Setter Property="ContextMenu">

                                <Setter.Value>

                                    <ContextMenu>

                                        <!-- Show Details -->
                                        <MenuItem Header="Show Details"
                                                  Command="{Binding PlacementTarget.Tag.ShowDetailsCommand,
                                                      RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                                      RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">

                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="EyeOutline"
                                                                         Width="18"
                                                                         Height="18"
                                                                         Foreground="{StaticResource PrimaryColor}" />
                                            </MenuItem.Icon>

                                        </MenuItem>

                                        <Separator />

                                        <!-- Add User -->
                                        <MenuItem Header="Add New User"
                                                  Command="{Binding PlacementTarget.Tag.AddUserCommand,
                                                      RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">

                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="AccountPlusOutline"
                                                                         Width="18"
                                                                         Height="18"
                                                                         Foreground="{StaticResource SuccessColor}" />
                                            </MenuItem.Icon>

                                        </MenuItem>

                                        <!-- Edit -->
                                        <MenuItem Header="Edit"
                                                  Command="{Binding PlacementTarget.Tag.EditUserCommand,
                                                      RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                                      RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">

                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="PencilOutline"
                                                                         Width="18"
                                                                         Height="18"
                                                                         Foreground="{StaticResource WarningColor}" />
                                            </MenuItem.Icon>

                                        </MenuItem>

                                        <!-- Delete -->
                                        <MenuItem Header="Delete"
                                                  Command="{Binding PlacementTarget.Tag.DeleteUserCommand,
                                                      RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                                      RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">

                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="DeleteOutline"
                                                                         Width="18"
                                                                         Height="18"
                                                                         Foreground="{StaticResource DangerColor}" />
                                            </MenuItem.Icon>

                                        </MenuItem>

                                        <!-- Change Password -->
                                        <MenuItem Header="Change Password"
                                                  Command="{Binding PlacementTarget.Tag.ChangePasswordCommand,
                                                      RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                                      RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">

                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="LockReset"
                                                                         Width="18"
                                                                         Height="18"
                                                                         Foreground="{StaticResource WarningColor}" />
                                            </MenuItem.Icon>

                                        </MenuItem>

                                        <Separator />

                                        <!-- Send Email -->
                                        <MenuItem Header="Send Email"
                                                  Command="{Binding PlacementTarget.Tag.SendEmailCommand,
                                                      RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                                      RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">

                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="EmailOutline"
                                                                         Width="18"
                                                                         Height="18"
                                                                         Foreground="{StaticResource InfoColor}" />
                                            </MenuItem.Icon>

                                        </MenuItem>

                                        <!-- Phone Call -->
                                        <MenuItem Header="Phone Call"
                                                  Command="{Binding PlacementTarget.Tag.PhoneCallCommand,
                                                      RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                                      RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">

                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="PhoneOutline"
                                                                         Width="18"
                                                                         Height="18"
                                                                         Foreground="{StaticResource SuccessColor}" />
                                            </MenuItem.Icon>

                                        </MenuItem>

                                    </ContextMenu>

                                </Setter.Value>

                            </Setter>

                        </Style>

                    </DataGrid.RowStyle>

                    <!-- Columns -->
                    <DataGrid.Columns>

                        <DataGridTemplateColumn Header="Photo" Width="70" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:PersonPhotoAvatar PersonId="{Binding PersonId}"
                                                                HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="User ID"
                                            Binding="{Binding UserId}"
                                            Width="90" />

                        <DataGridTextColumn Header="Person ID"
                                            Binding="{Binding PersonId}"
                                            Width="90" />

                        <DataGridTextColumn Header="Full Name"
                                            Binding="{Binding PersonFullName}"
                                            Width="*" />

                        <DataGridTextColumn Header="User Name"
                                            Binding="{Binding UserName}"
                                            Width="150" />

                        <DataGridTemplateColumn Header="Role" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Unknown"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Role}" Value="1">
                                                        <Setter Property="Text" Value="Staff"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Role}" Value="2">
                                                        <Setter Property="Text" Value="Admin"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Status" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Inactive"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextMutedColor}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Text" Value="Active"/>
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessColor}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>

                <Border Grid.Row="1" Background="{StaticResource SurfaceColor}"
                        CornerRadius="{StaticResource RadiusMedium}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasNoUsers}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="No users to show" Style="{StaticResource SectionTitleStyle}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Add a user or adjust the current filters."
                                   Style="{StaticResource CaptionStyle}" Margin="0,5,0,0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Background="{StaticResource DangerLightColor}"
                        BorderBrush="{StaticResource DangerColor}" BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMedium}" Padding="16"
                        Visibility="{Binding HasLoadError, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding LoadErrorMessage}" Foreground="{StaticResource DangerColor}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                </Border>
                <Border Grid.Row="1" Background="{StaticResource SurfaceColor}"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar Width="140" Height="5" IsIndeterminate="True"/>
                        <TextBlock Text="Loading users…" Style="{StaticResource CaptionStyle}"
                                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

            </Grid>

        </Border>

    </Grid>
</Page>

