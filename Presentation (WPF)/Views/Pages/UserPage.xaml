<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Presentation.Views.UserPage"
      Title="UserPage"
      Background="{StaticResource BackgroundColor}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid Margin="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Style="{StaticResource CardStyle}"
                Padding="22"
                Margin="0,0,0,18">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="USERS"
                               FontSize="{StaticResource FontSizeCaption}"
                               FontWeight="{StaticResource FontWeightSemiBold}"
                               Foreground="{StaticResource PrimaryColor}" />

                    <StackPanel Orientation="Horizontal"
                                Margin="0,3,0,0">

                        <TextBlock Text="Users Management"
                                   Style="{StaticResource HeaderStyle}" />

                        <TextBlock Text="  •  "
                                   Style="{StaticResource HeaderStyle}"
                                   Foreground="{StaticResource TextMutedColor}" />

                        <TextBlock Text="{Binding UsersCount}"
                                   Style="{StaticResource HeaderStyle}"
                                   Foreground="{StaticResource PrimaryColor}" />

                    </StackPanel>

                    <TextBlock Text="Manage application users and access status"
                               Foreground="{StaticResource TextMutedColor}"
                               FontSize="{StaticResource FontSizeCaption}"
                               Margin="0,4,0,0" />

                </StackPanel>

                <Button Grid.Column="1"
                        Content="+  Add New User"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="150"
                        Height="40"
                        Command="{Binding AddNewUserCommand}"
                        VerticalAlignment="Center" />

            </Grid>

        </Border>

        <!-- Users -->
        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}"
                Padding="20"
                ClipToBounds="True">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Filter -->
                <Border Grid.Row="0"
                        Background="{StaticResource SurfaceSecondaryColor}"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMedium}"
                        Padding="12"
                        Margin="0,0,0,16">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="FILTER"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   FontWeight="{StaticResource FontWeightSemiBold}"
                                   Foreground="{StaticResource TextMutedColor}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,14,0" />

                        <ComboBox ItemsSource="{Binding FilterOptions}"
                                  SelectedItem="{Binding SelectedFilterType}"
                                  Width="150"
                                  Height="36"
                                  Margin="0,0,12,0" />

                        <Grid Width="230">

                            <TextBox Text="{Binding SearchText,
                                                   UpdateSourceTrigger=PropertyChanged}"
                                     Height="36"
                                     Visibility="{Binding IsSearchVisible,
                                         Converter={StaticResource BoolToVisibilityConverter}}" />

                            <ComboBox ItemsSource="{Binding StatusOptions}"
                                      SelectedItem="{Binding SelectedStatus}"
                                      Height="36"
                                      Visibility="{Binding IsStatusVisible,
                                          Converter={StaticResource BoolToVisibilityConverter}}" />

                        </Grid>

                    </StackPanel>

                </Border>

                <!-- DataGrid -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Users}"
                          SelectedItem="{Binding SelectedUser}">

                    <DataGrid.RowStyle>

                        <Style TargetType="{x:Type DataGridRow}"
                               BasedOn="{StaticResource DataGridRowStyle}">

                            <!-- ViewModel reference -->
                            <Setter Property="Tag"
                                    Value="{Binding DataContext,
                                        RelativeSource={RelativeSource AncestorType={x:Type Page}}}" />

                            <!-- Context Menu -->
                            <Setter Property="ContextMenu">

                                <Setter.Value>

                                    <ContextMenu>

                                        <!-- Show Details -->
                                        <MenuItem Header="Show Details"
                                                  Command="{Binding PlacementTarget.Tag.ShowDetailsCommand,
                                                      RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                                      RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">

                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="EyeOutline"
                                                                         Width="18"
                                                                         Height="18"
                                                                         Foreground="{StaticResource PrimaryColor}" />
                                            </MenuItem.Icon>

                                        </MenuItem>

                                        <Separator />

                                        <!-- Add User -->
                                        <MenuItem Header="Add New User"
                                                  Command="{Binding PlacementTarget.Tag.AddUserCommand,
                                                      RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">

                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="AccountPlusOutline"
                                                                         Width="18"
                                                                         Height="18"
                                                                         Foreground="{StaticResource SuccessColor}" />
                                            </MenuItem.Icon>

                                        </MenuItem>

                                        <!-- Edit -->
                                        <MenuItem Header="Edit"
                                                  Command="{Binding PlacementTarget.Tag.EditUserCommand,
                                                      RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                                      RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">

                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="PencilOutline"
                                                                         Width="18"
                                                                         Height="18"
                                                                         Foreground="{StaticResource WarningColor}" />
                                            </MenuItem.Icon>

                                        </MenuItem>

                                        <!-- Delete -->
                                        <MenuItem Header="Delete"
                                                  Command="{Binding PlacementTarget.Tag.DeleteUserCommand,
                                                      RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                                      RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">

                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="DeleteOutline"
                                                                         Width="18"
                                                                         Height="18"
                                                                         Foreground="{StaticResource DangerColor}" />
                                            </MenuItem.Icon>

                                        </MenuItem>

                                        <!-- Change Password -->
                                        <MenuItem Header="Change Password"
                                                  Command="{Binding PlacementTarget.Tag.ChangePasswordCommand,
                                                      RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                                      RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">

                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="LockReset"
                                                                         Width="18"
                                                                         Height="18"
                                                                         Foreground="{StaticResource WarningColor}" />
                                            </MenuItem.Icon>

                                        </MenuItem>

                                        <Separator />

                                        <!-- Send Email -->
                                        <MenuItem Header="Send Email"
                                                  Command="{Binding PlacementTarget.Tag.SendEmailCommand,
                                                      RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                                      RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">

                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="EmailOutline"
                                                                         Width="18"
                                                                         Height="18"
                                                                         Foreground="{StaticResource InfoColor}" />
                                            </MenuItem.Icon>

                                        </MenuItem>

                                        <!-- Phone Call -->
                                        <MenuItem Header="Phone Call"
                                                  Command="{Binding PlacementTarget.Tag.PhoneCallCommand,
                                                      RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                                      RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">

                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="PhoneOutline"
                                                                         Width="18"
                                                                         Height="18"
                                                                         Foreground="{StaticResource SuccessColor}" />
                                            </MenuItem.Icon>

                                        </MenuItem>

                                    </ContextMenu>

                                </Setter.Value>

                            </Setter>

                        </Style>

                    </DataGrid.RowStyle>

                    <!-- Columns -->
                    <DataGrid.Columns>

                        <DataGridTextColumn Header="User ID"
                                            Binding="{Binding UserId}"
                                            Width="90" />

                        <DataGridTextColumn Header="Person ID"
                                            Binding="{Binding PersonId}"
                                            Width="90" />

                        <DataGridTextColumn Header="Full Name"
                                            Binding="{Binding PersonFullName}"
                                            Width="*" />

                        <DataGridTextColumn Header="User Name"
                                            Binding="{Binding UserName}"
                                            Width="150" />

                        <DataGridTextColumn Header="Status"
                                            Binding="{Binding IsActive}"
                                            Width="100" />

                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

        </Border>

    </Grid>
</Page>