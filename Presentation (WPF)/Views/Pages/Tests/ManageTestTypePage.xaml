<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Presentation.Views.Pages.Tests.ManageTestTypePage" mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800" Title="Manage Test Types" Background="{StaticResource BackgroundColor}">

    <Page.Resources>
        </Page.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,20">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <TextBlock Text="Manage Test Types" Style="{StaticResource HeaderStyle}" />
                    <TextBlock Text="  •  " Foreground="{StaticResource TextMutedColor}" FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TestTypes.Count}" Foreground="{StaticResource PrimaryColor}" FontSize="{StaticResource FontSizeBody}" FontWeight="{StaticResource FontWeightSemiBold}" VerticalAlignment="Center" />
                    <TextBlock Text=" records" Foreground="{StaticResource TextMutedColor}" FontSize="{StaticResource FontSizeCaption}" VerticalAlignment="Center" Margin="4,0,0,0" />
                </StackPanel>

                <Border DockPanel.Dock="Right" Background="{StaticResource PrimarySoftColor}" BorderBrush="{StaticResource PrimaryLightColor}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                    <TextBlock Text="Right-click a record to edit" Foreground="{StaticResource PrimaryColor}" FontSize="{StaticResource FontSizeCaption}" FontWeight="{StaticResource FontWeightSemiBold}" />
                </Border>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
            <DataGrid x:Name="dgTestType" ItemsSource="{Binding TestTypes}" SelectionMode="Single" SelectionUnit="FullRow">
<DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Edit Test Type" Command="{Binding EditTestTypeCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon><materialDesign:PackIcon Kind="PencilOutline" Width="18" Height="18" Foreground="{StaticResource WarningColor}" /></MenuItem.Icon></MenuItem>
                    </ContextMenu>
                </DataGrid.ContextMenu>

                <DataGrid.Columns>
                    
                    <DataGridTextColumn Header="ID" Binding="{Binding TestTypeId}" Width="90" />
                    <DataGridTextColumn Header="Title" Binding="{Binding TestTypeTitle}" Width="240" />
                    <DataGridTextColumn Header="Description" Binding="{Binding TestTypeDescription}" Width="*" />
                    <DataGridTextColumn Header="Fees" Binding="{Binding TestTypeFees, StringFormat={}{0:C}}" Width="160" />

                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>