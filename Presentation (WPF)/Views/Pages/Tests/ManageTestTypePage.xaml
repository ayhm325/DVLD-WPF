<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Presentation.Views.Controls" x:Class="Presentation.Views.Pages.Tests.ManageTestTypePage" mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800" Title="Manage Test Types" Background="{StaticResource BackgroundColor}">

    <Page.Resources>
        </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

<controls:PageHeader Grid.Row="0" Eyebrow="CONFIGURATION" Heading="Test Types" Description="Review examination types, descriptions, and fees." Metric="{Binding TestTypes.Count}">
            <controls:PageHeader.ActionContent>
                <Border Background="{StaticResource PrimaryLightColor}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="{StaticResource RadiusPill}" Padding="12,7"><TextBlock Text="Select a row to edit" Foreground="{StaticResource PrimaryColor}" Style="{StaticResource CaptionStyle}"/></Border>
            </controls:PageHeader.ActionContent>
        </controls:PageHeader>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
            <DataGrid x:Name="dgTestType" ItemsSource="{Binding TestTypes}" SelectionMode="Single" SelectionUnit="FullRow"
                      Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Edit Test Type" Command="{Binding PlacementTarget.Tag.EditTestTypeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon><materialDesign:PackIcon Kind="PencilOutline" Width="18" Height="18" Foreground="{StaticResource WarningColor}" /></MenuItem.Icon></MenuItem>
                    </ContextMenu>
                </DataGrid.ContextMenu>

                <DataGrid.Columns>
                    
                    <DataGridTextColumn Header="ID" Binding="{Binding TestTypeId}" Width="90" />
                    <DataGridTextColumn Header="Title" Binding="{Binding TestTypeTitle}" Width="240" />
                    <DataGridTextColumn Header="Description" Binding="{Binding TestTypeDescription}" Width="*" />
                    <DataGridTextColumn Header="Fees" Binding="{Binding TestTypeFees, StringFormat={}{0:N2} JOD}" Width="160" />

                </DataGrid.Columns>
            </DataGrid>
            <Border Background="{StaticResource SurfaceColor}" CornerRadius="{StaticResource RadiusMedium}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems, ElementName=dgTestType}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="No test types to show" Style="{StaticResource SectionTitleStyle}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Configured examination types will appear here."
                               Style="{StaticResource CaptionStyle}" Margin="0,5,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            </Grid>
        </Border>
    </Grid>
</Page>


