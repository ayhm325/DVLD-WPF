{
  "ConnectionStrings": {
    "DVLDConnection": "Server=.;Database=DVLD;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "DVLD.Api",
    "Audience": "DVLD.Client",    
    "ExpirationMinutes": 15
  },
  "AuthSession": {
    "RefreshTokenLifetimeDays": 14,
    "IdleTimeoutDays": 7,
    "RotationGraceSeconds": 30,
    "RefreshCookieName": "dvld_rt",
    "RefreshCookiePath": "/api/auth"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Storage": {
    "PersonImagesPath": "../DVLD_Storage/People"
  },
  "AllowedHosts": "*"
}
